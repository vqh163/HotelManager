                    <div id="createTimeError" class="alert alert-danger d-none align-items-center gap-2 py-2 px-3 mb-3 shadow-sm" role="alert"><i class="bi bi-exclamation-octagon-fill fs-5 text-danger"></i><div id="createTimeErrorText" class="small fw-bold"></div></div>
                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">1. Thông tin cơ bản về nhân viên</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Họ và tên</label><input type="text" class="form-control" asp-for="ScheduleData.TenNhanVien" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Mã nhân sự</label><input type="text" class="form-control" asp-for="ScheduleData.MaNhanVien" required /></div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Bộ phận</label>
                            <select class="form-select" asp-for="ScheduleData.BoPhan" required>
                                <option value="Lễ tân">Lễ tân</option>
                                <option value="Buồng phòng">Buồng phòng</option>
                                <option value="Bảo trì">Bảo trì</option>
                                <option value="F&B">F&B Nhà hàng</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Chức vụ</label><input type="text" class="form-control" asp-for="ScheduleData.ChucVu" required /></div>
                    </div>
                    <h6 class="fw-bold text-primary mb-3 mt-3 border-bottom pb-2">2. Hệ thống phân ca & Nhiệm vụ</h6>
                    <div class="mb-3"><label class="form-label small fw-bold text-muted">Tiêu đề nhiệm vụ chính</label><input type="text" class="form-control" asp-for="ScheduleData.TieuDe" placeholder="VD: Dọn dẹp tầng 3, Trực check-in..." required /></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Hệ thống phân ca</label>
                            <select class="form-select" id="createShift" asp-for="ScheduleData.LoaiCa" onchange="autoAdjustShiftHours('create')" required>
                                <option value="Ca sáng">Ca sáng (06:00 - 14:00)</option>
                                <option value="Ca chiều">Ca chiều (14:00 - 22:00)</option>
                                <option value="Ca đêm">Ca đêm (22:00 - 06:00)</option>
                                <option value="Ca gãy">Ca gãy</option>
                                <option value="Tùy chỉnh">Giờ làm linh hoạt</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Khu vực phân công</label><input type="text" class="form-control" asp-for="ScheduleData.KhuVuc" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Bắt đầu (Từ hôm nay trở đi)</label><input type="datetime-local" class="form-control" id="createStart" name="ScheduleData.ThoiGianBatDau" value="@defaultStartToday" onchange="validateScheduleTime(null, 'create')" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Kết thúc</label><input type="datetime-local" class="form-control" id="createEnd" name="ScheduleData.ThoiGianKetThuc" value="@defaultEndToday" onchange="validateScheduleTime(null, 'create')" required /></div>
                        <div class="col-12"><label class="form-label small fw-bold text-muted">Ghi chú chi tiết công việc</label><textarea class="form-control" asp-for="ScheduleData.GhiChu" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer bg-white"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i> Lưu ca làm</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Ca Làm -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-info-square me-2"></i>Thông tin ca làm việc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="detailForm">
                <div class="modal-body bg-light">
                    <div id="editTimeError" class="alert alert-danger d-none align-items-center gap-2 py-2 px-3 mb-3 shadow-sm" role="alert"><i class="bi bi-exclamation-octagon-fill fs-5 text-danger"></i><div id="editTimeErrorText" class="small fw-bold"></div></div>
                    <input type="hidden" id="editId" name="ScheduleData.Id" /><input type="hidden" name="month" value="@Model.CurrentDate.Month" /><input type="hidden" name="year" value="@Model.CurrentDate.Year" />
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Họ và tên</label><input type="text" class="form-control" id="editEmpName" name="ScheduleData.TenNhanVien" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Mã nhân sự</label><input type="text" class="form-control" id="editEmpCode" name="ScheduleData.MaNhanVien" required /></div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Bộ phận</label>
                            <select class="form-select" id="editDept" name="ScheduleData.BoPhan">
                                <option value="Lễ tân">Lễ tân</option>
                                <option value="Buồng phòng">Buồng phòng</option>
                                <option value="Bảo trì">Bảo trì</option>
                                <option value="F&B">F&B Nhà hàng</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Chức vụ</label><input type="text" class="form-control" id="editPos" name="ScheduleData.ChucVu" required /></div>
                        <div class="col-12 mb-3 mt-2"><hr></div>
                        <div class="col-md-12 mb-3"><label class="form-label small fw-bold text-muted">Tiêu đề nhiệm vụ</label><input type="text" class="form-control fw-bold" id="editTitle" name="ScheduleData.TieuDe" required /></div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Ca làm việc</label>
                            <select class="form-select" id="editShift" name="ScheduleData.LoaiCa">
                                <option value="Ca sáng">Ca sáng</option>
                                <option value="Ca chiều">Ca chiều</option>
                                <option value="Ca đêm">Ca đêm</option>
                                <option value="Ca gãy">Ca gãy</option>
                                <option value="Tùy chỉnh">Tùy chỉnh</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Khu vực</label><input type="text" class="form-control" id="editArea" name="ScheduleData.KhuVuc" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Bắt đầu</label><input type="datetime-local" class="form-control" id="editStart" name="ScheduleData.ThoiGianBatDau" onchange="validateScheduleTime(null, 'edit')" required /></div>
                        <div class="col-md-6 mb-3"><label class="form-label small fw-bold text-muted">Kết thúc</label><input type="datetime-local" class="form-control" id="editEnd" name="ScheduleData.ThoiGianKetThuc" onchange="validateScheduleTime(null, 'edit')" required /></div>
                        <div class="col-12 mb-3"><label class="form-label small fw-bold text-muted">Chi tiết công việc</label><textarea class="form-control" id="editNotes" name="ScheduleData.GhiChu" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer bg-white d-flex justify-content-between">
                    <button type="submit" asp-page-handler="Delete" name="id" class="btn btn-outline-danger" onclick="setIdForDelete()"><i class="bi bi-trash"></i> Xóa ca này</button>
                    <div><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button type="submit" asp-page-handler="Edit" class="btn btn-success px-4" onclick="return validateScheduleTime(event, 'edit')"><i class="bi bi-save me-1"></i> Lưu thay đổi</button></div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex"><div class="toast-body fw-bold" id="toastMessage"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
    </div>
</div>

<script>
    const existingSchedules = [
            @foreach (var s in Model.MySchedules)
        {
            @:{ id: @s.Id, empName: '@Html.Raw((s.TenNhanVien ?? "").Replace("'", "\\'"))', title: '@Html.Raw((s.TieuDe ?? "").Replace("'", "\\'"))', start: '@s.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")', end: '@s.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")' },
        }
        ];

    function openCreateModal() {
        const errorBox = document.getElementById('createTimeError');
        errorBox.classList.add('d-none');
        errorBox.classList.remove('d-flex');
        document.getElementById('createStart').classList.remove('is-invalid');
        document.getElementById('createEnd').classList.remove('is-invalid');
        document.getElementById('createStart').value = '@defaultStartToday';
        document.getElementById('createEnd').value = '@defaultEndToday';
        document.getElementById('createShift').value = 'Ca sáng';
        var createModal = new bootstrap.Modal(document.getElementById('createModal'));
        createModal.show();
    }

    function autoAdjustShiftHours(mode) {
        const shiftSelect = document.getElementById(mode + 'Shift');
        const startInput = document.getElementById(mode + 'Start');
        const endInput = document.getElementById(mode + 'End');
        if (!startInput.value) return;
        const currentDatePart = startInput.value.split('T')[0];
        if (shiftSelect.value === 'Ca sáng') { startInput.value = currentDatePart + 'T06:00'; endInput.value = currentDatePart + 'T14:00'; }
        else if (shiftSelect.value === 'Ca chiều') { startInput.value = currentDatePart + 'T14:00'; endInput.value = currentDatePart + 'T22:00'; }
        else if (shiftSelect.value === 'Ca đêm') {
            startInput.value = currentDatePart + 'T22:00';
            let nextDay = new Date(currentDatePart); nextDay.setDate(nextDay.getDate() + 1);
            endInput.value = nextDay.toISOString().split('T')[0] + 'T06:00';
        }
        validateScheduleTime(null, mode);
    }

    function validateScheduleTime(event, mode) {
        const startInput = document.getElementById(mode + 'Start');
        const endInput = document.getElementById(mode + 'End');
        const errorBox = document.getElementById(mode + 'TimeError');
        const errorText = document.getElementById(mode + 'TimeErrorText');

        errorBox.classList.add('d-none');
        errorBox.classList.remove('d-flex');
        startInput.classList.remove('is-invalid');
        endInput.classList.remove('is-invalid');

        if (!startInput.value || !endInput.value) return true;
        const startTime = new Date(startInput.value); const endTime = new Date(endInput.value);
        const todayStart = new Date('@today.ToString("yyyy-MM-dd")T00:00:00');

        if (startTime < todayStart) {
            if (event) event.preventDefault();
            errorText.innerText = "⚠️ Không được chọn ngày đã qua! Ngày bạn chọn (" + formatTimeVN(startTime) + ") đã trôi qua.";
            errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); startInput.classList.add('is-invalid');
            if (event) startInput.focus(); return false;
        }

        if (endTime <= startTime) {
            if (event) event.preventDefault();
            errorText.innerText = "⚠️ Giờ kết thúc không hợp lệ! Phải lớn hơn giờ bắt đầu.";
            errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); endInput.classList.add('is-invalid');
            if (event) endInput.focus(); return false;
        }

        const currentEditId = (mode === 'edit') ? parseInt(document.getElementById('editId').value) : -1;
        for (let i = 0; i < existingSchedules.length; i++) {
            const item = existingSchedules[i];
            if (mode === 'edit' && item.id === currentEditId) continue;
            const exStart = new Date(item.start); const exEnd = new Date(item.end);
            if (startTime < exEnd && endTime > exStart) {
                if (event) event.preventDefault();
                errorText.innerText = "⚠️ Trùng giờ làm việc với ca [" + item.empName + " - " + item.title + "]. Vui lòng chọn lại!";
                errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); startInput.classList.add('is-invalid'); endInput.classList.add('is-invalid');
                if (event) startInput.focus(); return false;
            }
        }
        return true;
    }

    function formatTimeVN(dateObj) {
        const d = String(dateObj.getDate()).padStart(2, '0'); const m = String(dateObj.getMonth() + 1).padStart(2, '0');
        const y = dateObj.getFullYear(); const h = String(dateObj.getHours()).padStart(2, '0');
        const min = String(dateObj.getMinutes()).padStart(2, '0'); return h + ":" + min + " ngày " + d + "/" + m + "/" + y;
    }

    function openDetailModal(id, empCode, empName, dept, pos, title, shift, area, start, end, notes) {
        const errorBox = document.getElementById('editTimeError');
        errorBox.classList.add('d-none'); errorBox.classList.remove('d-flex');
        document.getElementById('editStart').classList.remove('is-invalid'); document.getElementById('editEnd').classList.remove('is-invalid');
        document.getElementById('editId').value = id; document.getElementById('editEmpCode').value = empCode;
        document.getElementById('editEmpName').value = empName; document.getElementById('editDept').value = dept;
        document.getElementById('editPos').value = pos; document.getElementById('editTitle').value = title;
        document.getElementById('editShift').value = shift; document.getElementById('editArea').value = area;
        document.getElementById('editStart').value = start; document.getElementById('editEnd').value = end;
        document.getElementById('editNotes').value = notes;
        var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
        detailModal.show();
    }

    function setIdForDelete() { document.getElementById('editId').value = event.currentTarget.value = document.getElementById('editId').value; }
    function handleLogout() { if (confirm("Bạn có chắc chắn muốn đăng xuất?")) window.location.href = "/Auth/DangXuat"; }

    document.addEventListener("DOMContentLoaded", function() {
        var msg = '@Html.Raw(TempData["AlertMessage"])';
        if (msg !== '') {
            document.getElementById('toastMessage').innerText = msg;
            var toastEl = document.getElementById('liveToast');
            if (msg.includes("Xóa") || msg.includes("⚠️")) { toastEl.classList.remove('bg-success'); toastEl.classList.add('bg-danger'); }
            else { toastEl.classList.remove('bg-danger'); toastEl.classList.add('bg-success'); }
            var toast = new bootstrap.Toast(toastEl, { delay: 3500 }); toast.show();
        }
    });
</script>
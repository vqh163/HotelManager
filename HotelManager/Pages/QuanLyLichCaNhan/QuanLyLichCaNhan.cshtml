@section Scripts {
    <script>
        let currentDateStr = '@(Model.SelectedDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))';
        let currentActiveTab = '@(string.IsNullOrEmpty(Model.ActiveTab) ? "month" : Model.ActiveTab)';
        const dbEmployees = @Html.Raw(string.IsNullOrEmpty(Model.EmployeeDataJson) ? "{}" : Model.EmployeeDataJson);

        function changeTabDOM(tabName) {
            currentActiveTab = tabName;
            const monthView = document.getElementById('month-view');
            const weekView = document.getElementById('week-view');
            const dayView = document.getElementById('day-view');

            if (monthView) monthView.classList.remove('show', 'active');
            if (weekView) weekView.classList.remove('show', 'active');
            if (dayView) dayView.classList.remove('show', 'active');

            document.getElementById('btn-tab-month')?.classList.remove('active');
            document.getElementById('btn-tab-week')?.classList.remove('active');
            document.getElementById('btn-tab-day')?.classList.remove('active');

            document.getElementById(tabName + '-view')?.classList.add('show', 'active');
            document.getElementById('btn-tab-' + tabName)?.classList.add('active');

            updateTitle(tabName);
        }

        function updateTitle(activeTab = 'month') {
            let d = new Date(currentDateStr);
            let titleEl = document.getElementById('calendarMainTitle');
            if (!titleEl) return;

            if (activeTab === 'month') {
                titleEl.innerText = `Tháng ${d.getMonth() + 1}, ${d.getFullYear()}`;
            } else if (activeTab === 'week') {
                let day = d.getDay();
                let diff = day === 0 ? 6 : day - 1;
                let start = new Date(d); start.setDate(start.getDate() - diff);
                let end = new Date(start); end.setDate(end.getDate() + 6);
                titleEl.innerText = `Tuần ${start.getDate()}/${start.getMonth() + 1} - ${end.getDate()}/${end.getMonth() + 1}, ${d.getFullYear()}`;
            } else if (activeTab === 'day') {
                titleEl.innerText = `Ngày ${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
            }
        }

        function navigateCalendar(direction) {
            let d = new Date(currentDateStr);
            if (direction === 0) { d = new Date(); }
            else {
                if (currentActiveTab === 'month') { d.setMonth(d.getMonth() + direction); }
                else if (currentActiveTab === 'week') { d.setDate(d.getDate() + (direction * 7)); }
                else if (currentActiveTab === 'day') { d.setDate(d.getDate() + direction); }
            }
            let year = d.getFullYear(); let month = String(d.getMonth() + 1).padStart(2, '0'); let day = String(d.getDate()).padStart(2, '0');
            window.location.href = `?SelectedDate=${year}-${month}-${day}&ActiveTab=${currentActiveTab}`;
        }

        function datePickerChanged(val) { window.location.href = `?SelectedDate=${val}&ActiveTab=${currentActiveTab}`; }

        function showQuickView(event, maLich, empName, caLam, start, end, notes) {
            event.stopPropagation();
            document.getElementById('qvTitle').innerText = caLam;
            document.getElementById('qvEmp').innerText = empName;
            document.getElementById('qvTime').innerText = new Date(start).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + " - " + new Date(end).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            document.getElementById('qvNotes').innerText = notes || 'Không có ghi chú';

            if (document.getElementById('qvDeleteId')) { document.getElementById('qvDeleteId').value = maLich; }
            if (document.getElementById('qvActiveTab')) { document.getElementById('qvActiveTab').value = currentActiveTab; }

            const popup = document.getElementById('quickViewPopup');
            if (popup) {
                popup.style.display = 'block';
                let x = event.pageX + 10; let y = event.pageY + 10;
                if (x + 320 > window.innerWidth) { x = event.pageX - 330; }
                popup.style.left = x + 'px'; popup.style.top = y + 'px';
            }
        }

        document.addEventListener('click', function (e) {
            const popup = document.getElementById('quickViewPopup');
            if (popup && popup.style.display === 'block' && !popup.contains(e.target) && !e.target.closest('.shift-block') && !e.target.closest('.tl-event-block')) {
                popup.style.display = 'none';
            }
        });

        function showDuyetDonModal(id, tenNV, chucVu, tuNgay, denNgay, soNgay, lyDo) {
            document.getElementById('duyetDonId').value = id;
            document.getElementById('ddTenNV').innerText = tenNV;
            document.getElementById('ddChucVu').innerText = chucVu;
            let t = new Date(tuNgay); let d = new Date(denNgay);
            document.getElementById('ddThoiGian').innerText = t.toLocaleDateString('vi-VN') + " đến " + d.toLocaleDateString('vi-VN');
            document.getElementById('ddSoNgay').innerText = soNgay;
            document.getElementById('ddLyDo').innerText = lyDo;
            new bootstrap.Modal(document.getElementById('duyetDonModal')).show();
        }

        function loadEmployees() {
            const chucVu = document.getElementById('selectChucVu').value;
            const selectNhanVien = document.getElementById('selectNhanVien');
            const inputMaNV = document.getElementById('inputMaNV');

            selectNhanVien.innerHTML = '<option value="">-- Chọn nhân viên --</option>';
            inputMaNV.value = '';

            if (chucVu && dbEmployees[chucVu]) {
                selectNhanVien.disabled = false;
                dbEmployees[chucVu].forEach(emp => {
                    const option = document.createElement('option');
                    option.value = emp.name; option.dataset.code = emp.id; option.textContent = emp.name;
                    selectNhanVien.appendChild(option);
                });
            } else { selectNhanVien.disabled = true; }
        }

        function updateEmpCode() {
            const selectNhanVien = document.getElementById('selectNhanVien');
            const inputMaNV = document.getElementById('inputMaNV');
            if (selectNhanVien.selectedIndex > 0) { inputMaNV.value = selectNhanVien.options[selectNhanVien.selectedIndex].dataset.code; }
            else { inputMaNV.value = ''; }
        }

        let checklistArray = [];
        function addChecklistItem() {
            const input = document.getElementById('checklistInput');
            if (input.value.trim() !== "") { checklistArray.push(input.value.trim()); renderChecklist(); input.value = ""; input.focus(); }
        }

        function removeChecklistItem(index) { checklistArray.splice(index, 1); renderChecklist(); }

        function renderChecklist() {
            const box = document.getElementById('checklistBox'); box.innerHTML = "";
            checklistArray.forEach((item, index) => { box.innerHTML += `<li class="list-group-item d-flex justify-content-between py-1"><span class="small"><i class="bi bi-square me-2"></i> ${item}</span><button type="button" class="btn btn-sm text-danger p-0" onclick="removeChecklistItem(${index})"><i class="bi bi-x-circle-fill"></i></button></li>`; });
        }

        function prepareSubmit() {
            const hiddenChecklist = document.getElementById('hiddenChecklistData');
            if (hiddenChecklist) hiddenChecklist.value = checklistArray.join(' | ');
            const selectNV = document.getElementById('selectNhanVien');
            if (selectNV) selectNV.disabled = false;
        }

        function filterSchedules() {
            const selectedDept = document.getElementById('departmentFilter').value;
            const shifts = document.querySelectorAll('.shift-block, .tl-event-block');
            shifts.forEach(shift => {
                const dept = shift.getAttribute('data-department');
                if (selectedDept === 'ALL' || dept === selectedDept) { shift.style.display = ''; } else { shift.style.display = 'none'; }
            });
        }

        function toggleCustomTime() {
            const caLamViec = document.getElementById('selectCaLamViec').value;
            const customDiv = document.getElementById('customTimeDiv');
            const inputBatDau = document.getElementById('inputBatDau');
            const inputKetThuc = document.getElementById('inputKetThuc');

            if (caLamViec === 'Khac') { customDiv.style.display = 'block'; inputBatDau.required = true; inputKetThuc.required = true; }
            else { customDiv.style.display = 'none'; inputBatDau.required = false; inputKetThuc.required = false; inputBatDau.value = ''; inputKetThuc.value = ''; }
        }

        document.addEventListener("DOMContentLoaded", function () {
            changeTabDOM(currentActiveTab);
            @if (!string.IsNullOrEmpty(Model.AlertMessage))
                {
                    @:alert('@Html.Raw(Model.AlertMessage.Replace("'", "\\'"))');
            }
                        });
    </script>
}
<!-- TOAST THÔNG BÁO -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
    <div id="liveToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex"><div class="toast-body fw-bold" id="toastMessage"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
    </div>
</div>

<script>
    // 1. TÍNH NĂNG LỌC THEO BỘ PHẬN
    function filterSchedules() {
        const selectedDept = document.getElementById('departmentFilter').value;
        const shifts = document.querySelectorAll('.shift-block, .shift-bar');

        shifts.forEach(shift => {
            const dept = shift.getAttribute('data-department');
            if (selectedDept === 'ALL' || dept === selectedDept) {
                shift.classList.remove('d-none');
            } else {
                shift.classList.add('d-none');
            }
        });
    }

    // 2. XÁC NHẬN TRƯỚC KHI XÓA
    function confirmDelete() {
        setIdForDelete();
        return confirm("Bạn có chắc chắn muốn XÓA ca làm việc này không? Hành động này không thể hoàn tác.");
    }

    // 3. XỬ LÝ DATE PICKER & THÔNG BÁO TOAST
    document.addEventListener("DOMContentLoaded", function() {
        // Tự động mở tab Ngày hoặc Tuần nếu URL thay đổi (có thể tùy chỉnh)
        const dateInput = document.querySelector('input[name="SelectedDate"]');
        if (dateInput && dateInput.value !== '@DateTime.Today.ToString("yyyy-MM-dd")') {
            var dayTab = new bootstrap.Tab(document.querySelector('#day-tab'));
            dayTab.show();
        }

        var msg = '@Html.Raw(TempData["AlertMessage"])';
        if (msg !== '') {
            var toastEl = document.getElementById('liveToast');
            document.getElementById('toastMessage').innerText = msg;
            toastEl.className = msg.includes("⚠") || msg.includes("lỗi") ? "toast align-items-center text-white bg-danger border-0" : "toast align-items-center text-white bg-success border-0";
            var toast = new bootstrap.Toast(toastEl, { delay: 3500 }); toast.show();
        }

        var priSelect = document.getElementById('prioritySelect');
        if (priSelect) changePriorityColor(priSelect);
    });

    // 4. CHECKLIST LOGIC
    let checklistArray = [];
    function addChecklistItem() {
        const input = document.getElementById('checklistInput');
        if (input.value.trim() !== "") {
            checklistArray.push(input.value.trim());
            renderChecklist();
            input.value = ""; input.focus();
        }
    }

    const chkInput = document.getElementById('checklistInput');
    if (chkInput) {
        chkInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); addChecklistItem(); }
        });
    }

    function removeChecklistItem(index) {
        checklistArray.splice(index, 1);
        renderChecklist();
    }

    function renderChecklist() {
        const box = document.getElementById('checklistBox');
        box.innerHTML = "";
        checklistArray.forEach((item, index) => {
            box.innerHTML += `<li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2"><span style="font-size: 0.85rem;"><i class="bi bi-square me-2 text-muted"></i> ${item}</span><button type="button" class="btn btn-sm text-danger border-0 p-0" onclick="removeChecklistItem(${index})"><i class="bi bi-x-circle-fill"></i></button></li>`;
        });
    }

    function prepareSubmit() {
        const hiddenChecklist = document.getElementById('hiddenChecklistData');
        if (hiddenChecklist) hiddenChecklist.value = checklistArray.join('|');
    }

    // 5. COLOR SELECT & TIME VALIDATION
    function changePriorityColor(obj) { obj.style.color = obj.options[obj.selectedIndex].getAttribute('data-color'); }

    function autoAdjustShiftHours(mode) {
        const shiftSelect = document.getElementById(mode + 'Shift');
        const startInput = document.getElementById(mode + 'Start');
        const endInput = document.getElementById(mode + 'End');
        if (!startInput.value) return;
        const currentDatePart = startInput.value.split('T')[0];
        if (shiftSelect.value === 'Ca sáng') { startInput.value = currentDatePart + 'T06:00'; endInput.value = currentDatePart + 'T14:00'; }
        else if (shiftSelect.value === 'Ca chiều') { startInput.value = currentDatePart + 'T14:00'; endInput.value = currentDatePart + 'T22:00'; }
        else if (shiftSelect.value === 'Hành chính') { startInput.value = currentDatePart + 'T08:00'; endInput.value = currentDatePart + 'T17:00'; }
        else if (shiftSelect.value === 'Ca đêm') {
            startInput.value = currentDatePart + 'T22:00';
            let nextDay = new Date(currentDatePart); nextDay.setDate(nextDay.getDate() + 1);
            endInput.value = nextDay.toISOString().split('T')[0] + 'T06:00';
        }
    }

    const existingSchedules = [
            @foreach (var s in Model.MySchedules)
        {
            @:{ id: @s.Id, empName: '@Html.Raw((s.TenNhanVien ?? "").Replace("'", "\\'"))', start: '@s.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")', end: '@s.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")' },
        }
        ];

    function validateScheduleTime(event, mode) {
        const startInput = document.getElementById(mode + 'Start');
        const endInput = document.getElementById(mode + 'End');
        const errorBox = document.getElementById(mode + 'TimeError');
        const errorText = document.getElementById(mode + 'TimeErrorText');

        errorBox.classList.add('d-none'); errorBox.classList.remove('d-flex');
        startInput.classList.remove('is-invalid'); endInput.classList.remove('is-invalid');

        const startTime = new Date(startInput.value); const endTime = new Date(endInput.value);
        const todayStart = new Date('@today.ToString("yyyy-MM-dd")T00:00:00');

        if (startTime < todayStart) {
            if (event) event.preventDefault();
            errorText.innerText = "⚠️ Không được chọn ngày đã qua!";
            errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); startInput.classList.add('is-invalid');
            return false;
        }
        if (endTime <= startTime) {
            if (event) event.preventDefault();
            errorText.innerText = "⚠️ Giờ kết thúc phải lớn hơn giờ bắt đầu.";
            errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); endInput.classList.add('is-invalid');
            return false;
        }

        for (let i = 0; i < existingSchedules.length; i++) {
            const item = existingSchedules[i];
            const exStart = new Date(item.start); const exEnd = new Date(item.end);
            if (mode === 'edit' && item.id === parseInt(document.getElementById('editId').value)) continue;

            if (startTime < exEnd && endTime > exStart) {
                if (event) event.preventDefault();
                errorText.innerText = "⚠️ Trùng giờ làm việc với ca của [" + item.empName + "]. Vui lòng chọn lại!";
                errorBox.classList.remove('d-none'); errorBox.classList.add('d-flex'); startInput.classList.add('is-invalid'); endInput.classList.add('is-invalid');
                return false;
            }
        }
        return true;
    }

    function openDetailModal(id, empCode, empName, dept, pos, title, shift, area, start, end, notes) {
        const errorBox = document.getElementById('editTimeError');
        errorBox.classList.add('d-none'); errorBox.classList.remove('d-flex');
        document.getElementById('editStart').classList.remove('is-invalid'); document.getElementById('editEnd').classList.remove('is-invalid');

        document.getElementById('editId').value = id;
        document.getElementById('editEmpCode').value = empCode;
        document.getElementById('editEmpName').value = empName;
        document.getElementById('editDept').value = dept;
        document.getElementById('editPos').value = pos;
        document.getElementById('editTitle').value = title;
        document.getElementById('editShift').value = shift;
        document.getElementById('editArea').value = area;
        document.getElementById('editStart').value = start;
        document.getElementById('editEnd').value = end;
        document.getElementById('editNotes').value = notes;

        var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
        detailModal.show();
    }

    function setIdForDelete() {
        document.getElementById('editId').value = event.currentTarget.value = document.getElementById('editId').value;
    }

    function handleLogout() {
        if (confirm("Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?")) {
            window.location.href = "/Auth/DangXuat";
        }
    }
</script>
@page
@model HotelManager.Pages.QuanLyLichCaNhan.QuanLyLichCaNhanModel
@{
    ViewData["Title"] = "Lịch phân ca";
    // KHÔNG khai báo Layout = null, mặc định nó sẽ tự động ăn theo _Layout.cshtml của hệ thống
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="fw-bold text-primary m-0"><i class="bi bi-calendar-week me-2"></i> Lịch phân ca (UC_10)</h3>
        <div class="d-flex align-items-center">
            <span class="text-muted me-3 fw-semibold">Tháng @DateTime.Now.Month/@DateTime.Now.Year</span>
            <!-- Dành cho Quản lý (UC_11) mới được tạo ca -->
            @if (User.IsInRole("Quản lý"))
            {
                <button class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-plus-circle me-1"></i> Tạo ca làm việc</button>
            }
        </div>
    </div>

    <!-- Thông báo hiển thị lỗi/thành công từ TempData -->
    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["ThongBaoLoi"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-primary rounded-3 d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-3 fs-4"></i>
                <div>
                    <strong>Thông báo lịch cá nhân:</strong> Tháng @DateTime.Now.Month/@DateTime.Now.Year đang có <strong>0</strong> ca làm việc.<br />
                    <small>Hiện chưa có ca làm việc nào được phân. Vui lòng liên hệ Quản lý để biết thêm chi tiết.</small>
                </div>
            </div>

            <!-- Khung lưới lịch cơ bản bằng Bootstrap 5 (Bạn Ký sẽ dùng vòng lặp C# để đổ dữ liệu bảng LICH_LAM_VIEC vào đây) -->
            <div class="table-responsive mt-4">
                <table class="table table-bordered text-center align-middle" style="min-height: 400px;">
                    <thead class="bg-light">
                        <tr class="text-secondary">
                            <th>T2</th>
                            <th>T3</th>
                            <th>T4</th>
                            <th>T5</th>
                            <th>T6</th>
                            <th>T7</th>
                            <th>CN</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dòng mẫu, sẽ được thay thế bằng foreach LINQ sau -->
                        <tr>
                            <td class="p-4 text-muted bg-light">28</td>
                            <td class="p-4 text-muted bg-light">29</td>
                            <td class="p-4 text-muted bg-light">30</td>
                            <td class="p-4">1</td>
                            <td class="p-4">
                                <span class="badge bg-primary rounded-circle p-2 fs-6">2</span><br />
                                <small class="text-primary fw-bold mt-2 d-block">Hôm nay</small>
                            </td>
                            <td class="p-4">3</td>
                            <td class="p-4">4</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
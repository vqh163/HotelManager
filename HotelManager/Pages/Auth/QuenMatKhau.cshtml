@page
@model HotelManager.Pages.Auth.QuenMatKhauModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = null; // Tắt Layout để hiển thị độc lập
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần mềm Quản lý Khách sạn</title>
    <!-- CSS Framework Bootstrap 5 và Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f4f6f9;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
            }

            .auth-card {
                max-width: 450px;
                width: 100%;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                border-radius: 8px;
                background: white;
            }

            .auth-header {
                background-color: #1a1d20;
                color: white;
                text-align: center;
                padding: 20px;
                font-weight: bold;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-header text-uppercase fs-5">KHÔI PHỤC MẬT KHẨU</div>

        <div class="p-4">
            <!-- Khu vực hiển thị thông báo phản hồi -->
            @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
            {
                <div class="alert alert-danger py-2 small">@Model.ThongBaoLoi</div>
            }
            @if (!string.IsNullOrEmpty(Model.ThongBaoThanhCong))
            {
                <div class="alert alert-success py-2 small">@Model.ThongBaoThanhCong</div>
            }

            <form method="post">
                <!-- Ẩn biến trạng thái để đồng bộ luồng -->
                <input type="hidden" asp-for="BuocHienTai" />

                <!-- BƯỚC 1: NHẬP SĐT / EMAIL -->
                @if (Model.BuocHienTai == 1)
                {
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Số điện thoại hoặc Email khôi phục</label>
                        <input type="text" class="form-control" asp-for="Input.ThongTinKhoiPhuc" placeholder="Nhập SĐT, Email hoặc Tên đăng nhập..." required />
                    </div>
                    <button type="submit" asp-page-handler="GuiYeuCau" class="btn btn-dark w-100 py-2">Gửi Yêu Cầu</button>
                }

                <!-- BƯỚC 3: ĐỔI MẬT KHẨU MỚI -->
                @if (Model.BuocHienTai == 3)
                {
                    <input type="hidden" asp-for="Input.ThongTinKhoiPhuc" />

                    <!-- Ô Mật khẩu mới tích hợp icon con mắt -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mật khẩu mới</label>
                        <div class="input-group">
                            <input asp-for="Input.MatKhauMoi" type="password" class="form-control" id="matKhauMoiInput" placeholder="Nhập mật khẩu mới..." required />
                            <span class="input-group-text bg-white text-secondary" id="toggleMatKhauMoi" style="cursor: pointer;" title="Ẩn/Hiện mật khẩu">
                                <i class="bi bi-eye-slash" id="eyeIconMatKhauMoi"></i>
                            </span>
                        </div>
                    </div>

                    <!-- Ô Xác nhận mật khẩu mới tích hợp icon con mắt -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <input asp-for="Input.XacNhanMatKhau" type="password" class="form-control" id="xacNhanMatKhauInput" placeholder="Nhập lại mật khẩu mới..." required />
                            <span class="input-group-text bg-white text-secondary" id="toggleXacNhanMoi" style="cursor: pointer;" title="Ẩn/Hiện mật khẩu">
                                <i class="bi bi-eye-slash" id="eyeIconXacNhanMoi"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" asp-page-handler="DoiMatKhau" class="btn btn-dark w-100 py-2">Xác Nhận Đổi Mật Khẩu</button>
                }
            </form>
        </div>

        <div class="text-center p-3 border-top bg-light" style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
            <a asp-page="/Auth/DangNhap" class="text-decoration-none fw-bold small">Quay lại trang Đăng nhập</a>
        </div>
    </div>

    <!-- Script JavaScript xử lý ẩn/hiện mật khẩu cho Bước 3 -->
    <script>
            // Xử lý cho ô Mật khẩu mới
            const toggleMatKhauMoi = document.getElementById('toggleMatKhauMoi');
            if (toggleMatKhauMoi) {
                toggleMatKhauMoi.addEventListener('click', function () {
                    const input = document.getElementById('matKhauMoiInput');
                    const icon = document.getElementById('eyeIconMatKhauMoi');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    }
                });
            }

            // Xử lý cho ô Xác nhận mật khẩu
            const toggleXacNhanMoi = document.getElementById('toggleXacNhanMoi');
            if (toggleXacNhanMoi) {
                toggleXacNnhanMoi = document.getElementById('toggleXacNhanMoi'); // safety check
                toggleXacNhanMoi.addEventListener('click', function () {
                    const input = document.getElementById('xacNhanMatKhauInput');
                    const icon = document.getElementById('eyeIconXacNhanMoi');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    }
                });
            }
    </script>
</body>
</html>

@page
@model HotelManager.Pages.Auth.XacThucOTPModel
@{
    ViewData["Title"] = "Xác thực OTP (UC_02)";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-lg mt-4">
                <div class="card-header bg-success text-white text-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-shield-check"></i> XÁC THỰC BẢO MẬT</h5>
                </div>
                <div class="card-body p-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.ThongBaoThanhCong))
                    {
                        <div class="alert alert-success p-4">
                            <i class="bi bi-check-circle-fill fs-1 text-success"></i>
                            <h5 class="mt-3">@Model.ThongBaoThanhCong</h5>
                            <p class="mb-3 text-muted">Tài khoản của bạn đã sẵn sàng sử dụng.</p>
                            <a asp-page="./DangNhap" class="btn btn-success px-4 fw-bold">Đi đến Đăng nhập</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-2">Vui lòng nhập mã xác thực OTP 6 số đã được gửi đến Email/SĐT của tài khoản <strong>@Model.TenDangNhap</strong>.</p>
                        <p class="text-danger small mb-4">(Dành cho Tester: Mã OTP mặc định là 123456)</p>

                        @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
                        {
                            <div class="alert alert-danger shadow-sm">@Model.ThongBaoLoi</div>
                        }

                        <form method="post">
                            <!-- Giữ lại Tên đăng nhập để Submit -->
                            <input type="hidden" asp-for="TenDangNhap" />

                            <div class="mb-4">
                                <input asp-for="MaOTP" class="form-control form-control-lg text-center fw-bold fs-4 tracking-wider" placeholder="X X X X X X" maxlength="6" autofocus />
                                <span asp-validation-for="MaOTP" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">Xác Nhận OTP</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model HotelManager.Pages.Auth.DangNhapModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    // Form này sẽ tự động nằm gọn trong _Layout.cshtml chung của hệ thống
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="~/images/logo.png" alt="Grand Horizon Logo" class="img-fluid" style="max-height: 80px; object-fit: contain;" />
                    </div>
                    <h5 class="text-center mb-4 text-muted">Đăng nhập tài khoản</h5>

                    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
                    {
                        <div class="alert alert-danger rounded-3">@Model.ThongBaoLoi</div>
                    }

                    <!-- Bắt buộc dùng method="post" và bỏ trống action để post về chính OnPostAsync -->
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.TenDangNhap" class="form-label fw-semibold">Tên đăng nhập</label>
                            <input asp-for="Input.TenDangNhap" class="form-control rounded-pill px-4" placeholder="Nhập tên đăng nhập" />
                            <span asp-validation-for="Input.TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                            <input asp-for="Input.MatKhau" type="password" class="form-control rounded-pill px-4" placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="Input.MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary rounded-pill fw-bold py-2">ĐĂNG NHẬP</button>
                        </div>
                        
                        <div class="text-center mt-3">
                            <span class="text-muted">Chưa có tài khoản? </span>
                            <a asp-page="/Auth/DangKy" class="text-decoration-none fw-bold">Đăng ký ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
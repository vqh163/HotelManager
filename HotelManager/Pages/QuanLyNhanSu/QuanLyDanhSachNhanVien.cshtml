@page
@model HotelManager.Pages.QuanLyNhanSu.QuanLyDanhSachNhanVienModel
@{
    ViewData["Title"] = "Danh sách Nhân sự";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            @if (!string.IsNullOrEmpty(Model.ThongBao))
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @Model.ThongBao
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Bảng dữ liệu -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-gradient bg-primary text-white p-4 border-0">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-list-task me-2"></i> Quản lý Danh sách Nhân sự</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0 text-center">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-4 text-start">Mã NV</th>
                                    <th class="text-start">Họ Tên</th>
                                    <th>Giới tính</th>
                                    <th>Chức vụ</th>
                                    <th>CCCD</th>
                                    <th>Liên hệ</th>
                                    <th>Ngày vào làm</th>
                                    <th class="text-center pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DanhSachNhanVien != null && Model.DanhSachNhanVien.Any())
                                {
                                    @foreach (var nv in Model.DanhSachNhanVien)
                                    {
                                        <tr class="border-bottom">
                                            <td class="ps-4 text-start"><span class="badge bg-light text-dark border">@nv.MaNV</span></td>
                                            <td class="fw-bold text-primary text-start">@nv.HoTen</td>
                                            <td>
                                                @if (nv.GioiTinh == "Nam")
                                                {
                                                    <span class="text-primary fw-medium"><i class="bi bi-gender-male"></i> Nam</span>
                                                }
                                                else if (nv.GioiTinh == "Nữ")
                                                {
                                                    <span class="text-danger fw-medium"><i class="bi bi-gender-female"></i> Nữ</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@nv.GioiTinh</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">@nv.TenChucVu</span></td>
                                            <td>@nv.SoCCCD</td>
                                            <td>
                                                <div class="text-nowrap"><i class="bi bi-telephone-fill text-secondary me-1"></i> @nv.SDT</div>
                                            </td>
                                            <td>@nv.NgayVaoLam?.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center pe-4">
                                                <a asp-page="./SuaThongTin" asp-route-id="@nv.MaNV" class="btn btn-sm btn-outline-warning rounded-pill px-3 me-2">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@nv.MaNV" class="d-inline" onsubmit="return confirm('Xác nhận xóa nhân viên @nv.HoTen?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i> Chưa có dữ liệu nhân viên.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@page "{id}"
@model HotelManager.Pages.QuanLyNhanSu.SuaThongTinModel
@{
    ViewData["Title"] = "Chỉnh sửa thông tin nhân viên";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Chỉnh sửa Thông tin Nhân viên</h4>
                </div>
                <div class="card-body p-4">
                    <!-- Hiển thị thông báo lỗi từ backend nếu có -->
                    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post">
                        <!-- Mã nhân viên được ẩn đi để định danh bản ghi khi cập nhật -->
                        <input type="hidden" asp-for="Input.MaNV" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.HoTen" class="form-label fw-bold">Họ và Tên</label>
                                <input asp-for="Input.HoTen" class="form-control" required />
                                <span asp-validation-for="Input.HoTen" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.SoCCCD" class="form-label fw-bold">Số CCCD</label>
                                <!-- Giới hạn đúng 12 chữ số theo quy chuẩn -->
                                <input asp-for="Input.SoCCCD" class="form-control" maxlength="12" pattern="^\d{12}$" title="CCCD phải bao gồm đúng 12 chữ số" required />
                                <span asp-validation-for="Input.SoCCCD" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.GioiTinh" class="form-label fw-bold">Giới tính</label>
                                <select asp-for="Input.GioiTinh" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.NgaySinh" class="form-label fw-bold">Ngày sinh</label>
                                <input asp-for="Input.NgaySinh" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.NgayVaoLam" class="form-label fw-bold">Ngày vào làm</label>
                                <input asp-for="Input.NgayVaoLam" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.SDT" class="form-label fw-bold">Số điện thoại</label>
                                <!-- Giới hạn đúng 10 chữ số -->
                                <input asp-for="Input.SDT" class="form-control" maxlength="10" pattern="^\d{10}$" title="Số điện thoại phải bao gồm đúng 10 chữ số" required />
                                <span asp-validation-for="Input.SDT" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                                <!-- Ép định dạng email chuẩn HTML5 -->
                                <input asp-for="Input.Email" type="email" class="form-control" required />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaChucVuSelected" class="form-label fw-bold">Chức vụ</label>
                                <!-- SelectBox binding dữ liệu động từ DB -->
                                <select asp-for="MaChucVuSelected" class="form-select" asp-items="Model.DanhSachChucVuSelectList" required>
                                    <option value="">-- Chọn chức vụ --</option>
                                </select>
                                <span asp-validation-for="MaChucVuSelected" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <!-- Điều hướng về trang danh sách bằng asp-page -->
                            <a asp-page="./QuanLyDanhSachNhanVien" class="btn btn-secondary me-2">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">
                                <i class="bi bi-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (Model.IsManager)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // TECH LEAD HACK: Bơm 3 menu vào Dropdown của _Layout để đồng bộ giao diện
                var dropdowns = document.querySelectorAll('.dropdown-menu');
                var targetDropdown = null;
                
                dropdowns.forEach(function (dd) {
                    if (dd.innerHTML.includes('Đăng xuất') || dd.innerHTML.includes('Logout')) {
                        targetDropdown = dd;
                    }
                });

                if (targetDropdown && !targetDropdown.innerHTML.includes('Danh sách NV')) {
                    var menuHTML = `
                                    <li><a class="dropdown-item py-2 text-dark" href="/QuanLyNhanSu/QuanLyDanhSachNhanVien"><i class="bi bi-people fs-6 text-muted me-2"></i> Danh sách NV</a></li>
                                    <li><a class="dropdown-item py-2 text-dark" href="/QuanLyNhanSu/ThemNhanVien"><i class="bi bi-person-plus fs-6 text-muted me-2"></i> Thêm mới NV</a></li>
                                    <li><a class="dropdown-item py-2 text-dark" href="/QuanLyNhanSu/TinhLuong"><i class="bi bi-cash-coin fs-6 text-muted me-2"></i> Tính lương</a></li>
                                `;
                    
                    var dangXuatLi = null;
                    var lis = targetDropdown.querySelectorAll('li');
                    lis.forEach(function (li) {
                        if (li.innerHTML.includes('Đăng xuất') || li.innerHTML.includes('Logout')) {
                            dangXuatLi = li;
                        }
                    });

                    if (dangXuatLi) {
                        var prevLi = dangXuatLi.previousElementSibling;
                        if (prevLi && prevLi.innerHTML.includes('hr')) {
                            prevLi.insertAdjacentHTML('beforebegin', menuHTML);
                        } else {
                            dangXuatLi.insertAdjacentHTML('beforebegin', menuHTML);
                        }
                    }
                }
            });
        </script>
    }
}
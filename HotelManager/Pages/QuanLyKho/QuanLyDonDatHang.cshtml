@page
@model HotelManager.Pages.QuanLyKho.QuanLyDonDatHangModel
@{
    ViewData["Title"] = "Đề xuất Mua hàng & Đơn đặt hàng (PO)";
}

<style>
    /* Giao diện nền sáng phẳng đồng bộ toàn phân hệ Kho, giữ nguyên Header của _Layout */
    body {
        background-color: #f5f6f8;
        color: #1f2937;
    }

    .po-page {
        max-width: 1440px;
        margin: 0 auto;
        padding: 18px 20px 32px;
    }

    .po-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .po-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .po-subtitle {
        font-size: 0.82rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .po-box {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .po-box-head {
        padding: 11px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .po-table {
        font-size: 0.86rem;
        margin-bottom: 0;
    }

        .po-table thead th {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #6b7280;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 12px;
            white-space: nowrap;
        }

        .po-table tbody td {
            padding: 8px 12px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

    .row-low {
        background-color: #fef2f2;
    }

    .num {
        font-variant-numeric: tabular-nums;
    }

    .st-pill {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 5px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .st-ok {
        background: #dcfce7;
        color: #15803d;
    }

    .st-warn {
        background: #fef9c3;
        color: #a16207;
    }

    .st-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .st-neutral {
        background: #f3f4f6;
        color: #374151;
    }

    .btn-charcoal {
        background: #1f2937;
        border-color: #1f2937;
        color: #ffffff;
        font-weight: 600;
    }

        .btn-charcoal:hover {
            background: #111827;
            border-color: #111827;
            color: #ffffff;
        }
</style>

<div class="po-page">
    <!-- Thông báo kết quả xử lý -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
            @Model.ThongBao
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
            @Model.ThongBaoLoi
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tiêu đề và bộ lọc danh sách đề xuất -->
    <div class="po-header">
        <div>
            <h1 class="po-title">Đề xuất Mua hàng & Đơn đặt hàng (PO)</h1>
            <div class="po-subtitle">
                Tự động quét vật tư chạm mức tồn tối thiểu để lập đơn PO; việc xác nhận nhập kho thực hiện tại phân hệ Nhập Kho
            </div>
        </div>
        <form method="get">
            <select asp-for="CheDoHienThi" class="form-select form-select-sm" style="min-width: 280px;" onchange="this.form.submit()">
                <option value="CAN_NHAP">Chỉ hiện vật tư chạm tồn tối thiểu (@Model.SoMatHangCanNhap)</option>
                <option value="ALL">Hiện toàn bộ danh mục kho để đặt thêm</option>
            </select>
        </form>
    </div>

    <!-- KHỐI 1: Lập Đơn đặt hàng (PO) -->
    <div class="po-box overflow-hidden mb-3">
        <div class="po-box-head">
            <span class="fw-bold small text-dark">Lập đơn đặt hàng (PO) mới</span>
            <span class="small text-muted">Tích chọn các mặt hàng cần mua và điều chỉnh số lượng, đơn giá dự kiến</span>
        </div>

        <form method="post" asp-page-handler="TaoDonPO">
            <input type="hidden" asp-for="CheDoHienThi" />

            <!-- Thông tin chung của đơn PO -->
            <div class="p-3 border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label asp-for="NhaCungCapPO" class="form-label small fw-semibold text-secondary mb-1">
                            Nhà cung cấp <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NhaCungCapPO" class="form-control form-control-sm" placeholder="VD: Công ty Cung ứng Khách sạn Đà Nẵng..." required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NguoiLapPO" class="form-label small fw-semibold text-secondary mb-1">
                            Người lập đề xuất <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NguoiLapPO" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="GhiChuPO" class="form-label small fw-semibold text-secondary mb-1">
                            Ghi chú đơn PO
                        </label>
                        <input asp-for="GhiChuPO" class="form-control form-control-sm" placeholder="VD: Giao trước 8h sáng thứ Hai, xuất hóa đơn VAT..." />
                    </div>
                </div>
            </div>

            <!-- Bảng danh sách vật tư đề xuất mua -->
            <div class="table-responsive">
                <table class="table po-table">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 48px;">Chọn</th>
                            <th>Mã VT</th>
                            <th>Tên hàng hóa / Vật tư</th>
                            <th>Phân khu</th>
                            <th class="text-end">Tồn hiện tại</th>
                            <th class="text-end">Tối thiểu</th>
                            <th class="text-center" style="width: 120px;">SL đặt mua</th>
                            <th class="text-end" style="width: 145px;">Đơn giá dự kiến</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachDeXuat != null && Model.DanhSachDeXuat.Count > 0)
                        {
                            @for (int i = 0; i < Model.DanhSachDeXuat.Count; i++)
                            {
                                bool isLow = Model.DanhSachDeXuat[i].TonHienTai <= Model.DanhSachDeXuat[i].TonToiThieu;
                                decimal thanhTienDong = Model.DanhSachDeXuat[i].SoLuongDeXuat * Model.DanhSachDeXuat[i].DonGiaDuKien;

                                <tr class="@(isLow ? "row-low" : "")">
                                    <td class="text-center">
                                        <input asp-for="DanhSachDeXuat[i].DuocChon"
                                               type="checkbox"
                                               data-index="@i"
                                               class="form-check-input chk-chon-po"
                                               onchange="tinhTongDuToanPO()" />
                                        <!-- Các trường ẩn để Bind đầy đủ dữ liệu về Server -->
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].MaVatTu" />
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].TenVatTu" />
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].LoaiVatTu" />
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].DonViTinh" />
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].TonHienTai" />
                                        <input type="hidden" asp-for="DanhSachDeXuat[i].TonToiThieu" />
                                    </td>
                                    <td class="text-muted fw-semibold num">@Model.DanhSachDeXuat[i].MaVatTu</td>
                                    <td class="fw-semibold text-dark">
                                        @Model.DanhSachDeXuat[i].TenVatTu
                                        @if (isLow)
                                        {
                                            <span class="st-pill st-danger ms-1">Cần nhập</span>
                                        }
                                    </td>
                                    <td><span class="st-pill st-neutral">@Model.DanhSachDeXuat[i].LoaiVatTu</span></td>
                                    <td class="text-end fw-bold num @(isLow ? "text-danger" : "text-dark")">
                                        @Model.DanhSachDeXuat[i].TonHienTai @Model.DanhSachDeXuat[i].DonViTinh
                                    </td>
                                    <td class="text-end text-muted num">@Model.DanhSachDeXuat[i].TonToiThieu @Model.DanhSachDeXuat[i].DonViTinh</td>
                                    <td>
                                        <input asp-for="DanhSachDeXuat[i].SoLuongDeXuat"
                                               id="inpSL_@i"
                                               type="number"
                                               min="1"
                                               class="form-control form-control-sm text-center fw-bold num"
                                               oninput="tinhTongDuToanPO()"
                                               required />
                                    </td>
                                    <td>
                                        <input asp-for="DanhSachDeXuat[i].DonGiaDuKien"
                                               id="inpGia_@i"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control form-control-sm text-end num"
                                               oninput="tinhTongDuToanPO()"
                                               required />
                                    </td>
                                    <td class="text-end fw-semibold text-dark num" id="lblThanhTien_@i">
                                        @thanhTienDong.ToString("N0") ₫
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    Tất cả vật tư hiện tại đều đảm bảo trên định mức tối thiểu.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.DanhSachDeXuat != null && Model.DanhSachDeXuat.Count > 0)
            {
                <div class="px-3 py-3 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small text-secondary">
                        Tổng dự toán đơn đặt hàng (PO):
                        <strong class="fs-6 text-dark ms-1 num" id="lblTongDuToanPO">0 ₫</strong>
                    </div>
                    <button type="submit" class="btn btn-sm btn-charcoal px-4 py-2">
                        Phát hành đơn đặt hàng (PO)
                    </button>
                </div>
            }
        </form>
    </div>

    <!-- KHỐI 2: Danh sách Đơn đặt hàng (PO) đã phát hành -->
    <div class="po-box overflow-hidden">
        <div class="po-box-head">
            <span class="fw-bold small text-dark">Danh sách Đơn đặt hàng (PO) đã lập</span>
            <span class="small text-muted">Tổng: @(Model.DanhSachDonPO?.Count ?? 0) đơn PO</span>
        </div>

        <div class="table-responsive">
            <table class="table po-table">
                <thead>
                    <tr>
                        <th>Mã PO & Ngày lập</th>
                        <th>Nhà cung cấp & Người lập</th>
                        <th>Chi tiết mặt hàng đặt mua</th>
                        <th class="text-end">Tổng dự toán</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Nghiệm thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachDonPO != null && Model.DanhSachDonPO.Any())
                    {
                        @foreach (var po in Model.DanhSachDonPO)
                        {
                            bool daNhanHang = po.TrangThai == "Đã nhận hàng & Nhập kho";
                            <tr>
                                <td class="text-nowrap">
                                    <div class="fw-bold text-dark num">@po.MaPO</div>
                                    <div class="text-muted small num">@po.NgayLap.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@po.NhaCungCap</div>
                                    <div class="text-muted small">Người lập: @po.NguoiLap</div>
                                </td>
                                <td>
                                    <div class="small text-dark">@po.TomTatMatHang</div>
                                    @if (!string.IsNullOrEmpty(po.GhiChu))
                                    {
                                        <div class="small text-muted fst-italic">Ghi chú: @po.GhiChu</div>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-dark num">@po.TongTienDuToan.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @if (daNhanHang)
                                    {
                                        <span class="st-pill st-ok">Đã nhập kho</span>
                                    }
                                    else
                                    {
                                        <span class="st-pill st-warn">Chờ giao hàng</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (!daNhanHang)
                                    {
                                        <a asp-page="./QuanLyNhapKho"
                                           asp-route-XemDonPO="true"
                                           class="btn btn-sm btn-outline-primary py-1 px-3 fw-semibold">
                                            Sang Nhập kho xác nhận
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Hoàn tất</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Chưa có Đơn đặt hàng (PO) nào được phát hành.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // @@ts-nocheck
        // Tính tổng tiền dự toán của các mặt hàng được tích chọn trong bảng đề xuất PO
        function tinhTongDuToanPO() {
            var checkboxes = document.querySelectorAll('.chk-chon-po');
            var tongCong = 0;

            for (var i = 0; i < checkboxes.length; i++) {
                var chk = checkboxes[i];
                var idx = chk.getAttribute('data-index');

                var inpSL = document.getElementById('inpSL_' + idx);
                var inpGia = document.getElementById('inpGia_' + idx);
                var lblDong = document.getElementById('lblThanhTien_' + idx);

                var sl = inpSL ? parseFloat(inpSL['value'] || '0') : 0;
                var gia = inpGia ? parseFloat(inpGia['value'] || '0') : 0;
                var thanhTien = sl * gia;

                if (lblDong) {
                    lblDong.innerText = thanhTien.toLocaleString('vi-VN') + ' ₫';
                }

                if (chk['checked']) {
                    tongCong += thanhTien;
                }
            }

            var lblTong = document.getElementById('lblTongDuToanPO');
            if (lblTong) {
                lblTong.innerText = tongCong.toLocaleString('vi-VN') + ' ₫';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            tinhTongDuToanPO();
        });
    </script>
}
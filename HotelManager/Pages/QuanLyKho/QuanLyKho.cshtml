@page
@model HotelManager.Pages.QuanLyKho.QuanLyKhoModel
@{
    ViewData["Title"] = "Quản lý Danh mục Kho";
}

<style>
    /* Giao diện nền sáng phẳng đồng bộ toàn phân hệ Kho, giữ nguyên Header của _Layout */
    body {
        background-color: #f5f6f8;
        color: #1f2937;
    }

    .kho-page {
        max-width: 1440px;
        margin: 0 auto;
        padding: 18px 20px 32px;
    }

    .kho-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .kho-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .kho-subtitle {
        font-size: 0.82rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .kho-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .kpi-cell {
        padding: 13px 18px;
        border-right: 1px solid #e5e7eb;
    }

        .kpi-cell:last-child {
            border-right: none;
        }

    .kpi-label {
        font-size: 0.74rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #6b7280;
        margin-bottom: 3px;
    }

    .kpi-value {
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .kpi-sub {
        font-size: 0.76rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .zone-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 10px 16px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 14px;
        font-size: 0.84rem;
    }

    .zone-items {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .kho-tab {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.83rem;
        font-weight: 600;
        color: #4b5563;
        background: #f3f4f6;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

        .kho-tab:hover {
            background: #e5e7eb;
            color: #111827;
        }

        .kho-tab.active {
            background: #1f2937;
            color: #ffffff;
        }

    .kho-table {
        font-size: 0.86rem;
        margin-bottom: 0;
    }

        .kho-table thead th {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #6b7280;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 14px;
            white-space: nowrap;
        }

        .kho-table tbody td {
            padding: 9px 14px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .kho-table tbody tr:last-child td {
            border-bottom: none;
        }

        .kho-table tbody tr:hover {
            background-color: #f9fafb;
        }

    .num-col {
        font-variant-numeric: tabular-nums;
    }

    .st-pill {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 5px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .st-ok {
        background: #dcfce7;
        color: #15803d;
    }

    .st-warn {
        background: #fef9c3;
        color: #a16207;
    }

    .st-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .st-neutral {
        background: #f3f4f6;
        color: #374151;
    }

    .btn-charcoal {
        background-color: #1f2937;
        border-color: #1f2937;
        color: #ffffff;
        font-weight: 600;
    }

        .btn-charcoal:hover {
            background-color: #111827;
            border-color: #111827;
            color: #ffffff;
        }

    @@media (max-width: 992px) {
        .kpi-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .kpi-cell {
            border-bottom: 1px solid #e5e7eb;
        }
    }
</style>

<div class="kho-page">
    <!-- Thông báo kết quả xử lý -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
            @Model.ThongBao
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
            @Model.ThongBaoLoi
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tiêu đề trang và nút thêm mới (chỉ hiện với nhóm quản trị kho) -->
    <div class="kho-header">
        <div>
            <h1 class="kho-title">Quản lý Danh mục Kho</h1>
            <div class="kho-subtitle">Theo dõi tồn kho vật dụng buồng phòng, nhà hàng và đồ tiêu hao</div>
        </div>
        @if (Model.CoQuyenQuanTriKho)
        {
            <button type="button" class="btn btn-sm btn-charcoal px-3 py-2" data-bs-toggle="modal" data-bs-target="#modalVatTu" onclick="resetForm()">
                + Thêm vật tư mới
            </button>
        }
    </div>

    <!-- Dải 4 chỉ số tổng quan -->
    <div class="kpi-strip">
        <div class="kpi-cell">
            <div class="kpi-label">Tổng danh mục vật tư</div>
            <div class="kpi-value text-dark">@Model.TongSoMatHang</div>
            <div class="kpi-sub">mặt hàng đang quản lý</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-label">Tổng giá trị vốn tồn</div>
            <div class="kpi-value" style="color: #0056b3;">@Model.TongGiaTriTonKho.ToString("N0") ₫</div>
            <div class="kpi-sub">tính theo đơn giá nhập</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-label">Chạm định mức tối thiểu</div>
            <div class="kpi-value" style="color: #a16207;">@Model.SoMatHangSapHet</div>
            <div class="kpi-sub">mặt hàng cần nhập bù</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-label">Hết hàng (Tồn = 0)</div>
            <div class="kpi-value" style="color: #b91c1c;">@Model.SoMatHangHetSach</div>
            <div class="kpi-sub">cần ưu tiên xử lý</div>
        </div>
    </div>

    <!-- Thanh tóm tắt giá trị vốn theo 3 phân khu kho -->
    <div class="zone-strip">
        <span class="fw-semibold text-secondary small text-uppercase">Giá trị vốn theo phân khu:</span>
        <div class="zone-items">
            <span>Kho vật dụng: <strong class="num-col text-dark">@Model.GiaTriKhoVatDung.ToString("N0") ₫</strong></span>
            <span>Kho nhà hàng: <strong class="num-col text-dark">@Model.GiaTriKhoNhaHang.ToString("N0") ₫</strong></span>
            <span>Kho đồ tiêu hao: <strong class="num-col text-dark">@Model.GiaTriKhoTieuHao.ToString("N0") ₫</strong></span>
        </div>
    </div>

    <!-- Bảng danh mục vật tư rộng 100% chiều ngang -->
    <div class="kho-card overflow-hidden">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex flex-wrap gap-1">
                <a asp-page="./QuanLyKho"
                   asp-route-LoaiVatTuFilter="ALL"
                   asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                   asp-route-TuKhoa="@Model.TuKhoa"
                   class="kho-tab @(Model.LoaiVatTuFilter == "ALL" ? "active" : "")">
                    Tất cả (@Model.TongSoMatHang)
                </a>
                <a asp-page="./QuanLyKho"
                   asp-route-LoaiVatTuFilter="Kho vật dụng"
                   asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                   asp-route-TuKhoa="@Model.TuKhoa"
                   class="kho-tab @(Model.LoaiVatTuFilter == "Kho vật dụng" ? "active" : "")">
                    Vật dụng (@Model.DemKhoVatDung)
                </a>
                <a asp-page="./QuanLyKho"
                   asp-route-LoaiVatTuFilter="Kho nhà hàng"
                   asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                   asp-route-TuKhoa="@Model.TuKhoa"
                   class="kho-tab @(Model.LoaiVatTuFilter == "Kho nhà hàng" ? "active" : "")">
                    Nhà hàng (@Model.DemKhoNhaHang)
                </a>
                <a asp-page="./QuanLyKho"
                   asp-route-LoaiVatTuFilter="Kho đồ tiêu hao"
                   asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                   asp-route-TuKhoa="@Model.TuKhoa"
                   class="kho-tab @(Model.LoaiVatTuFilter == "Kho đồ tiêu hao" ? "active" : "")">
                    Đồ tiêu hao (@Model.DemKhoTieuHao)
                </a>
            </div>

            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <input type="hidden" asp-for="LoaiVatTuFilter" />
                <select asp-for="TrangThaiTonFilter" class="form-select form-select-sm" style="width: 175px;" onchange="this.form.submit()">
                    <option value="ALL">Mọi trạng thái tồn</option>
                    <option value="AN_TOAN">Đủ định mức an toàn</option>
                    <option value="SAP_HET">Chạm đáy tối thiểu</option>
                    <option value="HET_HANG">Đã hết hàng (0)</option>
                </select>
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input asp-for="TuKhoa" class="form-control" placeholder="Tìm mã hoặc tên vật tư..." />
                    <button type="submit" class="btn btn-charcoal px-3">Tìm</button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table kho-table">
                <thead>
                    <tr>
                        <th>Mã VT</th>
                        <th>Tên hàng hóa / Vật tư</th>
                        <th>Phân loại</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-end">Đơn giá nhập</th>
                        <th class="text-end">Tồn / Tối thiểu</th>
                        <th class="text-end">Giá trị tồn</th>
                        <th class="text-center">Trạng thái</th>
                        @if (Model.CoQuyenQuanTriKho)
                        {
                            <th class="text-end">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachVatTu != null && Model.DanhSachVatTu.Any())
                    {
                        @foreach (var vt in Model.DanhSachVatTu)
                        {
                            int slTon = vt.SoLuongTon ?? 0;
                            int slToiThieu = vt.SoLuongTonToiThieu ?? 0;
                            decimal giaNhap = vt.DonGiaNhap ?? 0;
                            decimal giaTriTon = slTon * giaNhap;
                            bool isOut = slTon <= 0;
                            bool isLow = !isOut && slTon <= slToiThieu;

                            <tr>
                                <td class="text-muted fw-semibold num-col">@vt.MaVatTu</td>
                                <td class="fw-semibold text-dark">@(vt.TenVatTu ?? "Chưa cập nhật")</td>
                                <td><span class="st-pill st-neutral">@(vt.LoaiVatTu ?? "Chưa phân loại")</span></td>
                                <td class="text-center text-secondary">@(vt.DonViTinh ?? "-")</td>
                                <td class="text-end num-col">@giaNhap.ToString("N0") ₫</td>
                                <td class="text-end num-col">
                                    <span class="fw-bold @(isOut || isLow ? "text-danger" : "text-dark")">@slTon</span>
                                    <span class="text-muted"> / @slToiThieu</span>
                                </td>
                                <td class="text-end num-col fw-semibold text-dark">@giaTriTon.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @if (isOut)
                                    {
                                        <span class="st-pill st-danger">Hết hàng</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="st-pill st-warn">Sắp hết</span>
                                    }
                                    else
                                    {
                                        <span class="st-pill st-ok">An toàn</span>
                                    }
                                </td>
                                @if (Model.CoQuyenQuanTriKho)
                                {
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 me-1"
                                                data-mavt="@vt.MaVatTu"
                                                data-tenvt="@(vt.TenVatTu ?? "")"
                                                data-loaivt="@(vt.LoaiVatTu ?? "Kho vật dụng")"
                                                data-dvt="@(vt.DonViTinh ?? "")"
                                                data-gianhap="@giaNhap.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-slton="@slTon"
                                                data-sltoithieu="@slToiThieu"
                                                onclick="editVatTuFromBtn(this)">
                                            Sửa
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@vt.MaVatTu" class="d-inline" onsubmit="return confirm('Xác nhận xóa vật tư này khỏi danh mục kho?');">
                                            <input type="hidden" name="LoaiVatTuFilter" value="@Model.LoaiVatTuFilter" />
                                            <input type="hidden" name="TrangThaiTonFilter" value="@Model.TrangThaiTonFilter" />
                                            <input type="hidden" name="TuKhoa" value="@Model.TuKhoa" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Xóa</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.CoQuyenQuanTriKho ? 9 : 8)" class="text-center text-muted py-4">
                                Không tìm thấy vật tư phù hợp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.CoQuyenQuanTriKho)
{
    <!-- Modal Thêm mới / Cập nhật Vật tư (chỉ render khi có quyền quản trị kho) -->
    <div class="modal fade" id="modalVatTu" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom py-3 px-4">
                    <h6 class="modal-title fw-bold mb-0" id="modalTitle">Khai báo vật tư mới</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form method="post" asp-page-handler="Create" id="formVatTu">
                    <input type="hidden" name="LoaiVatTuFilter" value="@Model.LoaiVatTuFilter" />
                    <input type="hidden" name="TrangThaiTonFilter" value="@Model.TrangThaiTonFilter" />
                    <input type="hidden" name="TuKhoa" value="@Model.TuKhoa" />
                    <input type="hidden" asp-for="InputData.MaVatTu" id="inpMaVatTu" />

                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="InputData.TenVatTu" class="form-label small fw-semibold">Tên vật tư / hàng hóa <span class="text-danger">*</span></label>
                                <input asp-for="InputData.TenVatTu" id="inpTenVatTu" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InputData.LoaiVatTu" class="form-label small fw-semibold">Phân loại kho <span class="text-danger">*</span></label>
                                <select asp-for="InputData.LoaiVatTu" id="inpLoaiVatTu" class="form-select form-select-sm" required>
                                    <option value="Kho vật dụng">Kho vật dụng</option>
                                    <option value="Kho nhà hàng">Kho nhà hàng</option>
                                    <option value="Kho đồ tiêu hao">Kho đồ tiêu hao</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InputData.DonViTinh" class="form-label small fw-semibold">Đơn vị tính <span class="text-danger">*</span></label>
                                <input asp-for="InputData.DonViTinh" id="inpDonViTinh" class="form-control form-control-sm" placeholder="VD: Cái, Bộ, Kg, Chai..." required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InputData.DonGiaNhap" class="form-label small fw-semibold">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="InputData.DonGiaNhap" id="inpDonGiaNhap" type="number" step="0.01" min="0" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InputData.SoLuongTon" class="form-label small fw-semibold">Số lượng tồn hiện tại <span class="text-danger">*</span></label>
                                <input asp-for="InputData.SoLuongTon" id="inpSoLuongTon" type="number" min="0" class="form-control form-control-sm fw-bold" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InputData.SoLuongTonToiThieu" class="form-label small fw-semibold">Định mức tồn tối thiểu <span class="text-danger">*</span></label>
                                <input asp-for="InputData.SoLuongTonToiThieu" id="inpTonToiThieu" type="number" min="0" class="form-control form-control-sm" required />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top py-2 px-4">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-sm btn-charcoal px-4">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // @@ts-nocheck
        function resetForm() {
            var titleEl = document.getElementById('modalTitle');
            if (titleEl) titleEl.innerText = 'Khai báo vật tư mới';

            var formEl = document.getElementById('formVatTu');
            if (formEl) formEl.setAttribute('action', '?handler=Create');

            var fields = {
                inpMaVatTu: '',
                inpTenVatTu: '',
                inpLoaiVatTu: 'Kho vật dụng',
                inpDonViTinh: '',
                inpDonGiaNhap: '0',
                inpSoLuongTon: '0',
                inpTonToiThieu: '10'
            };

            Object.keys(fields).forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el['value'] = fields[id];
            });
        }

        function editVatTuFromBtn(btn) {
            if (!btn) return;

            var maVT = btn.getAttribute('data-mavt') || '';
            var titleEl = document.getElementById('modalTitle');
            if (titleEl) titleEl.innerText = 'Cập nhật vật tư (' + maVT + ')';

            var formEl = document.getElementById('formVatTu');
            if (formEl) formEl.setAttribute('action', '?handler=Update');

            document.getElementById('inpMaVatTu')['value'] = maVT;
            document.getElementById('inpTenVatTu')['value'] = btn.getAttribute('data-tenvt') || '';
            document.getElementById('inpLoaiVatTu')['value'] = btn.getAttribute('data-loaivt') || 'Kho vật dụng';
            document.getElementById('inpDonViTinh')['value'] = btn.getAttribute('data-dvt') || '';
            document.getElementById('inpDonGiaNhap')['value'] = btn.getAttribute('data-gianhap') || '0';
            document.getElementById('inpSoLuongTon')['value'] = btn.getAttribute('data-slton') || '0';
            document.getElementById('inpTonToiThieu')['value'] = btn.getAttribute('data-sltoithieu') || '0';

            var modalEl = document.getElementById('modalVatTu');
            var bs = window['bootstrap'];
            if (modalEl && bs) {
                var modal = new bs.Modal(modalEl);
                modal.show();
            }
        }
    </script>
}
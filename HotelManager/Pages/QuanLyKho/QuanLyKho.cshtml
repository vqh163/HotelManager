@page
@model HotelManager.Pages.QuanLyKho.QuanLyKhoModel
@{
    ViewData["Title"] = "Quản lý Danh mục Kho";
}

<style>
    /* Tông màu nền trung tính, dịu mắt và hiện đại */
    body {
        background-color: #f8fafc;
    }

    /* Thiết kế thẻ phẳng, viền mảnh tinh tế */
    .clean-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    }

    /* Nút lọc phân khu kho dạng Tab viên thuốc (Pill Tabs) gọn gàng */
    .warehouse-tab {
        padding: 0.45rem 1rem;
        border-radius: 50rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
        background-color: #f1f5f9;
        text-decoration: none;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .warehouse-tab:hover {
        background-color: #e2e8f0;
        color: #1e293b;
    }
    .warehouse-tab.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 2px 6px rgba(13, 110, 253, 0.25);
    }

    /* Tinh chỉnh bảng dữ liệu thoáng và dễ đọc */
    .table-clean th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
    }
    .table-clean td {
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<!-- Mở rộng khung nhìn với khoảng cách lề cân đối, giữ nguyên Header & Logo của _Layout -->
<div class="container-fluid px-4 py-4" style="max-width: 1600px;">

    <!-- Khu vực hiển thị thông báo kết quả thao tác -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.ThongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PHẦN 1: Dải 4 Thẻ KPI Tối Giản (Giúp nắm bắt nhanh toàn cảnh kho) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="clean-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold d-block">Tổng danh mục vật tư</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TongSoMatHang <small class="fs-6 fw-normal text-muted">mặt hàng</small></h4>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-4">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="clean-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold d-block">Tổng giá trị vốn tồn</span>
                    <h4 class="fw-bold text-success mb-0 mt-1">@Model.TongGiaTriTonKho.ToString("N0") ₫</h4>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="clean-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold d-block">Chạm định mức tối thiểu</span>
                    <h4 class="fw-bold text-warning mb-0 mt-1">@Model.SoMatHangSapHet <small class="fs-6 fw-normal text-muted">cần nhập</small></h4>
                </div>
                <div class="rounded-3 bg-warning bg-opacity-15 text-warning p-3 fs-4">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="clean-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold d-block">Vật tư hết sạch (Tồn = 0)</span>
                    <h4 class="fw-bold text-danger mb-0 mt-1">@Model.SoMatHangHetSach <small class="fs-6 fw-normal text-muted">mặt hàng</small></h4>
                </div>
                <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-4">
                    <i class="bi bi-x-octagon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- PHẦN 2: Bố cục 2 Cột (Trái 9 cột: Bảng dữ liệu chính | Phải 3 cột: Cảnh báo & Cơ cấu vốn) -->
    <div class="row g-4">

        <!-- CỘT CHÍNH BÊN TRÁI (9 Cột): Bảng Danh mục & Thanh bộ lọc tích hợp -->
        <div class="col-12 col-xl-9">
            <div class="clean-card overflow-hidden">

                <!-- Header của Bảng: Tiêu đề và Nút Thêm mới -->
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-white">
                    <div>
                        <h5 class="mb-1 fw-bold text-dark">
                            <i class="bi bi-layers-half text-primary me-2"></i>Danh mục Hàng hóa & Tồn kho (UC_09)
                        </h5>
                        <p class="mb-0 text-muted small">Quản lý tập trung vật tư buồng phòng, nhà hàng và đồ tiêu hao</p>
                    </div>
                    <button type="button" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalVatTu" onclick="resetForm()">
                        <i class="bi bi-plus-lg me-1"></i> Thêm Vật tư mới
                    </button>
                </div>

                <!-- Thanh Công Cụ Gộp (Chọn Kho + Lọc Trạng Thái + Tìm Kiếm) trên 1 dòng gọn gàng -->
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <!-- Cụm Tab chọn nhanh 3 phân khu kho -->
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-page="./QuanLyKho"
                           asp-route-LoaiVatTuFilter="ALL"
                           asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                           asp-route-TuKhoa="@Model.TuKhoa"
                           class="warehouse-tab @(Model.LoaiVatTuFilter == "ALL" ? "active" : "")">
                            Tất cả (@Model.TongSoMatHang)
                        </a>
                        <a asp-page="./QuanLyKho"
                           asp-route-LoaiVatTuFilter="Kho vật dụng"
                           asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                           asp-route-TuKhoa="@Model.TuKhoa"
                           class="warehouse-tab @(Model.LoaiVatTuFilter == "Kho vật dụng" ? "active" : "")">
                            Kho vật dụng (@Model.DemKhoVatDung)
                        </a>
                        <a asp-page="./QuanLyKho"
                           asp-route-LoaiVatTuFilter="Kho nhà hàng"
                           asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                           asp-route-TuKhoa="@Model.TuKhoa"
                           class="warehouse-tab @(Model.LoaiVatTuFilter == "Kho nhà hàng" ? "active" : "")">
                            Kho nhà hàng (@Model.DemKhoNhaHang)
                        </a>
                        <a asp-page="./QuanLyKho"
                           asp-route-LoaiVatTuFilter="Kho đồ tiêu hao"
                           asp-route-TrangThaiTonFilter="@Model.TrangThaiTonFilter"
                           asp-route-TuKhoa="@Model.TuKhoa"
                           class="warehouse-tab @(Model.LoaiVatTuFilter == "Kho đồ tiêu hao" ? "active" : "")">
                            Kho đồ tiêu hao (@Model.DemKhoTieuHao)
                        </a>
                    </div>

                    <!-- Cụm Lọc định mức tồn và Ô tìm kiếm -->
                    <form method="get" class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end" style="max-width: 480px;">
                        <input type="hidden" asp-for="LoaiVatTuFilter" />

                        <select asp-for="TrangThaiTonFilter" class="form-select form-select-sm rounded-pill border-secondary border-opacity-25 fw-semibold" style="width: 175px;" onchange="this.form.submit()">
                            <option value="ALL">Mọi trạng thái tồn</option>
                            <option value="AN_TOAN">Đủ định mức an toàn</option>
                            <option value="SAP_HET">Chạm đáy tối thiểu</option>
                            <option value="HET_HANG">Đã hết hàng (0)</option>
                        </select>

                        <div class="input-group input-group-sm">
                            <input asp-for="TuKhoa" class="form-control rounded-start-pill border-secondary border-opacity-25 ps-3" placeholder="Tìm tên hoặc mã VT..." />
                            <button type="submit" class="btn btn-dark rounded-end-pill px-3">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Bảng danh sách vật tư rộng rãi, thoáng mắt -->
                <div class="table-responsive">
                    <table class="table table-hover table-borderless table-clean align-middle mb-0 text-center">
                        <thead>
                            <tr>
                                <th class="ps-4 text-start">Mã VT</th>
                                <th class="text-start">Tên Hàng Hóa / Vật Tư</th>
                                <th>Phân Loại Kho</th>
                                <th>ĐVT</th>
                                <th>Đơn Giá Nhập</th>
                                <th>Tồn Hiện Tại / Định Mức</th>
                                <th>Trạng Thái</th>
                                <th class="pe-4 text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DanhSachVatTu != null && Model.DanhSachVatTu.Any())
                            {
                                @foreach (var vt in Model.DanhSachVatTu)
                                {
                                    int slTon = vt.SoLuongTon ?? 0;
                                    int slToiThieu = vt.SoLuongTonToiThieu ?? 0;
                                    decimal giaNhap = vt.DonGiaNhap ?? 0;
                                    bool isOut = slTon <= 0;
                                    bool isLow = !isOut && slTon <= slToiThieu;

                                    <tr>
                                        <td class="ps-4 text-start">
                                            <span class="badge bg-light text-secondary border fw-semibold">@vt.MaVatTu</span>
                                        </td>
                                        <td class="text-start fw-bold text-dark">
                                            @(vt.TenVatTu ?? "Chưa cập nhật")
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 fw-medium">
                                                @(vt.LoaiVatTu ?? "Chưa phân loại")
                                            </span>
                                        </td>
                                        <td class="text-secondary">@(vt.DonViTinh ?? "-")</td>
                                        <td class="fw-semibold text-dark">@giaNhap.ToString("N0") ₫</td>
                                        <td>
                                            <span class="fs-6 fw-bold @(isOut || isLow ? "text-danger" : "text-primary")">@slTon</span>
                                            <span class="text-muted small"> / Min: @slToiThieu</span>
                                        </td>
                                        <td>
                                            @if (isOut)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3">
                                                    Hết hàng
                                                </span>
                                            }
                                            else if (isLow)
                                            {
                                                <span class="badge bg-warning bg-opacity-15 text-dark border border-warning rounded-pill px-3">
                                                    Sắp hết
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                                    An toàn
                                                </span>
                                            }
                                        </td>
                                        <td class="pe-4 text-end text-nowrap">
                                            <!-- Nút chỉnh sửa thông tin vật tư -->
                                            <button type="button" class="btn btn-sm btn-light text-primary border rounded-pill px-3 me-1"
                                                    title="Chỉnh sửa"
                                                    data-mavt="@vt.MaVatTu"
                                                    data-tenvt="@(vt.TenVatTu ?? "")"
                                                    data-loaivt="@(vt.LoaiVatTu ?? "Kho vật dụng")"
                                                    data-dvt="@(vt.DonViTinh ?? "")"
                                                    data-gianhap="@giaNhap"
                                                    data-slton="@slTon"
                                                    data-sltoithieu="@slToiThieu"
                                                    onclick="editVatTuFromBtn(this)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <!-- Form xóa vật tư -->
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@vt.MaVatTu" class="d-inline" onsubmit="return confirm('Xác nhận xóa vật tư này khỏi danh mục kho?');">
                                                <input type="hidden" name="LoaiVatTuFilter" value="@Model.LoaiVatTuFilter" />
                                                <input type="hidden" name="TrangThaiTonFilter" value="@Model.TrangThaiTonFilter" />
                                                <input type="hidden" name="TuKhoa" value="@Model.TuKhoa" />
                                                <button type="submit" class="btn btn-sm btn-light text-danger border rounded-pill px-3" title="Xóa">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i> Không tìm thấy vật tư nào phù hợp với điều kiện lọc.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CỘT PHỤ BÊN PHẢI (3 Cột): Cảnh báo Nhập bù nhanh & Tóm tắt Vốn theo kho -->
        <div class="col-12 col-xl-3">

            <!-- Khối 1: Nhập bù nhanh cho các mặt hàng chạm ngưỡng tối thiểu -->
            <div class="clean-card overflow-hidden mb-4">
                <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Đề Xuất Nhập Bù Nhanh
                    </h6>
                    <span class="badge bg-danger rounded-pill">@Model.DanhSachCanhBao.Count</span>
                </div>

                <div class="p-3">
                    @if (Model.DanhSachCanhBao != null && Model.DanhSachCanhBao.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var cb in Model.DanhSachCanhBao.Take(5))
                            {
                                int ton = cb.SoLuongTon ?? 0;
                                int min = cb.SoLuongTonToiThieu ?? 0;
                                int goiYNhap = (min > 0 ? min * 2 : 20) - ton;
                                if (goiYNhap <= 0) goiYNhap = 10;

                                <div class="p-2 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                                    <div class="text-truncate pe-2">
                                        <div class="fw-bold text-dark small text-truncate">@cb.TenVatTu</div>
                                        <small class="text-muted">Tồn: <strong class="text-danger">@ton</strong> / Min: @min</small>
                                    </div>
                                    <form method="post" asp-page-handler="NhapBuNhanh">
                                        <input type="hidden" name="maVatTu" value="@cb.MaVatTu" />
                                        <input type="hidden" name="soLuongBu" value="@goiYNhap" />
                                        <input type="hidden" name="LoaiVatTuFilter" value="@Model.LoaiVatTuFilter" />
                                        <input type="hidden" name="TrangThaiTonFilter" value="@Model.TrangThaiTonFilter" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 fw-bold text-nowrap" style="font-size: 0.75rem;"
                                                title="Bổ sung ngay @goiYNhap @cb.DonViTinh vào kho">
                                            +@goiYNhap @cb.DonViTinh
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-check2-circle text-success fs-2 d-block mb-1"></i>
                            <span class="small text-muted">Tất cả vật tư đều đạt định mức an toàn.</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Khối 2: Thống kê giá trị vốn theo 3 phân khu kho -->
            <div class="clean-card overflow-hidden">
                <div class="p-3 border-bottom bg-white">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-pie-chart text-primary me-1"></i> Giá Trị Vốn Theo Phân Khu
                    </h6>
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small text-secondary"><i class="bi bi-circle-fill text-primary me-2" style="font-size: 0.5rem;"></i>Kho vật dụng</span>
                        <span class="fw-bold text-dark small">@Model.GiaTriKhoVatDung.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small text-secondary"><i class="bi bi-circle-fill text-success me-2" style="font-size: 0.5rem;"></i>Kho nhà hàng</span>
                        <span class="fw-bold text-dark small">@Model.GiaTriKhoNhaHang.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="small text-secondary"><i class="bi bi-circle-fill text-info me-2" style="font-size: 0.5rem;"></i>Kho đồ tiêu hao</span>
                        <span class="fw-bold text-dark small">@Model.GiaTriKhoTieuHao.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Modal Thêm mới / Cập nhật Vật Tư -->
<div class="modal fade" id="modalVatTu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white border-bottom-0 p-4">
                <h5 class="modal-title fw-bold" id="modalTitle">
                    <i class="bi bi-box-arrow-in-down me-2"></i>Khai báo Vật tư mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form method="post" asp-page-handler="Create" id="formVatTu">
                <input type="hidden" name="LoaiVatTuFilter" value="@Model.LoaiVatTuFilter" />
                <input type="hidden" name="TrangThaiTonFilter" value="@Model.TrangThaiTonFilter" />
                <input type="hidden" name="TuKhoa" value="@Model.TuKhoa" />
                <input type="hidden" asp-for="InputData.MaVatTu" id="inpMaVatTu" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="InputData.TenVatTu" class="form-label fw-bold small text-secondary">Tên vật tư / hàng hóa <span class="text-danger">*</span></label>
                            <input asp-for="InputData.TenVatTu" id="inpTenVatTu" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputData.LoaiVatTu" class="form-label fw-bold small text-secondary">Phân loại Kho <span class="text-danger">*</span></label>
                            <select asp-for="InputData.LoaiVatTu" id="inpLoaiVatTu" class="form-select rounded-3" required>
                                <option value="Kho vật dụng">Kho vật dụng</option>
                                <option value="Kho nhà hàng">Kho nhà hàng</option>
                                <option value="Kho đồ tiêu hao">Kho đồ tiêu hao</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputData.DonViTinh" class="form-label fw-bold small text-secondary">Đơn vị tính <span class="text-danger">*</span></label>
                            <input asp-for="InputData.DonViTinh" id="inpDonViTinh" class="form-control rounded-3" placeholder="VD: Cái, Bộ, Kg, Chai..." required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputData.DonGiaNhap" class="form-label fw-bold small text-secondary">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="InputData.DonGiaNhap" id="inpDonGiaNhap" type="number" step="0.01" min="0" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputData.SoLuongTon" class="form-label fw-bold small text-primary">Số lượng tồn kho hiện tại <span class="text-danger">*</span></label>
                            <input asp-for="InputData.SoLuongTon" id="inpSoLuongTon" type="number" min="0" class="form-control rounded-3 bg-light fw-bold" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputData.SoLuongTonToiThieu" class="form-label fw-bold small text-danger">Định mức tồn tối thiểu <span class="text-danger">*</span></label>
                            <input asp-for="InputData.SoLuongTonToiThieu" id="inpTonToiThieu" type="number" min="0" class="form-control rounded-3" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // @@ts-nocheck
        // Làm mới dữ liệu trên Modal khi người dùng bấm Thêm Vật tư mới
        function resetForm() {
            var titleEl = document.getElementById('modalTitle');
            if (titleEl) titleEl.innerHTML = '<i class="bi bi-box-arrow-in-down me-2"></i>Khai báo Vật tư mới';

            var formEl = document.getElementById('formVatTu');
            if (formEl) formEl.setAttribute('action', '?handler=Create');

            var inpMa = document.getElementById('inpMaVatTu');
            if (inpMa) inpMa['value'] = '';

            var inpTen = document.getElementById('inpTenVatTu');
            if (inpTen) inpTen['value'] = '';

            var inpLoai = document.getElementById('inpLoaiVatTu');
            if (inpLoai) inpLoai['value'] = 'Kho vật dụng';

            var inpDvt = document.getElementById('inpDonViTinh');
            if (inpDvt) inpDvt['value'] = '';

            var inpGia = document.getElementById('inpDonGiaNhap');
            if (inpGia) inpGia['value'] = '0';

            var inpTon = document.getElementById('inpSoLuongTon');
            if (inpTon) inpTon['value'] = '0';

            var inpToiThieu = document.getElementById('inpTonToiThieu');
            if (inpToiThieu) inpToiThieu['value'] = '10';
        }

        // Đổ dữ liệu từ dòng được chọn lên Modal để chỉnh sửa
        function editVatTuFromBtn(btn) {
            if (!btn) return;

            var maVT = btn.getAttribute('data-mavt') || '';
            var tenVT = btn.getAttribute('data-tenvt') || '';
            var loaiVT = btn.getAttribute('data-loaivt') || 'Kho vật dụng';
            var dvt = btn.getAttribute('data-dvt') || '';
            var giaNhap = btn.getAttribute('data-gianhap') || '0';
            var slTon = btn.getAttribute('data-slton') || '0';
            var slToiThieu = btn.getAttribute('data-sltoithieu') || '0';

            var titleEl = document.getElementById('modalTitle');
            if (titleEl) titleEl.innerHTML = '<i class="bi bi-pencil-square me-2"></i>Cập nhật Vật tư (' + maVT + ')';

            var formEl = document.getElementById('formVatTu');
            if (formEl) formEl.setAttribute('action', '?handler=Update');

            var inpMa = document.getElementById('inpMaVatTu');
            if (inpMa) inpMa['value'] = maVT;

            var inpTen = document.getElementById('inpTenVatTu');
            if (inpTen) inpTen['value'] = tenVT;

            var inpLoai = document.getElementById('inpLoaiVatTu');
            if (inpLoai) inpLoai['value'] = loaiVT;

            var inpDvt = document.getElementById('inpDonViTinh');
            if (inpDvt) inpDvt['value'] = dvt;

            var inpGia = document.getElementById('inpDonGiaNhap');
            if (inpGia) inpGia['value'] = giaNhap;

            var inpTon = document.getElementById('inpSoLuongTon');
            if (inpTon) inpTon['value'] = slTon;

            var inpToiThieu = document.getElementById('inpTonToiThieu');
            if (inpToiThieu) inpToiThieu['value'] = slToiThieu;

            var modalEl = document.getElementById('modalVatTu');
            var bs = window['bootstrap'];
            if (modalEl && bs) {
                var modal = new bs.Modal(modalEl);
                modal.show();
            }
        }
    </script>
}
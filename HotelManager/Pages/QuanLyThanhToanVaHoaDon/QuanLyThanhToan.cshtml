@page
@model HotelManager.Pages.QuanLyThanhToan.QuanLyThanhToanModel
@{
    ViewData["Title"] = "Quầy Thu Ngân & Thanh Toán";
}

<style>
    body {
        background-color: #eef2f6;
    }

    .checkout-container {
        max-width: 1120px;
    }

    .checkout-shell {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }
    /* Cột phiếu biên lai giấy bên trái */
    .paper-receipt {
        background: #f8fafc;
        border-right: 1px dashed #cbd5e1;
        padding: 32px 28px;
    }

    .receipt-line {
        border-top: 1px dashed #cbd5e1;
        margin: 16px 0;
    }
    /* Nút chọn 4 phương thức thanh toán */
    .method-radio {
        display: none;
    }

    .method-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border: 1.5px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.18s ease;
    }

        .method-card:hover {
            border-color: #94a3b8;
            background: #f8fafc;
        }

    .method-radio:checked + .method-card {
        border-color: #059669;
        background: #ecfdf5;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.12);
    }

    .method-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #475569;
    }

    .method-radio:checked + .method-card .method-icon {
        background: #059669;
        color: #ffffff;
    }
</style>

<div class="container py-4 checkout-container">

    <!-- Thanh chọn nhanh hóa đơn chờ thanh toán ở trên cùng -->
    <div class="bg-white border rounded-4 p-3 shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 fs-5">
                <i class="bi bi-cash-register"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-0">Quầy Thu Ngân </h5>
                <small class="text-muted">Đang chờ thanh toán: <strong>@Model.HoaDonChuaThanhToan.Count hóa đơn</strong></small>
            </div>
        </div>

        <form method="get" class="d-flex align-items-center gap-2" style="min-width: 340px;">
            <label asp-for="MaHoaDonChon" class="small fw-bold text-secondary text-nowrap mb-0">Chọn hóa đơn:</label>
            <select asp-for="MaHoaDonChon" class="form-select form-select-sm rounded-pill fw-semibold border-success" onchange="this.form.submit()">
                @if (Model.HoaDonChuaThanhToan.Any())
                {
                    @foreach (var item in Model.HoaDonChuaThanhToan)
                    {
                        <option value="@item.MaHoaDon">
                            @item.MaHoaDon • DP: @(item.DAT_PHONGMaDatPhong ?? "Lẻ") • @((item.TongTienThanhToan ?? 0).ToString("N0")) ₫
                        </option>
                    }
                }
                else
                {
                    <option value="">-- Không còn hóa đơn chờ thu --</option>
                }
            </select>
        </form>
    </div>

    <!-- Thông báo hệ thống -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.ThongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.HoaDonDangChon != null)
    {
        var hd = Model.HoaDonDangChon;
        decimal tongThu = hd.TongTienThanhToan ?? 0;

        <div class="checkout-shell">
            <div class="row g-0">

                <!-- CỘT TRÁI (5 cột): Phiếu tính tiền kiểu biên lai khách sạn -->
                <div class="col-12 col-lg-5 paper-receipt d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="letter-spacing: 0.06em;">Phiếu quyết toán</small>
                                <h4 class="fw-bold text-dark mb-0">@hd.MaHoaDon</h4>
                            </div>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Chờ thu</span>
                        </div>

                        <div class="small text-secondary mb-3">
                            <div class="d-flex justify-content-between py-1"><span>Mã Đặt phòng:</span><strong class="text-dark">@(hd.DAT_PHONGMaDatPhong ?? "-")</strong></div>
                            <div class="d-flex justify-content-between py-1"><span>Mã Khách hàng:</span><strong class="text-dark">@(hd.KHACH_HANGMaKH ?? "Khách vãng lai")</strong></div>
                            <div class="d-flex justify-content-between py-1"><span>Thời điểm lập:</span><span>@(hd.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span></div>
                        </div>

                        <div class="receipt-line"></div>

                        <div class="small">
                            <div class="d-flex justify-content-between py-1"><span class="text-secondary">Tiền phòng lưu trú</span><span class="fw-semibold">@((hd.TienPhong ?? 0).ToString("N0")) ₫</span></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-secondary">Dịch vụ & Minibar</span><span class="fw-semibold">@((hd.TienDichVu ?? 0).ToString("N0")) ₫</span></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-secondary">Nhà hàng & Ăn uống</span><span class="fw-semibold">@((hd.TienNhaHang ?? 0).ToString("N0")) ₫</span></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-secondary">Thuế GTGT (VAT)</span><span class="fw-semibold">+@((hd.TienThueVAT ?? 0).ToString("N0")) ₫</span></div>
                            <div class="d-flex justify-content-between py-1 text-danger"><span>Giảm giá / Chiết khấu</span><span>-@((hd.TienGiamGia ?? 0).ToString("N0")) ₫</span></div>
                            <div class="d-flex justify-content-between py-1 text-primary"><span>Tiền cọc khấu trừ</span><span>-@((hd.TienCocDaTru ?? 0).ToString("N0")) ₫</span></div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-bold text-secondary small text-uppercase">Tổng khách cần trả</span>
                            <span class="fs-2 fw-bold text-success">@tongThu.ToString("N0") ₫</span>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI (7 cột): Cổng thanh toán đa phương thức -->
                <div class="col-12 col-lg-7 p-4 p-md-5">
                    <form method="post" asp-page-handler="XacNhanThanhToan">
                        <input type="hidden" asp-for="Input.MaHoaDon" value="@hd.MaHoaDon" />
                        <input type="hidden" asp-for="Input.SoTien" value="@tongThu" />

                        <h6 class="fw-bold text-dark mb-3">Chọn hình thức thanh toán</h6>

                        <!-- Lưới 2x2 phương thức thanh toán rộng rãi, dễ bấm -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <input type="radio" asp-for="Input.PhuongThucThanhToan" value="Tiền mặt" id="radTienMat" class="method-radio" checked onchange="doiHinhThucThanhToan()" />
                                <label for="radTienMat" class="method-card">
                                    <div class="method-icon"><i class="bi bi-cash-stack"></i></div>
                                    <div>
                                        <div class="fw-bold text-dark small">Tiền mặt</div>
                                        <small class="text-muted">Thu trực tiếp & tính tiền thối</small>
                                    </div>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" asp-for="Input.PhuongThucThanhToan" value="Chuyển khoản (VietQR)" id="radVietQR" class="method-radio" onchange="doiHinhThucThanhToan()" />
                                <label for="radVietQR" class="method-card">
                                    <div class="method-icon"><i class="bi bi-qr-code-scan"></i></div>
                                    <div>
                                        <div class="fw-bold text-dark small">Chuyển khoản VietQR</div>
                                        <small class="text-muted">Sinh mã QR động & Deep-link</small>
                                    </div>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" asp-for="Input.PhuongThucThanhToan" value="Thẻ tín dụng / ATM" id="radThe" class="method-radio" onchange="doiHinhThucThanhToan()" />
                                <label for="radThe" class="method-card">
                                    <div class="method-icon"><i class="bi bi-credit-card-2-front"></i></div>
                                    <div>
                                        <div class="fw-bold text-dark small">Quẹt thẻ POS</div>
                                        <small class="text-muted">Visa / Mastercard / ATM nội địa</small>
                                    </div>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" asp-for="Input.PhuongThucThanhToan" value="Ví điện tử (MoMo/VNPay)" id="radVi" class="method-radio" onchange="doiHinhThucThanhToan()" />
                                <label for="radVi" class="method-card">
                                    <div class="method-icon"><i class="bi bi-phone"></i></div>
                                    <div>
                                        <div class="fw-bold text-dark small">Ví điện tử</div>
                                        <small class="text-muted">MoMo / VNPay QR</small>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Vùng 1: Tính tiền mặt khách đưa / thối lại -->
                        <div id="boxTienMat" class="p-3 rounded-4 bg-light border mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <label for="inpTienKhachDua" class="small fw-bold text-secondary mb-0">Tiền khách đưa (VNĐ)</label>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-white bg-white border rounded-pill px-2 py-0 small" onclick="chonMenhGia(@tongThu)">Vừa đủ</button>
                                    <button type="button" class="btn btn-sm btn-white bg-white border rounded-pill px-2 py-0 small" onclick="chonMenhGia(500000)">500k</button>
                                    <button type="button" class="btn btn-sm btn-white bg-white border rounded-pill px-2 py-0 small" onclick="chonMenhGia(1000000)">1 Triệu</button>
                                    <button type="button" class="btn btn-sm btn-white bg-white border rounded-pill px-2 py-0 small" onclick="chonMenhGia(2000000)">2 Triệu</button>
                                </div>
                            </div>
                            <input type="number" id="inpTienKhachDua" class="form-control form-control-lg fw-bold rounded-3 mb-2" value="@tongThu" min="0" oninput="tinhTienThoiLai()" />
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="small text-secondary fw-semibold">Tiền thối lại:</span>
                                <span id="lblTienThoiLai" class="fs-5 fw-bold text-success">0 ₫</span>
                            </div>
                        </div>

                        <!-- Vùng 2: VietQR Động + Deep-link -->
                        <div id="boxVietQR" class="p-3 rounded-4 bg-light border mb-4 d-none">
                            <div class="row align-items-center g-3">
                                <div class="col-sm-5 text-center">
                                    <img id="imgQRDong" src="" alt="Mã VietQR thanh toán" class="img-fluid rounded-3 border bg-white p-1" style="max-width: 170px;" />
                                </div>
                                <div class="col-sm-7 small">
                                    <div class="fw-bold text-success mb-1"><i class="bi bi-qr-code me-1"></i>Mã QR Động tự động</div>
                                    <div class="mb-1">Thụ hưởng: <strong>GRAND HORIZON HOTEL</strong></div>
                                    <div class="mb-1">Số tiền: <strong class="text-danger">@tongThu.ToString("N0") ₫</strong></div>
                                    <div class="mb-3">Nội dung: <code class="bg-white px-2 py-1 rounded border text-dark">TT @hd.MaHoaDon</code></div>
                                    <a id="lnkThanhToanApp" href="#" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở Deep-link Ngân hàng
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Vùng 3: Nhập mã giao dịch tham chiếu PCI-DSS -->
                        <div id="boxMaThamChieu" class="mb-4 d-none">
                            <label asp-for="Input.MaGiaoDichNgoai" class="form-label fw-bold small text-secondary">
                                Mã giao dịch cổng thanh toán / Máy POS (Transaction ID)
                            </label>
                            <input asp-for="Input.MaGiaoDichNgoai" class="form-control rounded-3" placeholder="VD: VNPAY2026..., MOMO..., mã chuẩn chi POS..." />
                            <small class="text-muted"><i class="bi bi-shield-lock text-success me-1"></i>Chuẩn PCI-DSS: Chỉ lưu mã giao dịch tham chiếu, tuyệt đối không lưu số thẻ.</small>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm"
                                onclick="return confirm('Xác nhận hoàn tất thu @tongThu.ToString("N0") ₫ cho hóa đơn @hd.MaHoaDon?');">
                            <i class="bi bi-check2-circle me-2"></i>Xác nhận Thanh toán (@tongThu.ToString("N0") ₫)
                        </button>
                    </form>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="checkout-shell p-5 text-center">
            <i class="bi bi-patch-check-fill text-success fs-1 d-block mb-3"></i>
            <h5 class="fw-bold text-dark">Tất cả hóa đơn đã được quyết toán!</h5>
            <p class="text-muted small mb-3">Hiện tại không còn hóa đơn nào ở trạng thái chờ thanh toán.</p>
            <a asp-page="./QuanLyHoaDon" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">Về danh sách Hóa đơn</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // @@ts-nocheck
        var maHDHienTai = '@(Model.HoaDonDangChon?.MaHoaDon ?? "")';
        var tongTienThu = parseFloat('@((Model.HoaDonDangChon?.TongTienThanhToan ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))');

        function doiHinhThucThanhToan() {
            var chon = document.querySelector('input[name="Input.PhuongThucThanhToan"]:checked');
            if (!chon) return;
            var pt = chon.value;

            document.getElementById('boxTienMat').classList.add('d-none');
            document.getElementById('boxVietQR').classList.add('d-none');
            document.getElementById('boxMaThamChieu').classList.add('d-none');

            if (pt === 'Tiền mặt') {
                document.getElementById('boxTienMat').classList.remove('d-none');
                tinhTienThoiLai();
            } else if (pt.includes('VietQR') || pt.includes('Ví điện tử')) {
                document.getElementById('boxVietQR').classList.remove('d-none');
                document.getElementById('boxMaThamChieu').classList.remove('d-none');
                var amt = Math.max(0, Math.round(tongTienThu));
                var info = encodeURIComponent('TT ' + maHDHienTai);
                document.getElementById('imgQRDong').src = 'https://img.vietqr.io/image/MB-0000123456789-compact2.png?amount=' + amt + '&addInfo=' + info + '&accountName=GRAND%20HORIZON%20HOTEL';
                document.getElementById('lnkThanhToanApp').href = 'https://dl.vietqr.io/pay?app=mb&ba=0000123456789@mb&am=' + amt + '&tn=' + info;
            } else {
                document.getElementById('boxMaThamChieu').classList.remove('d-none');
            }
        }

        function chonMenhGia(val) {
            document.getElementById('inpTienKhachDua').value = Math.round(val);
            tinhTienThoiLai();
        }

        function tinhTienThoiLai() {
            var dua = parseFloat(document.getElementById('inpTienKhachDua').value || '0');
            var thoi = dua - tongTienThu;
            var lbl = document.getElementById('lblTienThoiLai');
            if (thoi < 0) {
                lbl.className = 'fs-5 fw-bold text-danger';
                lbl.innerText = 'Còn thiếu ' + Math.abs(thoi).toLocaleString('vi-VN') + ' ₫';
            } else {
                lbl.className = 'fs-5 fw-bold text-success';
                lbl.innerText = thoi.toLocaleString('vi-VN') + ' ₫';
            }
        }

        document.addEventListener('DOMContentLoaded', doiHinhThucThanhToan);
    </script>
}
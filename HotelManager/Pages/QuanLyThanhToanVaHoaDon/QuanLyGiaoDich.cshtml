@page
@model HotelManager.Pages.QuanLyThanhToan.QuanLyGiaoDichModel
@{
    ViewData["Title"] = "Sổ Nhật ký & Đối soát Giao dịch";
}

<style>
    body {
        background-color: #f6f7f9;
    }

    .ledger-box {
        background: #ffffff;
        border: 1px solid #dfe3e8;
        border-radius: 12px;
    }

    .ledger-table th {
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #475569;
        background: #f1f5f9;
        border-bottom: 2px solid #cbd5e1;
        padding: 0.85rem 0.75rem;
    }

    .ledger-table td {
        padding: 0.85rem 0.75rem;
        border-bottom: 1px solid #eef2f6;
        font-size: 0.9rem;
    }

    .method-bar-segment {
        height: 10px;
    }

    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="container-fluid px-4 py-4" style="max-width: 1460px;">

    <!-- Thanh tiêu đề & Nút xuất sổ đối soát Kế toán -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-bookmark-fill text-dark me-2"></i>Sổ cái Đối soát Giao dịch Tài chính 
            </h4>
            
        </div>
        <div class="d-flex gap-2 no-print">
            <a asp-page-handler="ExportCsv"
               asp-route-TuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")"
               asp-route-DenNgay="@Model.DenNgay.ToString("yyyy-MM-dd")"
               asp-route-PhuongThucFilter="@Model.PhuongThucFilter"
               asp-route-TuKhoa="@Model.TuKhoa"
               class="btn btn-outline-success rounded-3 fw-semibold px-3">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất CSV Kế toán
            </a>
            <button type="button" class="btn btn-dark rounded-3 fw-semibold px-3" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> In Sổ đối soát
            </button>
        </div>
    </div>

    <!-- Thông báo kết quả xử lý -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4 no-print" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.ThongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4 no-print" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KHỐI PHÂN TÍCH DÒNG TIỀN THEO PHƯƠNG THỨC (Thiết kế đặc trưng cho Kế toán) -->
    <div class="ledger-box p-4 mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5 border-end">
                <small class="text-uppercase text-muted fw-bold d-block mb-1">Dòng tiền thực thu ròng (Net Cashflow)</small>
                <div class="fs-2 fw-bold text-dark mb-2">@((Model.TongThuVao - Model.TongHoanTra).ToString("N0")) ₫</div>
                <div class="d-flex gap-4 small">
                    <span class="text-success fw-semibold"><i class="bi bi-arrow-down-left me-1"></i>Tổng Có (Thu): +@Model.TongThuVao.ToString("N0") ₫</span>
                    <span class="text-danger fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Tổng Nợ (Hoàn): -@Model.TongHoanTra.ToString("N0") ₫</span>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="d-flex justify-content-between small fw-bold text-secondary mb-2">
                    <span>Cơ cấu dòng tiền thu vào theo phương thức</span>
                    <span>@Model.DanhSachGiaoDich.Count bút toán</span>
                </div>

                <!-- Thanh tỷ trọng trực quan -->
                <div class="progress rounded-pill mb-3" style="height: 10px;">
                    <div class="progress-bar bg-success" style="width: @Model.TyLeTienMat.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%" title="Tiền mặt"></div>
                    <div class="progress-bar bg-primary" style="width: @Model.TyLeVietQR.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%" title="VietQR"></div>
                    <div class="progress-bar bg-dark" style="width: @Model.TyLeThe.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%" title="Thẻ POS"></div>
                    <div class="progress-bar bg-info" style="width: @Model.TyLeVi.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%" title="Ví điện tử"></div>
                </div>

                <div class="row g-2 small">
                    <div class="col-6 col-sm-3">
                        <span class="d-inline-block rounded-circle bg-success me-1" style="width:8px;height:8px;"></span>
                        <span class="text-muted">Tiền mặt:</span>
                        <div class="fw-bold text-dark">@Model.TongTienMat.ToString("N0") ₫</div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-inline-block rounded-circle bg-primary me-1" style="width:8px;height:8px;"></span>
                        <span class="text-muted">VietQR:</span>
                        <div class="fw-bold text-dark">@Model.TongVietQR.ToString("N0") ₫</div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-inline-block rounded-circle bg-dark me-1" style="width:8px;height:8px;"></span>
                        <span class="text-muted">Thẻ POS:</span>
                        <div class="fw-bold text-dark">@Model.TongThe.ToString("N0") ₫</div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-inline-block rounded-circle bg-info me-1" style="width:8px;height:8px;"></span>
                        <span class="text-muted">Ví điện tử:</span>
                        <div class="fw-bold text-dark">@Model.TongVi.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG SỔ CÁI GIAO DỊCH -->
    <div class="ledger-box overflow-hidden">
        <!-- Bộ lọc kỳ đối soát -->
        <div class="p-3 bg-light border-bottom no-print">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label asp-for="TuNgay" class="form-label small fw-bold text-secondary mb-1">Từ ngày</label>
                    <input asp-for="TuNgay" type="date" class="form-control form-control-sm rounded-3" />
                </div>
                <div class="col-md-2">
                    <label asp-for="DenNgay" class="form-label small fw-bold text-secondary mb-1">Đến ngày</label>
                    <input asp-for="DenNgay" type="date" class="form-control form-control-sm rounded-3" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PhuongThucFilter" class="form-label small fw-bold text-secondary mb-1">Phương thức</label>
                    <select asp-for="PhuongThucFilter" class="form-select form-select-sm rounded-3">
                        <option value="ALL">Tất cả phương thức</option>
                        <option value="Tiền mặt">Tiền mặt</option>
                        <option value="Chuyển khoản (VietQR)">Chuyển khoản (VietQR)</option>
                        <option value="Thẻ tín dụng / ATM">Thẻ tín dụng / ATM</option>
                        <option value="Ví điện tử (MoMo/VNPay)">Ví điện tử (MoMo/VNPay)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="TuKhoa" class="form-label small fw-bold text-secondary mb-1">Tìm bút toán / Mã cổng ngoài</label>
                    <input asp-for="TuKhoa" class="form-control form-control-sm rounded-3" placeholder="Mã TT, mã HĐ, Transaction ID..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100 rounded-3 fw-bold py-1">
                        <i class="bi bi-funnel me-1"></i> Đối soát
                    </button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover ledger-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Thời Gian</th>
                        <th>Mã Bút Toán</th>
                        <th>Chứng Từ Gốc</th>
                        <th>Phương Thức</th>
                        <th>Mã Tham Chiếu (PCI-DSS)</th>
                        <th class="text-end text-success">Thu Vào (+)</th>
                        <th class="text-end text-danger">Hoàn Trả (-)</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="pe-4 text-end no-print">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachGiaoDich.Any())
                    {
                        @foreach (var gd in Model.DanhSachGiaoDich)
                        {
                            decimal st = gd.SoTien ?? 0;
                            bool isHoan = gd.TrangThaiGiaoDich == "Đã hoàn tiền" || st < 0;
                            bool coTheHoan = !isHoan && gd.TrangThaiGiaoDich == "Thành công" && !string.IsNullOrEmpty(gd.HOA_DONMaHoaDon);

                            <tr>
                                <td class="ps-4 text-muted small text-nowrap">@(gd.ThoiGianGiaoDich?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</td>
                                <td class="fw-bold text-dark">@gd.MaThanhToan</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(gd.HOA_DONMaHoaDon))
                                    {
                                        <span class="badge bg-light text-primary border">HĐ: @gd.HOA_DONMaHoaDon</span>
                                    }
                                    else if (!string.IsNullOrEmpty(gd.HOA_DON_NHA_HANGMaHoaDonNhaHang))
                                    {
                                        <span class="badge bg-light text-dark border">NH: @gd.HOA_DON_NHA_HANGMaHoaDonNhaHang</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">Ví Tiền cọc</span>
                                    }
                                </td>
                                <td class="small">@(gd.PhuongThucThanhToan ?? "-")</td>
                                <td><code class="text-dark bg-light px-2 py-1 rounded border small">@(gd.MaGiaoDichNgoai ?? "-")</code></td>
                                <td class="text-end fw-bold text-success">
                                    @(st > 0 && !isHoan ? "+" + st.ToString("N0") + " ₫" : "-")
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    @(isHoan ? "-" + Math.Abs(st).ToString("N0") + " ₫" : "-")
                                </td>
                                <td class="text-center">
                                    <span class="badge @(isHoan ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success") rounded-pill px-3">
                                        @(gd.TrangThaiGiaoDich ?? "Thành công")
                                    </span>
                                </td>
                                <td class="pe-4 text-end no-print">
                                    @if (coTheHoan)
                                    {
                                        <form method="post" asp-page-handler="HoanTienGiaoDich" asp-route-maThanhToan="@gd.MaThanhToan" class="d-inline"
                                              onsubmit="return confirm('Xác nhận hoàn tiền bút toán @gd.MaThanhToan và mở lại hóa đơn @gd.HOA_DONMaHoaDon?');">
                                            <input type="hidden" asp-for="TuNgay" />
                                            <input type="hidden" asp-for="DenNgay" />
                                            <input type="hidden" asp-for="PhuongThucFilter" />
                                            <input type="hidden" asp-for="TuKhoa" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2 fw-semibold">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Hoàn tiền
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-journal-x fs-2 d-block mb-2"></i> Không có bút toán giao dịch nào trong kỳ đối soát.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
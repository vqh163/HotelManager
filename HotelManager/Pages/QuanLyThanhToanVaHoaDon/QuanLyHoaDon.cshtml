@page
@model HotelManager.Pages.QuanLyThanhToan.QuanLyHoaDonModel
@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}

<style>
    body {
        background-color: #f6f8fb;
    }

    .inv-wrapper {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }

    .inv-table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.9rem 0.75rem;
    }

    .inv-table td {
        padding: 0.95rem 0.75rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .nav-tab-pill {
        padding: 0.45rem 1.1rem;
        border-radius: 10px;
        font-size: 0.86rem;
        font-weight: 600;
        color: #475569;
        text-decoration: none;
        transition: all 0.15s;
    }

        .nav-tab-pill:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .nav-tab-pill.active {
            background: #0f172a;
            color: #ffffff;
        }

    .merge-list-scroll {
        max-height: 290px;
        overflow-y: auto;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        #vungInHoaDonGTGT, #vungInHoaDonGTGT * {
            visibility: visible;
        }

        #vungInHoaDonGTGT {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            padding: 24px;
        }
    }
</style>

<div class="container-fluid px-4 py-4" style="max-width: 1460px;">

    <!-- Thanh tiêu đề & Cụm nút Ghép nhiều hóa đơn / Lập hóa đơn mới -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>Quản lý Hóa đơn 
            </h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark rounded-3 fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#modalGhepNhieuHoaDon">
                <i class="bi bi-union me-1"></i> Ghép nhiều hóa đơn
            </button>
            <button type="button" class="btn btn-primary rounded-3 fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalLapHoaDon">
                <i class="bi bi-plus-lg me-1"></i> Lập Hóa đơn mới
            </button>
        </div>
    </div>

    <!-- Thông báo hệ thống -->
    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.ThongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ThongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dải tóm tắt số liệu ngang tinh gọn -->
    <div class="inv-wrapper p-3 mb-4">
        <div class="row g-3 text-center text-md-start align-items-center">
            <div class="col-6 col-md-3 border-end">
                <div class="px-2">
                    <span class="text-muted small fw-semibold">Tổng số hóa đơn</span>
                    <div class="fs-4 fw-bold text-dark">@Model.TongSoHoaDon</div>
                </div>
            </div>
            <div class="col-6 col-md-3 border-end">
                <div class="px-2">
                    <span class="text-muted small fw-semibold">Doanh thu đã quyết toán</span>
                    <div class="fs-4 fw-bold text-success">@Model.TongDoanhThuDaThu.ToString("N0") ₫</div>
                </div>
            </div>
            <div class="col-6 col-md-3 border-end">
                <div class="px-2">
                    <span class="text-muted small fw-semibold">Công nợ chờ thanh toán</span>
                    <div class="fs-4 fw-bold text-warning">@Model.TongCongNoChoThu.ToString("N0") ₫</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="px-2">
                    <span class="text-muted small fw-semibold">Thuế GTGT (VAT) bóc tách</span>
                    <div class="fs-4 fw-bold text-primary">@Model.TongThueVAT.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng quản lý hóa đơn toàn chiều rộng -->
    <div class="inv-wrapper overflow-hidden">
        <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex gap-2 bg-light p-1 rounded-3">
                <a asp-page="./QuanLyHoaDon" asp-route-TrangThaiFilter="ALL" asp-route-TuKhoa="@Model.TuKhoa"
                   class="nav-tab-pill @(Model.TrangThaiFilter == "ALL" ? "active" : "")">
                    Tất cả (@Model.TongSoHoaDon)
                </a>
                <a asp-page="./QuanLyHoaDon" asp-route-TrangThaiFilter="Chưa thanh toán" asp-route-TuKhoa="@Model.TuKhoa"
                   class="nav-tab-pill @(Model.TrangThaiFilter == "Chưa thanh toán" ? "active" : "")">
                    Chưa thanh toán (@Model.SoChuaThanhToan)
                </a>
                <a asp-page="./QuanLyHoaDon" asp-route-TrangThaiFilter="Đã thanh toán" asp-route-TuKhoa="@Model.TuKhoa"
                   class="nav-tab-pill @(Model.TrangThaiFilter == "Đã thanh toán" ? "active" : "")">
                    Đã thanh toán (@Model.SoDaThanhToan)
                </a>
            </div>

            <form method="get" class="d-flex gap-2" style="min-width: 310px;">
                <input type="hidden" asp-for="TrangThaiFilter" />
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input asp-for="TuKhoa" class="form-control bg-light border-start-0 shadow-none" placeholder="Tìm mã HĐ, mã đặt phòng, mã KH..." />
                    <button type="submit" class="btn btn-dark px-3 fw-semibold">Lọc</button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-borderless inv-table align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="ps-4 text-start">Mã Hóa Đơn</th>
                        <th class="text-start">Đặt Phòng / Khách</th>
                        <th>Tiền Phòng</th>
                        <th>Dịch Vụ & NH</th>
                        <th>VAT / Giảm giá</th>
                        <th>Cọc Đã Trừ</th>
                        <th>Tổng Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Nghiệp Vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachHoaDon.Any())
                    {
                        @foreach (var hd in Model.DanhSachHoaDon)
                        {
                            bool isPaid = hd.TrangThaiThanhToan == "Đã thanh toán";
                            decimal tienPhong = hd.TienPhong ?? 0;
                            decimal tienDV = hd.TienDichVu ?? 0;
                            decimal tienNH = hd.TienNhaHang ?? 0;
                            decimal tienGiam = hd.TienGiamGia ?? 0;
                            decimal tienVAT = hd.TienThueVAT ?? 0;
                            decimal tienCoc = hd.TienCocDaTru ?? 0;
                            decimal tongTT = hd.TongTienThanhToan ?? 0;

                            <tr>
                                <td class="ps-4 text-start">
                                    <div class="fw-bold text-dark">@hd.MaHoaDon</div>
                                    <small class="text-muted">@(hd.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small>
                                </td>
                                <td class="text-start small">
                                    <div class="fw-semibold text-primary">@(hd.DAT_PHONGMaDatPhong ?? "Khách lẻ")</div>
                                    <span class="text-muted">KH: @(hd.KHACH_HANGMaKH ?? "-")</span>
                                </td>
                                <td class="small fw-semibold text-dark">@tienPhong.ToString("N0") ₫</td>
                                <td class="small text-secondary">
                                    <div>DV: @tienDV.ToString("N0") ₫</div>
                                    <div>NH: @tienNH.ToString("N0") ₫</div>
                                </td>
                                <td class="small">
                                    <div class="text-dark">+@tienVAT.ToString("N0") ₫</div>
                                    @if (tienGiam > 0)
                                    {
                                        <div class="text-danger">-@tienGiam.ToString("N0") ₫</div>
                                    }
                                </td>
                                <td class="small fw-semibold text-primary">-@tienCoc.ToString("N0") ₫</td>
                                <td class="fw-bold fs-6 text-success">@tongTT.ToString("N0") ₫</td>
                                <td>
                                    @if (isPaid)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-dark border border-warning rounded-pill px-3 py-2">Chưa thanh toán</span>
                                    }
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    <!-- 1. Xem & In Hóa đơn điện tử GTGT -->
                                    <button type="button" class="btn btn-sm btn-light border rounded-3 px-2 me-1" title="Xem & In Hóa đơn GTGT"
                                            data-mahd="@hd.MaHoaDon"
                                            data-madp="@(hd.DAT_PHONGMaDatPhong ?? "-")"
                                            data-makh="@(hd.KHACH_HANGMaKH ?? "-")"
                                            data-ngay="@(hd.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")"
                                            data-phong="@tienPhong"
                                            data-dv="@tienDV"
                                            data-nh="@tienNH"
                                            data-giam="@tienGiam"
                                            data-vat="@tienVAT"
                                            data-coc="@tienCoc"
                                            data-tong="@tongTT"
                                            data-tt="@(hd.TrangThaiThanhToan ?? "Chưa thanh toán")"
                                            onclick="moModalInGTGT(this)">
                                        <i class="bi bi-printer text-dark"></i>
                                    </button>

                                    @if (!isPaid)
                                    {
                                        <!-- 2. Ghi nợ chi phí dịch vụ / nhà hàng vào phòng -->
                                        <button type="button" class="btn btn-sm btn-light border rounded-3 px-2 me-1" title="Ghi nợ dịch vụ vào phòng"
                                                onclick="moModalGhiNo('@hd.MaHoaDon')">
                                            <i class="bi bi-plus-circle text-primary"></i>
                                        </button>

                                        <!-- 3. Chia đều hóa đơn cho nhiều người -->
                                        @if (tongTT > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border rounded-3 px-2 me-1" title="Chia hóa đơn thành nhiều phần"
                                                    onclick="moModalChiaHoaDon('@hd.MaHoaDon', '@tongTT')">
                                                <i class="bi bi-pie-chart text-info"></i>
                                            </button>
                                        }

                                        <!-- 4. Tách riêng Dịch vụ & Nhà hàng sang hóa đơn phụ -->
                                        @if (tienDV + tienNH > 0)
                                        {
                                            <form method="post" asp-page-handler="TachHoaDon" asp-route-maHoaDonGoc="@hd.MaHoaDon" class="d-inline"
                                                  onsubmit="return confirm('Tách riêng chi phí Dịch vụ & Nhà hàng (@((tienDV + tienNH).ToString("N0")) ₫) sang một hóa đơn mới?');">
                                                <button type="submit" class="btn btn-sm btn-light border rounded-3 px-2 me-1" title="Tách Dịch vụ & Nhà hàng">
                                                    <i class="bi bi-scissors text-warning"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- 5. Chuyển sang Quầy Thu Ngân -->
                                        <a asp-page="./QuanLyThanhToan" asp-route-MaHoaDonChon="@hd.MaHoaDon"
                                           class="btn btn-sm btn-primary rounded-3 px-3 fw-semibold">
                                            Thu tiền
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i> Không có hóa đơn nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Lập Hóa đơn mới -->
<div class="modal fade" id="modalLapHoaDon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 p-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-plus me-2"></i>Lập Hóa đơn Thanh toán mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="TaoHoaDon">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="InputHoaDon.DAT_PHONGMaDatPhong" class="form-label fw-bold small text-secondary">Mã Đặt Phòng</label>
                            <input asp-for="InputHoaDon.DAT_PHONGMaDatPhong" class="form-control rounded-3" placeholder="VD: DP001" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InputHoaDon.KHACH_HANGMaKH" class="form-label fw-bold small text-secondary">Mã Khách Hàng</label>
                            <input asp-for="InputHoaDon.KHACH_HANGMaKH" class="form-control rounded-3" placeholder="VD: KH001" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InputHoaDon.TienPhong" class="form-label fw-bold small text-secondary">Tiền Phòng (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="InputHoaDon.TienPhong" type="number" min="0" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InputHoaDon.TienDichVu" class="form-label fw-bold small text-secondary">Tiền Dịch Vụ (VNĐ)</label>
                            <input asp-for="InputHoaDon.TienDichVu" type="number" min="0" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InputHoaDon.TienNhaHang" class="form-label fw-bold small text-secondary">Tiền Nhà Hàng (VNĐ)</label>
                            <input asp-for="InputHoaDon.TienNhaHang" type="number" min="0" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InputHoaDon.TienGiamGia" class="form-label fw-bold small text-secondary">Giảm Giá / Chiết Khấu</label>
                            <input asp-for="InputHoaDon.TienGiamGia" type="number" min="0" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InputHoaDon.TienCocDaTru" class="form-label fw-bold small text-primary">Tiền Cọc Khấu Trừ</label>
                            <input asp-for="InputHoaDon.TienCocDaTru" type="number" min="0" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TyLeVAT" class="form-label fw-bold small text-secondary">Thuế suất VAT (%)</label>
                            <input asp-for="TyLeVAT" type="number" min="0" max="20" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold">Lưu Hóa Đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Ghi nợ chi phí dịch vụ / nhà hàng vào hóa đơn phòng -->
<div class="modal fade" id="modalGhiNo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 p-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-journal-plus me-2"></i>Ghi nợ Dịch vụ vào phòng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="GhiNoDichVu">
                <div class="modal-body p-4">
                    <input type="hidden" asp-for="InputGhiNo.MaHoaDon" id="inpGhiNoMaHD" />
                    <div class="mb-3 p-3 bg-light rounded-3 border d-flex justify-content-between">
                        <span class="small text-muted">Mã hóa đơn:</span>
                        <strong class="text-primary" id="lblGhiNoMaHD">-</strong>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InputGhiNo.LoaiChiPhi" class="form-label fw-bold small text-secondary">Loại chi phí phát sinh</label>
                        <select asp-for="InputGhiNo.LoaiChiPhi" class="form-select rounded-3">
                            <option value="DichVu">Dịch vụ phòng / Minibar / Giặt ủi</option>
                            <option value="NhaHang">Chi phí Nhà hàng / Ăn uống</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label asp-for="InputGhiNo.SoTienThem" class="form-label fw-bold small text-secondary">Số tiền cộng thêm (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="InputGhiNo.SoTienThem" type="number" min="1000" step="1000" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold">Xác nhận Ghi nợ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Chia Hóa Đơn thành 2 đến 10 phần bằng nhau -->
<div class="modal fade" id="modalChiaHoaDon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-info text-dark border-0 p-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-pie-chart-fill me-2"></i>Chia Hóa Đơn (Share Bill)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ChiaHoaDon">
                <div class="modal-body p-4">
                    <input type="hidden" asp-for="InputChia.MaHoaDonGoc" id="inpChiaMaHD" />

                    <div class="p-3 bg-light rounded-3 border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Hóa đơn gốc:</span>
                            <strong class="text-primary" id="lblChiaMaHD">-</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tổng giá trị hiện tại:</span>
                            <strong class="text-dark fs-6" id="lblChiaTongGoc">0 ₫</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InputChia.SoPhanChia" class="form-label fw-bold small text-secondary">
                            Chia đều thành bao nhiêu hóa đơn? (2 – 10 phần) <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-2 mb-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="datSoPhanChia(2)">2 phần</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="datSoPhanChia(3)">3 phần</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="datSoPhanChia(4)">4 phần</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="datSoPhanChia(5)">5 phần</button>
                        </div>
                        <input asp-for="InputChia.SoPhanChia" id="inpSoPhanChia" type="number" min="2" max="10" value="2"
                               class="form-control form-control-lg fw-bold rounded-3" oninput="capNhatXemTruocChia()" required />
                    </div>

                    <div class="p-3 rounded-3 bg-info bg-opacity-10 border border-info border-opacity-25 small">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-dark fw-semibold">Dự kiến mỗi hóa đơn cần thu:</span>
                            <strong class="fs-5 text-primary" id="lblDuKienMoiPhan">0 ₫</strong>
                        </div>
                        <div class="text-muted mt-1" style="font-size: 0.78rem;">
                            * Hệ thống tự chia tỷ lệ Tiền phòng, Dịch vụ, Nhà hàng, VAT, Cọc và cộng phần dư làm tròn vào hóa đơn gốc.
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info text-dark rounded-3 px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận Chia hóa đơn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 4: Ghép NHIỀU Hóa đơn chưa thanh toán cùng lúc (2, 3, 4... hóa đơn) -->
<div class="modal fade" id="modalGhepNhieuHoaDon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 p-4">
                <div>
                    <h5 class="modal-title fw-bold mb-0"><i class="bi bi-union me-2"></i>Ghép nhiều Hóa đơn (Multi-Merge Folio)</h5>
                    <small class="text-white-50">Tích chọn từ 2 hóa đơn chưa thanh toán trở lên để gộp chung thành 1 hóa đơn</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="GhepNhieuHoaDon" onsubmit="return kiemTraTruocKhiGhep();">
                <div class="modal-body p-4">
                    @if (Model.HoaDonChuaThanhToanDeGhep.Count >= 2)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkChonTatCaGhep" onchange="chonTatCaHoaDonGhep(this)" />
                                <label class="form-check-label small fw-bold text-secondary" for="chkChonTatCaGhep">
                                    Chọn tất cả (@Model.HoaDonChuaThanhToanDeGhep.Count hóa đơn chưa thu)
                                </label>
                            </div>
                            <span class="badge bg-primary rounded-pill px-3 py-2" id="lblDemHoaDonGhep">
                                Đã chọn: 0 hóa đơn
                            </span>
                        </div>

                        <div class="merge-list-scroll border rounded-3 mb-3">
                            <table class="table table-sm table-hover align-middle mb-0 small">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3" style="width: 44px;">Chọn</th>
                                        <th>Mã HĐ</th>
                                        <th>Đặt Phòng / KH</th>
                                        <th class="text-end pe-3">Tổng Hiện Tại</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hd in Model.HoaDonChuaThanhToanDeGhep)
                                    {
                                        decimal st = hd.TongTienThanhToan ?? 0;
                                        <tr>
                                            <td class="ps-3">
                                                <input type="checkbox"
                                                       name="DanhSachMaHoaDonGhep"
                                                       value="@hd.MaHoaDon"
                                                       data-amount="@st"
                                                       class="form-check-input chk-item-ghep"
                                                       onchange="capNhatThongKeGhep()" />
                                            </td>
                                            <td class="fw-bold text-dark">@hd.MaHoaDon</td>
                                            <td class="text-muted">DP: @(hd.DAT_PHONGMaDatPhong ?? "-") • KH: @(hd.KHACH_HANGMaKH ?? "-")</td>
                                            <td class="text-end pe-3 fw-bold text-success">@st.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-3 align-items-center bg-light p-3 rounded-3 border">
                            <div class="col-md-6">
                                <label asp-for="MaHoaDonGiuLai" class="form-label fw-bold small text-secondary mb-1">
                                    Hóa đơn chính giữ lại (Tùy chọn)
                                </label>
                                <select asp-for="MaHoaDonGiuLai" class="form-select form-select-sm rounded-3">
                                    <option value="">-- Tự động giữ hóa đơn đầu tiên được chọn --</option>
                                    @foreach (var hd in Model.HoaDonChuaThanhToanDeGhep)
                                    {
                                        <option value="@hd.MaHoaDon">@hd.MaHoaDon (DP: @(hd.DAT_PHONGMaDatPhong ?? "-"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <small class="text-muted d-block">Tổng tiền ước tính sau khi ghép:</small>
                                <span class="fs-4 fw-bold text-primary" id="lblTongTienGhep">0 ₫</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                            Cần có ít nhất <strong>2 hóa đơn chưa thanh toán</strong> để thực hiện ghép hóa đơn.
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light border-0 px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    @if (Model.HoaDonChuaThanhToanDeGhep.Count >= 2)
                    {
                        <button type="submit" class="btn btn-dark rounded-3 px-4 fw-bold">
                            <i class="bi bi-union me-1"></i> Xác nhận Ghép các hóa đơn đã chọn
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 5: Mẫu Hóa đơn Điện tử GTGT để In / Xuất PDF -->
<div class="modal fade" id="modalInGTGT" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-body p-4" id="vungInHoaDonGTGT">
                <div class="text-center border-bottom pb-3 mb-3">
                    <h5 class="fw-bold text-dark mb-0">GRAND HORIZON HOTEL</h5>
                    <small class="text-muted">HÓA ĐƠN GIÁ TRỊ GIA TĂNG ĐIỆN TỬ (GTGT)</small>
                    <div class="mt-2"><span class="badge bg-dark px-3 py-1" id="gtgtMaHD">HD000</span></div>
                </div>
                <div class="small mb-3">
                    <div class="d-flex justify-content-between py-1"><span class="text-muted">Ngày lập:</span><strong id="gtgtNgay">-</strong></div>
                    <div class="d-flex justify-content-between py-1"><span class="text-muted">Mã Đặt phòng:</span><strong id="gtgtMaDP">-</strong></div>
                    <div class="d-flex justify-content-between py-1"><span class="text-muted">Mã Khách hàng:</span><strong id="gtgtMaKH">-</strong></div>
                </div>
                <table class="table table-sm table-bordered small mb-3">
                    <thead class="table-light">
                        <tr><th>Hạng mục doanh thu</th><th class="text-end">Thành tiền</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Tiền phòng lưu trú</td><td class="text-end" id="gtgtPhong">0 ₫</td></tr>
                        <tr><td>Tiền dịch vụ & Minibar</td><td class="text-end" id="gtgtDV">0 ₫</td></tr>
                        <tr><td>Tiền nhà hàng</td><td class="text-end" id="gtgtNH">0 ₫</td></tr>
                        <tr class="text-danger"><td>Giảm giá / Chiết khấu</td><td class="text-end" id="gtgtGiam">-0 ₫</td></tr>
                        <tr><td>Thuế GTGT (VAT)</td><td class="text-end" id="gtgtVAT">+0 ₫</td></tr>
                        <tr class="text-primary"><td>Tiền cọc đã khấu trừ</td><td class="text-end" id="gtgtCoc">-0 ₫</td></tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3">
                    <span class="fw-bold text-dark">TỔNG THANH TOÁN:</span>
                    <span class="fs-5 fw-bold text-success" id="gtgtTong">0 ₫</span>
                </div>
                <div class="text-end small text-muted mt-2">Trạng thái: <strong id="gtgtTT">-</strong></div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-dark rounded-3 px-4 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In / Xuất PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // @@ts-nocheck
        var tongTienChiaGoc = 0;

        function formatVND(val) {
            return parseFloat(val || '0').toLocaleString('vi-VN') + ' ₫';
        }

        function moModalGhiNo(maHD) {
            document.getElementById('inpGhiNoMaHD').value = maHD;
            document.getElementById('lblGhiNoMaHD').innerText = maHD;
            new window['bootstrap'].Modal(document.getElementById('modalGhiNo')).show();
        }

        // --- Xử lý Chia Hóa Đơn ---
        function moModalChiaHoaDon(maHD, tongTien) {
            tongTienChiaGoc = parseFloat(tongTien || '0');
            document.getElementById('inpChiaMaHD').value = maHD;
            document.getElementById('lblChiaMaHD').innerText = maHD;
            document.getElementById('lblChiaTongGoc').innerText = tongTienChiaGoc.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('inpSoPhanChia').value = '2';
            capNhatXemTruocChia();
            new window['bootstrap'].Modal(document.getElementById('modalChiaHoaDon')).show();
        }

        function datSoPhanChia(soPhan) {
            document.getElementById('inpSoPhanChia').value = soPhan;
            capNhatXemTruocChia();
        }

        function capNhatXemTruocChia() {
            var n = parseInt(document.getElementById('inpSoPhanChia').value || '2', 10);
            if (isNaN(n) || n < 2) n = 2;
            var moiPhan = Math.round(tongTienChiaGoc / n);
            document.getElementById('lblDuKienMoiPhan').innerText = moiPhan.toLocaleString('vi-VN') + ' ₫ / hóa đơn';
        }

        // --- Xử lý Ghép nhiều Hóa Đơn ---
        function chonTatCaHoaDonGhep(masterChk) {
            document.querySelectorAll('.chk-item-ghep').forEach(function(chk) {
                chk.checked = masterChk.checked;
            });
            capNhatThongKeGhep();
        }

        function capNhatThongKeGhep() {
            var items = document.querySelectorAll('.chk-item-ghep:checked');
            var tong = 0;
            items.forEach(function(chk) {
                tong += parseFloat(chk.getAttribute('data-amount') || '0');
            });
            document.getElementById('lblDemHoaDonGhep').innerText = 'Đã chọn: ' + items.length + ' hóa đơn';
            document.getElementById('lblTongTienGhep').innerText = tong.toLocaleString('vi-VN') + ' ₫';
        }

        function kiemTraTruocKhiGhep() {
            var count = document.querySelectorAll('.chk-item-ghep:checked').length;
            if (count < 2) {
                alert('Vui lòng tích chọn ít nhất 2 hóa đơn chưa thanh toán để ghép!');
                return false;
            }
            return confirm('Xác nhận ghép ' + count + ' hóa đơn đã chọn thành 1 hóa đơn duy nhất?');
        }

        // --- Xử lý Modal In Hóa Đơn GTGT ---
        function moModalInGTGT(btn) {
            document.getElementById('gtgtMaHD').innerText = btn.getAttribute('data-mahd');
            document.getElementById('gtgtMaDP').innerText = btn.getAttribute('data-madp');
            document.getElementById('gtgtMaKH').innerText = btn.getAttribute('data-makh');
            document.getElementById('gtgtNgay').innerText = btn.getAttribute('data-ngay');
            document.getElementById('gtgtPhong').innerText = formatVND(btn.getAttribute('data-phong'));
            document.getElementById('gtgtDV').innerText = formatVND(btn.getAttribute('data-dv'));
            document.getElementById('gtgtNH').innerText = formatVND(btn.getAttribute('data-nh'));
            document.getElementById('gtgtGiam').innerText = '-' + formatVND(btn.getAttribute('data-giam'));
            document.getElementById('gtgtVAT').innerText = '+' + formatVND(btn.getAttribute('data-vat'));
            document.getElementById('gtgtCoc').innerText = '-' + formatVND(btn.getAttribute('data-coc'));
            document.getElementById('gtgtTong').innerText = formatVND(btn.getAttribute('data-tong'));
            document.getElementById('gtgtTT').innerText = btn.getAttribute('data-tt');
            new window['bootstrap'].Modal(document.getElementById('modalInGTGT')).show();
        }
    </script>
}
@page "{id}"
@model HotelManager.Pages.QuanLySoDoPhong.ChiTietPhongModel
@{
    ViewData["Title"] = "Chi tiết phòng " + Model.PhongChiTiet.SoPhong;
    
    // Tự động sinh chuỗi ReturnUrl trỏ về chính trang hiện tại kèm theo ID phòng
    string urlHienTai = $"/QuanLySoDoPhong/ChiTietPhong/{Model.PhongChiTiet.MaPhong}";
}

<div class="container py-5">
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="shadow-sm rounded-4 overflow-hidden border">
                <!-- Giả định ảnh phòng được lưu trong thư mục wwwroot/images -->
                <img src="@(string.IsNullOrEmpty(Model.PhongChiTiet.HinhAnh) ? "/images/default-room.jpg" : Model.PhongChiTiet.HinhAnh)" class="card-img-top room-img" alt="Phòng @Model.PhongChiTiet.SoPhong">
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-white p-4 rounded-4 shadow-sm border h-100 d-flex flex-column">
                <h2 class="fw-bold text-dark mb-2">Phòng @Model.PhongChiTiet.SoPhong</h2>
                <h5 class="text-muted mb-4">Hạng phòng: @Model.PhongChiTiet.LoaiPhong</h5>

                <div class="mb-4 pb-3 border-bottom">
                    <h3 class="text-danger fw-bold mb-0">@string.Format("{0:0,0} VNĐ", Model.PhongChiTiet.GiaTheoNgay) <small class="text-muted fs-6 fw-normal">/ Đêm</small></h3>
                </div>

                <div class="mb-4">
                    <ul class="list-group list-group-flush text-muted">
                        <li class="list-group-item px-0 bg-transparent">
                            <i class="bi bi-bed me-2 text-primary"></i> <strong>Số giường:</strong> @Model.PhongChiTiet.SoGiuong
                        </li>
                        <li class="list-group-item px-0 bg-transparent">
                            <i class="bi bi-people me-2 text-primary"></i> <strong>Sức chứa:</strong> @Model.PhongChiTiet.SucChuaToiDa khách
                        </li>
                    </ul>
                </div>

                <div class="mb-4 flex-grow-1">
                    <h6 class="fw-bold text-dark mb-2">Mô tả:</h6>
                    <p class="text-muted" style="text-align: justify; line-height: 1.7;">
                        @(string.IsNullOrEmpty(Model.PhongChiTiet.MoTa) ? "Đang cập nhật thông tin mô tả." : Model.PhongChiTiet.MoTa)
                    </p>
                </div>

                <div class="mt-auto pt-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Khách ĐÃ ĐĂNG NHẬP: Chuyển hướng sang form điền thông tin đặt phòng -->
                        <a asp-page="./DatPhong" asp-route-id="@Model.PhongChiTiet.MaPhong" class="btn btn-warning btn-lg w-100 text-white fw-bold shadow-sm rounded-pill">
                            TIẾN HÀNH ĐẶT PHÒNG
                        </a>
                    }
                    else
                    {
                        <!-- Khách CHƯA ĐĂNG NHẬP: Chuyển hướng sang Auth/DangNhap và mang theo ReturnUrl -->
                        <a asp-page="/Auth/DangNhap" asp-route-ReturnUrl="@urlHienTai" class="btn btn-outline-primary btn-lg w-100 fw-bold shadow-sm rounded-pill">
                            <i class="bi bi-person-lock me-2"></i> ĐĂNG NHẬP ĐỂ ĐẶT PHÒNG
                        </a>
                        <p class="text-center mt-2 small text-muted mb-0">Vui lòng đăng nhập để hệ thống điền tự động thông tin của bạn.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
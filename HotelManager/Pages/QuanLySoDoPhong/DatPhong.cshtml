@page "{id}"
@model HotelManager.Pages.QuanLySoDoPhong.DatPhongModel
@{
    ViewData["Title"] = "Xác nhận đặt phòng trực tuyến";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container py-5">
    <div class="row justify-content-center mb-4">
        <div class="col-md-8 text-center">
            <h2 class="text-primary fw-bold text-uppercase">HOÀN TẤT THÔNG TIN ĐẶT PHÒNG</h2>
            <p class="text-muted">Vui lòng kiểm tra lại thông tin phòng và điền đầy đủ chi tiết lưu trú của bạn.</p>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold"></div>

    <div class="row justify-content-center">
        <!-- CỘT TRÁI: TÓM TẮT THÔNG TIN PHÒNG KHÁCH CHỌN -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                <img src="@(string.IsNullOrEmpty(Model.PhongDuocChon.HinhAnh) ? "/images/default-room.jpg" : Model.PhongDuocChon.HinhAnh)" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Phòng">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Phòng @Model.PhongDuocChon.SoPhong</h4>
                    <p class="text-muted mb-2"><i class="fa-solid fa-layer-group me-2"></i><strong>Loại:</strong> @Model.PhongDuocChon.LoaiPhong</p>
                    <p class="text-muted mb-2"><i class="fa-solid fa-bed me-2"></i><strong>Số giường:</strong> @Model.PhongDuocChon.SoGiuong</p>
                    <p class="text-muted mb-3"><i class="fa-solid fa-user-group me-2"></i><strong>Sức chứa tối đa:</strong> @Model.PhongDuocChon.SucChuaToiDa khách</p>
                    <hr />
                    <h5 class="text-danger fw-bold mb-0">
                        @string.Format("{0:0,0} VNĐ", Model.PhongDuocChon.GiaTheoNgay) <small class="text-muted fs-6 fw-normal">/ Đêm</small>
                    </h5>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐIỀN THÔNG TIN LƯU TRÚ CỦA KHÁCH -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ThongTinDatPhong.SoLuongKhach" class="form-label fw-bold">Số lượng khách</label>
                                <input asp-for="ThongTinDatPhong.SoLuongKhach" type="number" class="form-control" min="1" max="@Model.PhongDuocChon.SucChuaToiDa" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SoNgayO" class="form-label fw-bold">Số ngày ở</label>
                                <input asp-for="SoNgayO" type="number" class="form-control" min="1" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ThongTinDatPhong.NgayNhan" class="form-label fw-bold">Ngày nhận phòng (Check-in)</label>
                                <input asp-for="ThongTinDatPhong.NgayNhan" type="datetime-local" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ThongTinDatPhong.NgayTra" class="form-label fw-bold">Ngày trả phòng (Check-out)</label>
                                <input asp-for="ThongTinDatPhong.NgayTra" type="datetime-local" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ThongTinDatPhong.TienCoc" class="form-label fw-bold">Tiền cọc tạm tính (VNĐ)</label>
                            <input asp-for="ThongTinDatPhong.TienCoc" type="number" step="1000" class="form-control" value="0" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="ThongTinDatPhong.GhiChu" class="form-label fw-bold">Yêu cầu đặc biệt</label>
                            <textarea asp-for="ThongTinDatPhong.GhiChu" class="form-control" rows="3" placeholder="Ví dụ: Giờ check-in dự kiến, dị ứng thực phẩm, tầng cao..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success fw-bold flex-fill py-2">
                                <i class="fa-solid fa-check me-2"></i> GỬI YÊU CẦU ĐẶT PHÒNG
                            </button>
                            <a asp-page="./TimPhong" class="btn btn-outline-secondary fw-bold px-4 py-2">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@page "{id?}"
@model HotelManager.Pages.QuanLySoDoPhong.DatPhongModel
@{
    ViewData["Title"] = "Đặt Phòng Chi Tiết (UC_03)";
}

<div class="container py-5">
    <div class="row g-5">
        
        <!-- =============================================================== -->
        <!-- CỘT TRÁI (5/12): HIỂN THỊ THÔNG TIN PHÒNG ĐƯỢC CHỌN (GIỮ NGUYÊN) -->
        <!-- =============================================================== -->
        <div class="col-lg-5">
            <div class="sticky-top" style="top: 90px; z-index: 10;">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm mb-4">
                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-3 py-2 fw-bold fs-6 rounded-pill shadow-sm">
                        @Model.PhongDuocChon.LoaiPhong
                    </span>
                    <img src="@(string.IsNullOrEmpty(Model.PhongDuocChon.HinhAnh) ? "/images/default-room.jpg" : Model.PhongDuocChon.HinhAnh)" 
                         class="img-fluid w-100" alt="Phòng @Model.PhongDuocChon.SoPhong" 
                         style="height: 300px; object-fit: cover;" 
                         onerror="this.src='/images/default-room.jpg'" />
                </div>

                <h2 class="fw-bold text-dark mb-1">Phòng @Model.PhongDuocChon.SoPhong</h2>
                <h4 class="text-danger fw-bold mb-4">
                    @string.Format("{0:0,0} VNĐ", Model.PhongDuocChon.GiaTheoNgay) 
                    <small class="text-muted fs-6 fw-normal">/ Đêm</small>
                </h4>

                <div class="row g-3 mb-4 py-3 border-top border-bottom text-secondary small">
                    <div class="col-6">
                        <i class="bi bi-lamp-fill text-primary me-2"></i><strong>Giường:</strong> @Model.PhongDuocChon.SoGiuong
                    </div>
                    <div class="col-6">
                        <i class="bi bi-people-fill text-primary me-2"></i><strong>Sức chứa:</strong> @Model.PhongDuocChon.SucChuaToiDa
                    </div>
                    <div class="col-6">
                        <i class="bi bi-arrows-fullscreen text-primary me-2"></i><strong>Diện tích:</strong> @(Model.PhongDuocChon.DienTich > 0 ? $"{Model.PhongDuocChon.DienTich} m²" : "m²")
                    </div>
                    <div class="col-6">
                        <i class="bi bi-wifi text-primary me-2"></i><strong>Tiện ích:</strong> Free Wifi
                    </div>
                </div>

                <div>
                    <h6 class="fw-bold text-dark mb-2">Mô tả chi tiết:</h6>
                    <p class="text-muted small leading-relaxed">
                        @(string.IsNullOrEmpty(Model.PhongDuocChon.MoTa) 
                            ? "Khách sạn Grand Horizon tự hào mang đến không gian nghỉ dưỡng sang trọng, tiện nghi." 
                            : Model.PhongDuocChon.MoTa)
                    </p>
                </div>
            </div>
        </div>

        <!-- =============================================================== -->
        <!-- CỘT PHẢI (7/12): FORM THÔNG TIN ĐẶT PHÒNG & NÚT XÁC NHẬN         -->
        <!-- =============================================================== -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="fw-bold text-primary text-uppercase mb-1">THÔNG TIN ĐẶT PHÒNG</h3>
                <p class="text-muted small mb-4">Vui lòng điền chi tiết lưu trú của bạn.</p>

                <!-- Hiển thị tổng hợp lỗi hệ thống / lỗi kiểm tra dữ liệu -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold small rounded-3 shadow-sm"></div>

                <!-- CẢNH BÁO NẾU HỒ SƠ CỦA KHÁCH ĐANG ĐĂNG NHẬP BỊ THIẾU THÔNG TIN (VD: THIẾU CCCD) -->
                @if (User.Identity != null && User.Identity.IsAuthenticated && Model.ThieuThongTinHoSo)
                {
                    <div class="alert alert-warning border-warning d-flex align-items-start rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3 mt-1"></i>
                        <div class="small">
                            <div class="fw-bold text-dark mb-1">Yêu cầu cập nhật thông tin hồ sơ!</div>
                            <div class="text-secondary mb-2">
                                Hồ sơ cá nhân của bạn hiện còn thiếu: <strong class="text-danger">@(string.IsNullOrEmpty(Model.DanhSachTruongThieu) ? "Thông tin bắt buộc" : Model.DanhSachTruongThieu)</strong>. 
                                Vui lòng điền bổ sung đầy đủ vào các ô bên dưới (hệ thống sẽ tự động cập nhật vào hồ sơ của bạn) hoặc cập nhật tại trang Hồ sơ trước khi đặt phòng.
                            </div>
                            <a asp-page="/QuanLyHoSo/HoSoKhachHang" class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3">
                                <i class="bi bi-person-Gear me-1"></i> Cập nhật tại trang Hồ sơ cá nhân
                            </a>
                        </div>
                    </div>
                }

                <form method="post" id="formDatPhong">
                    <!-- PHẦN 1: THÔNG TIN LIÊN HỆ (ĐÃ BỔ SUNG SỐ CCCD) -->
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-person-vcard-fill text-warning me-2"></i>1. Thông tin liên hệ
                    </h5>

                    <div class="row g-3 mb-2">
                        <!-- Họ và tên -->
                        <div class="col-md-6">
                            <label asp-for="HoTenKhach" class="form-label small fw-bold text-secondary">
                                Họ và tên <span class="text-danger">*</span>
                            </label>
                            <input asp-for="HoTenKhach" id="txtHoTenKhach" class="form-control py-2" placeholder="Nhập họ và tên" />
                            <span asp-validation-for="HoTenKhach" class="text-danger small fw-semibold"></span>
                        </div>

                        <!-- Số CCCD / CMND (Bổ sung mới) -->
                        <div class="col-md-6">
                            <label asp-for="SoCCCDKhach" class="form-label small fw-bold text-secondary">
                                Số CCCD / CMND <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SoCCCDKhach" id="txtCCCDKhach" class="form-control py-2" maxlength="12" placeholder="Nhập 9 hoặc 12 chữ số CCCD" />
                            <span asp-validation-for="SoCCCDKhach" class="text-danger small fw-semibold"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6">
                            <label asp-for="SDTKhach" class="form-label small fw-bold text-secondary">
                                Số điện thoại <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SDTKhach" id="txtSDTKhach" class="form-control py-2" maxlength="10" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="SDTKhach" class="text-danger small fw-semibold"></span>
                        </div>

                        <!-- Địa chỉ Email -->
                        <div class="col-md-6">
                            <label asp-for="EmailKhach" class="form-label small fw-bold text-secondary">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EmailKhach" id="txtEmailKhach" type="email" class="form-control py-2" placeholder="Nhập địa chỉ email" />
                            <span asp-validation-for="EmailKhach" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="mb-4 mt-2">
                        <small class="text-success fw-semibold">
                            <i class="bi bi-shield-check me-1"></i>Dữ liệu này sẽ được đồng bộ và lưu vào hồ sơ để thuận tiện cho các lần đặt phòng sau.
                        </small>
                    </div>

                    <!-- PHẦN 2: THỜI GIAN LƯU TRÚ (GIỮ NGUYÊN) -->
                    <h5 class="fw-bold text-dark mb-3 pt-3 border-top">
                        <i class="bi bi-calendar-check-fill text-warning me-2"></i>2. Thời gian lưu trú
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ThongTinDatPhong.NgayNhan" class="form-label small fw-bold text-secondary">
                                Ngày nhận (Check-in) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ThongTinDatPhong.NgayNhan" type="datetime-local" class="form-control py-2" 
                                   onclick="if(this.showPicker) this.showPicker();" />
                            <span asp-validation-for="ThongTinDatPhong.NgayNhan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ThongTinDatPhong.NgayTra" class="form-label small fw-bold text-secondary">
                                Ngày trả (Check-out) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ThongTinDatPhong.NgayTra" type="datetime-local" class="form-control py-2" 
                                   onclick="if(this.showPicker) this.showPicker();" />
                            <span asp-validation-for="ThongTinDatPhong.NgayTra" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ThongTinDatPhong.SoLuongKhach" class="form-label small fw-bold text-secondary">
                                Số lượng khách <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ThongTinDatPhong.SoLuongKhach" type="number" min="1" max="@Model.PhongDuocChon.SucChuaToiDa" class="form-control py-2" />
                            <span asp-validation-for="ThongTinDatPhong.SoLuongKhach" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ThongTinDatPhong.TienCoc" class="form-label small fw-bold text-secondary">
                                Tiền cọc tạm tính (VNĐ)
                            </label>
                            <input asp-for="ThongTinDatPhong.TienCoc" type="number" class="form-control py-2 bg-light text-danger fw-bold" readonly />
                            <small class="text-muted" style="font-size: 0.75rem;">Bộ phận Lễ tân sẽ xác nhận lại khoản cọc này.</small>
                        </div>
                    </div>

                    <!-- PHẦN 3: YÊU CẦU ĐẶC BIỆT (GIỮ NGUYÊN) -->
                    <div class="mb-4">
                        <label asp-for="ThongTinDatPhong.GhiChu" class="form-label small fw-bold text-secondary">
                            <i class="bi bi-chat-left-text me-1"></i>Ghi chú / Yêu cầu đặc biệt (Nếu có)
                        </label>
                        <textarea asp-for="ThongTinDatPhong.GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Phòng tầng cao, không hút thuốc, chuẩn bị nôi trẻ em..."></textarea>
                    </div>

                    <!-- NÚT SUBMIT ĐẶT PHÒNG (GIỮ NGUYÊN CẤU TRÚC) -->
                    <div class="d-flex gap-3 pt-2">
                        <a asp-page="./TimPhong" class="btn btn-light fw-bold px-4 py-3 rounded-pill border">
                            <i class="bi bi-search me-1"></i> Tìm phòng khác
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Khách đã đăng nhập -> Cho phép Xác nhận đặt phòng -->
                            <button type="submit" class="btn btn-warning text-white fw-bold flex-fill py-3 rounded-pill shadow-sm fs-5">
                                XÁC NHẬN ĐẶT PHÒNG <i class="bi bi-arrow-right-circle ms-2"></i>
                            </button>
                        }
                        else
                        {
                            string returnUrl = $"/QuanLySoDoPhong/DatPhong/{Model.PhongDuocChon.MaPhong}?ngayNhan={Model.ThongTinDatPhong.NgayNhan?.ToString("yyyy-MM-dd")}&ngayTra={Model.ThongTinDatPhong.NgayTra?.ToString("yyyy-MM-dd")}&soKhach={Model.ThongTinDatPhong.SoLuongKhach}";

                            <!-- Khách vãng lai -> Chuyển hướng sang Đăng nhập kèm ReturnUrl -->
                            <a asp-page="/Auth/DangNhap" asp-route-ReturnUrl="@returnUrl" class="btn btn-primary text-white fw-bold flex-fill py-3 rounded-pill shadow-sm fs-5">
                                ĐĂNG NHẬP ĐỂ ĐẶT PHÒNG <i class="bi bi-person-lock ms-2"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Làm nổi bật viền vàng các ô thông tin cá nhân đang bị trống khi khách đã đăng nhập để nhắc khách cập nhật
        document.addEventListener("DOMContentLoaded", function () {
            const fields = ["txtHoTenKhach", "txtCCCDKhach", "txtSDTKhach", "txtEmailKhach"];
            fields.forEach(function (id) {
                const el = document.getElementById(id);
                if (el && el.value.trim() === "") {
                    el.classList.add("border-warning", "bg-warning-subtle");
                    el.addEventListener("input", function () {
                        if (this.value.trim() !== "") {
                            this.classList.remove("border-warning", "bg-warning-subtle");
                        }
                    });
                }
            });
        });
    </script>
}
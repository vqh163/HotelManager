@page
@model HotelManager.Pages.QuanLySoDoPhong.SoDoPhongModel
@{
    ViewData["Title"] = "Sơ đồ Phòng";
}

<div class="container-fluid py-3">
    <h3 class="fw-bold text-primary mb-4"><i class="bi bi-grid-3x3-gap-fill me-2"></i>SƠ ĐỒ PHÒNG TỔNG QUAN</h3>

    <!-- THANH CÔNG CỤ: LỌC THEO THỜI GIAN THỰC -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 p-3 bg-white rounded shadow-sm border border-primary border-opacity-25">
        <form method="get" id="timeFilterForm" class="d-flex align-items-center gap-2 mb-0">
            <!-- Dùng type="datetime-local" để chọn cả ngày lẫn giờ. Sẽ hiển thị trống (thời gian thực) nếu chưa tra cứu -->
            <input type="datetime-local" asp-for="ThoiGianLoc" class="form-control" style="max-width: 250px;" onchange="document.getElementById('timeFilterForm').submit();" />
            <a asp-page="./SoDoPhong" class="btn btn-outline-secondary text-nowrap">
                <i class="bi bi-arrow-counterclockwise"></i> Về hiện tại
            </a>
        </form>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    }

    @{
        var groupedRooms = Model.DanhSachLieuPhong.GroupBy(x => x.Tang).OrderBy(g => g.Key);
    }

    @foreach (var group in groupedRooms)
    {
        <h5 class="fw-bold text-secondary mt-4 mb-3">Tầng @group.Key</h5>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var room in group)
            {
                // LOGIC MÀU NỀN CỦA LỄ TÂN
                string bgClass = "bg-success";
                string ttPhong = room.TrangThaiPhong?.Trim().ToLower() ?? "";

                if (ttPhong == "đang ở") bgClass = "bg-danger";
                else if (ttPhong == "đã đặt") bgClass = "bg-warning text-dark";
                else if (ttPhong == "bảo trì") bgClass = "bg-secondary";
                else if (ttPhong == "dnd") bgClass = "bg-dark";

                <div class="col">
                    <div class="card text-white @bgClass shadow-sm h-100 position-relative" style="cursor: pointer; transition: 0.2s;"
                         onclick="showRoomDetails('@room.MaPhong', '@room.SoPhong', '@room.LoaiPhong', '@room.SoGiuong', '@room.SucChuaToiDa', '@room.TrangThaiPhong', '@room.TrangThaiVeSinh', '@(room.TenKhachHang)', '@(room.SDTKhachHang)', '@(room.GhiChuKhachHang)', '@(room.NgayNhan?.ToString("dd/MM/yyyy HH:mm"))', '@(room.NgayTra?.ToString("dd/MM/yyyy HH:mm"))')">

                        @if (User.IsInRole("Buồng phòng") || User.IsInRole("Quản lý"))
                        {
                            <div class="dropdown position-absolute top-0 end-0 m-1" onclick="event.stopPropagation();">
                                <button class="btn btn-sm text-white border-0" type="button" data-bs-toggle="dropdown" style="background: rgba(0,0,0,0.15);">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu shadow">
                                    <li><h6 class="dropdown-header text-success fw-bold">Nghiệp vụ Buồng phòng</h6></li>
                                    <li>
                                        <!-- Form để buồng phòng xác nhận đã dọn dẹp xong -->
                                        <form method="post" asp-page-handler="DoiTrangThai">
                                            <input type="hidden" name="maPhong" value="@room.MaPhong" />
                                            <input type="hidden" name="loaiCapNhat" value="BuongPhong" />
                                            <input type="hidden" name="trangThaiMoi" value="Sạch" />
                                            <button type="submit" class="dropdown-item fw-bold text-success">
                                                <i class="bi bi-stars"></i> Đánh dấu phòng Sạch
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }

                        <div class="card-body mt-2">
                            <h5 class="card-title fw-bold fs-4">@room.SoPhong</h5>
                            <p class="card-text mb-1 small">Hạng: <strong>@room.LoaiPhong</strong></p>
                            <p class="card-text mb-1 small text-truncate">Khách: @(room.TenKhachHang ?? "Chưa có")</p>
                        </div>

                        <!-- THANH FOOTER: Đổi sang justify-content-end và xóa biến TrangThaiPhong -->
                        <div class="card-footer bg-white text-dark d-flex justify-content-end align-items-center rounded-bottom m-1">
                            <i class="bi @room.IconVeSinh @room.MauIconVeSinh fs-5" title="Tình trạng: @room.TrangThaiVeSinh"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL CHI TIẾT PHÒNG -->
<div class="modal fade" id="roomDetailModal" tabindex="-1" aria-labelledby="rdTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                <h5 class="modal-title fw-bold text-primary fs-5" id="rdTitle">Chi tiết Phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 text-dark">
                <div class="row mb-4">
                    <div class="col-6">
                        <span class="text-muted small d-block mb-1">Loại phòng</span>
                        <strong id="rdLoaiPhong" class="fs-6"></strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small d-block mb-1">Sức chứa</span>
                        <strong class="fs-6"><span id="rdSucChua"></span> người</strong>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <span class="text-muted small d-block mb-1">Số giường</span>
                        <strong id="rdSoGiuong" class="fs-6"></strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small d-block mb-1">Vệ sinh</span>
                        <strong id="rdVeSinh" class="fs-6"></strong>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <span class="text-muted small d-block mb-1">Trạng thái phòng</span>
                        <strong id="rdTrangThai" class="fs-6 text-uppercase"></strong>
                    </div>
                </div>

                <div id="rdCustomerInfo" style="display: none;">
                    <hr class="text-muted my-3" />
                    <div class="row mb-2">
                        <div class="col-12">
                            <span class="text-muted small d-block mb-1">Khách hàng đang lưu trú/đặt:</span>
                            <strong id="rdKhachHang" class="fs-6 text-danger d-block"></strong>
                            <!-- BỔ SUNG SỐ ĐIỆN THOẠI -->
                            <span class="text-dark small"><i class="bi bi-telephone-fill me-1"></i> <span id="rdSDTKhach"></span></span>
                        </div>
                    </div>

                    <!-- BỔ SUNG: Hiển thị thời gian lưu trú -->
                    <div class="row mb-2" id="rdTimeSection">
                        <div class="col-12">
                            <span class="text-muted small d-block mb-1">Thời gian lưu trú:</span>
                            <span class="fw-bold" style="font-size: 0.9rem;"><i class="bi bi-clock-history me-1"></i> Từ <span id="rdNgayNhan" class="text-primary"></span> đến <span id="rdNgayTra" class="text-primary"></span></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <span class="text-muted small d-block mb-1">Ghi chú:</span>
                            <span id="rdGhiChu"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-white border-top-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>

                @if (User.IsInRole("Lễ tân") || User.IsInRole("Quản lý") || User.IsInRole("Sales"))
                {
                    <a href="#" id="btnDatPhong" class="btn btn-primary fw-bold px-4" style="display: none;" target="_blank">
                        <i class="bi bi-calendar-plus me-1"></i> Đặt phòng
                    </a>

                    <!-- BỔ SUNG: Form Check-in ẩn -->
                    <form method="post" asp-page-handler="CheckIn" id="formCheckIn" style="display: none; margin: 0;">
                        <input type="hidden" name="maPhongCheckIn" id="maPhongCheckIn" value="" />
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Check-in
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Kiểm tra xem người dùng có đang dùng bộ lọc thời gian hay không
            const filterInput = document.getElementById('searchTimeInput') || document.querySelector('input[type="datetime-local"]');

            // CHỈ tự động làm mới trang nếu Lễ tân đang xem "Thời gian thực" (không nhập ngày tra cứu)
            if (!filterInput || !filterInput.value) {
                setTimeout(function () {
                    window.location.reload();
                }, 30000); // 30000 ms = 30 giây
            }
        });
        // Bổ sung tham số ngayNhan, ngayTra
        // Bổ sung tham số sdtKhach vào vị trí số 9
        function showRoomDetails(maPhong, soPhong, loaiPhong, soGiuong, sucChua, trangThai, veSinh, khachHang, sdtKhach, ghiChu, ngayNhan, ngayTra) {
            document.getElementById('rdTitle').innerText = 'Chi tiết Phòng ' + soPhong;
            document.getElementById('rdLoaiPhong').innerText = loaiPhong || 'Chưa cập nhật';
            document.getElementById('rdSoGiuong').innerText = soGiuong || '0';
            document.getElementById('rdSucChua').innerText = sucChua || '0';
            document.getElementById('rdTrangThai').innerText = trangThai || 'Không xác định';
            document.getElementById('rdVeSinh').innerText = veSinh || 'Sạch';

            const customerDiv = document.getElementById('rdCustomerInfo');
            if (khachHang && khachHang.trim() !== '') {
                document.getElementById('rdKhachHang').innerText = khachHang;

                // Gán dữ liệu SĐT và các thông tin khác
                document.getElementById('rdSDTKhach').innerText = sdtKhach || 'Chưa cung cấp';
                document.getElementById('rdGhiChu').innerText = ghiChu || 'Không có ghi chú';

                // (Nếu bạn đã thêm ID rdNgayNhan, rdNgayTra từ code trước thì gán ở đây)
                const elNgayNhan = document.getElementById('rdNgayNhan');
                const elNgayTra = document.getElementById('rdNgayTra');
                if(elNgayNhan) elNgayNhan.innerText = ngayNhan || '...';
                if(elNgayTra) elNgayTra.innerText = ngayTra || '...';

                customerDiv.style.display = 'block';
            } else {
                customerDiv.style.display = 'none';
            }

            // ... (Phần logic check nút Check-in và Đặt phòng giữ nguyên như cũ) ...

            const btnDatPhong = document.getElementById('btnDatPhong');
            const formCheckIn = document.getElementById('formCheckIn');
            const hiddenMaPhong = document.getElementById('maPhongCheckIn');

            // Reset hiển thị nút
            if (btnDatPhong) btnDatPhong.style.display = 'none';
            if (formCheckIn) formCheckIn.style.display = 'none';

            let ttStr = (trangThai || '').trim().toLowerCase();
            if (ttStr === 'trống') {
                if (btnDatPhong) {
                    btnDatPhong.style.display = 'inline-block';
                    btnDatPhong.href = '/QuanLySoDoPhong/DatPhong/' + encodeURIComponent(maPhong);
                }
            } else if (ttStr === 'đã đặt') {
                if (formCheckIn && hiddenMaPhong) {
                    hiddenMaPhong.value = maPhong;
                    formCheckIn.style.display = 'inline-block';
                }
            }

            const modal = new bootstrap.Modal(document.getElementById('roomDetailModal'));
            modal.show();
        }
    </script>
}
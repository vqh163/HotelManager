@page "{id}"
@model HotelManager.Pages.QuanLySoDoPhong.SuaPhongModel
@{
    ViewData["Title"] = "Cập nhật Thông tin Phòng";
}

<div class="container mt-5">
    <div class="card shadow border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="fw-bold mb-0 text-center">CẬP NHẬT THÔNG TIN PHÒNG</h4>
        </div>
        <div class="card-body p-4">
            
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <!-- Bắt buộc lưu lại MaPhong và HinhAnh hiện tại để gửi kèm khi Submit -->
                <input type="hidden" asp-for="InputPhong.MaPhong" />
                <input type="hidden" asp-for="InputPhong.HinhAnh" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mã Phòng</label>
                        <!-- Mã phòng không được phép sửa -->
                        <input class="form-control bg-light" value="@Model.InputPhong.MaPhong" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InputPhong.SoPhong" class="form-label fw-bold">Số Phòng <span class="text-danger">*</span></label>
                        <input asp-for="InputPhong.SoPhong" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="InputPhong.LoaiPhong" class="form-label fw-bold">Hạng Phòng <span class="text-danger">*</span></label>
                        <select asp-for="InputPhong.LoaiPhong" class="form-select">
                            <option value="Standard">Standard</option>
                            <option value="Superior">Superior</option>
                            <option value="Deluxe">Deluxe</option>
                            <option value="Suite">Suite</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Giá Theo Ngày <span class="text-danger">*</span></label>
                        <!-- Hiển thị giá hiện tại đã được format sẵn thông qua C# -->
                        <input type="text" id="displayPrice" class="form-control" 
                               value="@(Model.InputPhong.GiaTheoNgay?.ToString("N0") + " VND")" />
                        
                        <!-- Lưu trữ con số thực để binding về Model -->
                        <input type="hidden" id="actualPrice" asp-for="InputPhong.GiaTheoNgay" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-2 text-center">
                        <label class="form-label fw-bold w-100 text-start">Ảnh hiện tại</label>
                        <img src="@(string.IsNullOrEmpty(Model.InputPhong.HinhAnh) ? "/images/default-room.jpg" : Model.InputPhong.HinhAnh)" 
                             class="img-thumbnail mt-1" style="width: 100%; height: 80px; object-fit: cover;" alt="Current Image"
                             onerror="this.src='/images/default-room.jpg'"/>
                    </div>
                    <div class="col-md-10">
                        <label class="form-label fw-bold">Thay đổi hình ảnh (Tùy chọn)</label>
                        <input type="file" asp-for="HinhAnhUpload" class="form-control mt-1" accept="image/*" />
                        <small class="text-muted">Bỏ trống nếu muốn giữ nguyên hình ảnh hiện tại.</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="InputPhong.SoGiuong" class="form-label fw-bold">Số Giường</label>
                        <input asp-for="InputPhong.SoGiuong" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InputPhong.SucChuaToiDa" class="form-label fw-bold">Sức Chứa Tối Đa</label>
                        <input asp-for="InputPhong.SucChuaToiDa" type="number" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="InputPhong.MoTa" class="form-label fw-bold">Mô Tả Tiện Ích</label>
                    <textarea asp-for="InputPhong.MoTa" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <!-- SỬA LỖI: Đổi asp-page thành /QuanLySoDoPhong/QuanLyDSPhong -->
                    <a asp-page="/QuanLySoDoPhong/QuanLyDSPhong" class="btn btn-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5">LƯU THAY ĐỔI</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const displayInput = document.getElementById('displayPrice');
            const hiddenInput = document.getElementById('actualPrice');

            displayInput.addEventListener('input', function () {
                // Giữ lại định dạng tiền tệ khi người dùng chỉnh sửa giá
                let rawValue = this.value.replace(/[^0-9]/g, '');

                if (rawValue) {
                    hiddenInput.value = rawValue;
                    this.value = new Intl.NumberFormat('vi-VN').format(rawValue) + ' VND';
                } else {
                    hiddenInput.value = '';
                    this.value = '';
                }
            });
        });
    </script>
}
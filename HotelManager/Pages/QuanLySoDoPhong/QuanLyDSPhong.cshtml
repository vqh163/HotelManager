@page
@model HotelManager.Pages.QuanLySoDoPhong.QuanLyPhongModel
@{
    ViewData["Title"] = "Quản lý danh sách phòng";
}

<div class="container-fluid py-4">
    <!-- Tiêu đề và nút hành động -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-door-open-fill me-2"></i>QUẢN LÝ DANH SÁCH PHÒNG</h2>
            <p class="text-muted mb-0">Hệ thống quản lý thông tin và trạng thái phòng khách sạn</p>
        </div>
        <!-- Dùng Tag Helper asp-page điều hướng đến trang ThemPhong -->
        <a asp-page="/QuanLySoDoPhong/ThemPhong" class="btn btn-primary shadow-sm fw-bold px-4 py-2">
            <i class="bi bi-plus-lg me-1"></i> Thêm Phòng Mới
        </a>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-3">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <!-- Bộ lọc và tìm kiếm -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input asp-for="TuKhoaTimKiem" class="form-control border-start-0 fs-6" placeholder="Tìm theo số phòng, hạng phòng..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-bold py-2">TÌM KIẾM</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng dữ liệu chính -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase" style="font-size: 0.85rem;">Thông tin Phòng</th>
                            <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.85rem;">Hạng</th>
                            <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.85rem;">Sức chứa</th>
                            <th class="py-3 text-secondary text-uppercase text-end" style="font-size: 0.85rem;">Giá / Ngày (VND)</th>
                            <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.85rem;">Trạng thái</th>
                            <th class="pe-4 py-3 text-secondary text-uppercase text-center" style="font-size: 0.85rem;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.DanhSachPhong.Any())
                        {
                            foreach (var phong in Model.DanhSachPhong)
                            {
                                <tr>
                                    <!-- Cột thông tin phòng kèm hình ảnh thu nhỏ -->
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(phong.HinhAnh) ? "/images/default-room.jpg" : phong.HinhAnh)" 
                                                 class="rounded-3 me-3 shadow-sm" style="width: 70px; height: 50px; object-fit: cover;" alt="Room"
                                                 onerror="this.src='/images/default-room.jpg'" />
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">Phòng @phong.SoPhong</h6>
                                                <small class="text-muted">Mã: @phong.MaPhong</small>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3 py-2 fw-semibold">@phong.LoaiPhong</span>
                                    </td>
                                    
                                    <td class="text-center text-muted fw-medium">
                                        <i class="bi bi-person-fill"></i> @phong.SucChuaToiDa
                                    </td>
                                    
                                    <td class="text-end fw-bold text-success fs-5">
                                        @(phong.GiaTheoNgay?.ToString("N0") ?? "0")
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (phong.TRANG_THAI_PHONGMaTrangThai == "LOCKED")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill"><i class="bi bi-lock-fill me-1"></i> Đã khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Hoạt động</span>
                                        }
                                    </td>
                                    
                                    <td class="pe-4 text-center">
                                        <div class="btn-group shadow-sm rounded-3">
                                            <!-- Nút Sửa -->
                                            <a asp-page="/QuanLySoDoPhong/SuaPhong" asp-route-id="@phong.MaPhong" class="btn btn-outline-primary py-2" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <!-- Nút Khóa -->
                                            <form method="post" asp-page-handler="Khoa" asp-route-id="@phong.MaPhong" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn khóa phòng này?');">
                                                <button type="submit" class="btn btn-outline-warning py-2" title="Khóa phòng"><i class="bi bi-lock-fill"></i></button>
                                            </form>
                                            <!-- Nút Xóa -->
                                            <form method="post" asp-page-handler="Xoa" asp-route-id="@phong.MaPhong" class="d-inline" onsubmit="return confirm('Cảnh báo: Hành động này sẽ xóa phòng vĩnh viễn khỏi CSDL. Tiếp tục?');">
                                                <button type="submit" class="btn btn-outline-danger py-2" title="Xóa phòng"><i class="bi bi-trash-fill"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox text-secondary" style="font-size: 3rem;"></i>
                                    <p class="mt-3 fs-5">Chưa có dữ liệu phòng nào trong hệ thống.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
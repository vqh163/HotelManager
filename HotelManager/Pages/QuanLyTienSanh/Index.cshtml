@page
@model HotelManager.Pages.QuanLyTienSanh.IndexModel
@{
    ViewData["Title"] = "Quản Lý Tiền Sảnh - Dashboard";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-display me-2"></i>TỔNG QUAN TIỀN SẢNH</h3>
            <p class="text-muted mb-0">Hệ thống xử lý nghiệp vụ Lễ tân - Check-in / Check-out</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/QuanLySoDoPhong/SoDoPhong" class="btn btn-outline-primary fw-bold shadow-sm">
                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Xem Sơ đồ phòng
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-warning shadow-sm rounded-3">@Model.AlertMessage</div>
    }

    <!-- Khung Dashboard tạm thời cho Lễ tân -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-primary text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>Khách đến hôm nay (Arrivals)</h5>
                    <h2 class="display-4 fw-bold mt-3">0</h2>
                    <p class="mb-0 opacity-75">Đang chờ làm thủ tục Check-in</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-warning text-dark">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-right me-2"></i>Khách đi hôm nay (Departures)</h5>
                    <h2 class="display-4 fw-bold mt-3">0</h2>
                    <p class="mb-0 opacity-75">Đang chờ làm thủ tục Check-out</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-success text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-house-door-fill me-2"></i>Phòng đang lưu trú</h5>
                    <h2 class="display-4 fw-bold mt-3">0</h2>
                    <p class="mb-0 opacity-75">Tổng số phòng có khách</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 pb-3 border-bottom-0">
                    <h5 class="fw-bold text-secondary mb-0">Thao tác nhanh</h5>
                </div>
                <div class="card-body p-4 text-center text-muted">
                    <p>Các tính năng Quét giấy tờ tùy thân, Tạo thẻ từ, và Đổi phòng sẽ được tích hợp tại đây.</p>
                </div>
            </div>
        </div>
    </div>
</div>
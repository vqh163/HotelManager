@page
@model HotelManager.Pages.QuanLyTienSanh.IndexModel
@{
    ViewData["Title"] = "Quản Lý Tiền Sảnh - Dashboard";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- TIÊU ĐỀ & ĐỒNG HỒ THỜI GIAN THỰC -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-display me-2"></i>TỔNG QUAN TIỀN SẢNH</h3>
            <p class="text-muted mb-0">Hệ thống xử lý nghiệp vụ Lễ tân - Đồng bộ Check-in / Check-out thời gian thực</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <!-- Khung hiển thị Ngày/Tháng/Năm và Giờ/Phút/Giây thực tế -->
            <div class="bg-white border border-primary border-opacity-25 px-4 py-2 rounded-3 shadow-sm text-end">
                <div class="fw-bold text-secondary text-capitalize" id="realtime-date" style="font-size: 0.85rem;">--/--/----</div>
                <div class="text-primary fw-bold font-monospace" id="realtime-clock" style="font-size: 1.25rem;">--:--:--</div>
            </div>

            <a asp-page="/QuanLySoDoPhong/SoDoPhong" class="btn btn-outline-primary fw-bold shadow-sm h-100 d-flex align-items-center py-2">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i> Xem Sơ đồ phòng
            </a>
        </div>
    </div>

    <!-- Khối hiển thị cảnh báo lỗi nếu có Exception -->
    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-warning shadow-sm rounded-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.AlertMessage
        </div>
    }

    <!-- KHUNG DASHBOARD THỐNG KÊ TỰ ĐỘNG THEO NGÀY HIỆN TẠI -->
    <div class="row g-4">
        <!-- 1. KHÁCH ĐẾN HÔM NAY (ARRIVALS) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-primary text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>Khách đến hôm nay</h5>
                    <h2 class="display-4 fw-bold mt-3">@Model.SoKhachDaCheckIn</h2>
                    
                    <div class="d-flex justify-content-between mt-3 pt-2 border-top border-light border-opacity-25">
                        <span class="small" title="Bao gồm khách đặt trước chưa nhận phòng và khách ở cùng chưa trình diện CCCD">
                            Chờ Check-in (Còn thiếu): <strong>@Model.SoKhachDangChoCheckIn</strong>
                        </span>
                        <span class="small">
                            Đã Check-in: <strong>@Model.SoKhachDaCheckIn</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 2. KHÁCH ĐI HÔM NAY (DEPARTURES) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-warning text-dark">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-right me-2"></i>Khách đi hôm nay</h5>
                    <h2 class="display-4 fw-bold mt-3">@Model.SoKhachDaCheckOut</h2>
                    
                    <div class="d-flex justify-content-between mt-3 pt-2 border-top border-dark border-opacity-25">
                        <span class="small">Chờ Check-out trong ngày: <strong>@Model.SoKhachDangChoCheckOut</strong></span>
                        <span class="small">Đã Check-out: <strong>@Model.SoKhachDaCheckOut</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. PHÒNG ĐANG LƯU TRÚ (OCCUPANCY - CLICK ĐỂ XEM DANH SÁCH CHI TIẾT BÊN DƯỚI) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-success text-white position-relative"
                 id="cardOccupiedRooms"
                 style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                 onclick="toggleOccupiedRoomsTable()"
                 onmouseover="this.style.transform='translateY(-3px)';"
                 onmouseout="this.style.transform='translateY(0)';"
                 title="Nhấn vào đây để xem danh sách chi tiết các phòng đang có khách lưu trú">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold mb-0"><i class="bi bi-house-door-fill me-2"></i>Phòng đang lưu trú</h5>
                        <span class="badge bg-white text-success fw-bold small shadow-sm">
                            <i class="bi bi-chevron-down me-1" id="iconToggleOccupied"></i>Chi tiết
                        </span>
                    </div>

                    <h2 class="display-4 fw-bold mt-3">@Model.TongPhongDangLuuTru</h2>
                    
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light border-opacity-25">
                        <span class="small"><i class="bi bi-hand-index-thumb me-1"></i>Tổng số phòng đang có khách (Nhấn để xem)</span>
                        @if (Model.SoPhongChuaDuKhach > 0)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-person-fill-exclamation me-1"></i>@Model.SoPhongChuaDuKhach phòng chưa đủ CCCD
                            </span>
                        }
                        else if (Model.TongPhongDangLuuTru > 0)
                        {
                            <span class="badge bg-light text-success">
                                <i class="bi bi-check-circle-fill me-1"></i>Đã đủ giấy tờ
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- KHU VỰC HIỂN THỊ DANH SÁCH CHI TIẾT CÁC PHÒNG ĐANG LƯU TRÚ (KHI CLICK Ô XANH LÁ) -->
    <!-- ========================================================================= -->
    <div class="row mt-4" id="occupiedRoomsSection" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 border-top border-success border-4">
                <div class="card-header bg-white pt-4 pb-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold text-success mb-1">
                            <i class="bi bi-list-ul me-2"></i>DANH SÁCH CHI TIẾT PHÒNG ĐANG CÓ KHÁCH LƯU TRÚ (@Model.TongPhongDangLuuTru PHÒNG)
                        </h5>
                        <p class="text-muted small mb-0">Thông tin thời gian thực về số lượng khách, người đại diện, ví tiền cọc và thời gian nhận phòng</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleOccupiedRoomsTable()">
                        <i class="bi bi-x-lg me-1"></i>Thu gọn danh sách
                    </button>
                </div>

                <div class="card-body px-4 pb-4 pt-2">
                    @if (Model.DanhSachPhongDangLuuTru != null && Model.DanhSachPhongDangLuuTru.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle mb-0">
                                <thead class="table-success text-dark small text-uppercase">
                                    <tr>
                                        <th class="text-center" style="width: 60px;">STT</th>
                                        <th>Mã phòng</th>
                                        <th>Số phòng</th>
                                        <th>Hạng phòng</th>
                                        <th class="text-center">Lượng khách đang lưu trú</th>
                                        <th>Khách đại diện của phòng</th>
                                        <th class="text-end">Ví cọc</th>
                                        <th class="text-center">Thời gian Check-in dự kiến</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.DanhSachPhongDangLuuTru.Count; i++)
                                    {
                                        var item = Model.DanhSachPhongDangLuuTru[i];
                                        <tr>
                                            <td class="text-center fw-bold text-secondary">@(i + 1)</td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.MaPhong</span>
                                            </td>
                                            <td>
                                                <strong class="fs-5 text-primary">Phòng @item.SoPhong</strong>
                                            </td>
                                            <td>
                                                <span class="fw-semibold text-dark">@item.HangPhong</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-bold fs-6">@item.SoKhachDangLuuTru / @item.TongSoKhachDangKy</span> <span class="text-muted small">khách</span>
                                                @if (!item.DaDuCCCD)
                                                {
                                                    <div class="mt-1">
                                                        <span class="badge bg-warning text-dark" style="font-size: 0.72rem;">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Thiếu @(item.TongSoKhachDangKy - item.SoKhachDangLuuTru) CCCD
                                                        </span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mt-1">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size: 0.72rem;">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Đủ thông tin
                                                        </span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-danger">@item.TenKhachDaiDien</div>
                                                <div class="small text-muted">
                                                    <i class="bi bi-telephone-fill me-1"></i>@item.SDTKhachDaiDien
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold text-success fs-6">@item.ViCoc.ToString("N0") đ</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="fw-semibold text-primary">
                                                    <i class="bi bi-calendar-check me-1"></i>@(item.ThoiGianCheckInDuKien.HasValue ? item.ThoiGianCheckInDuKien.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa cập nhật")
                                                </div>
                                                @if (item.ThoiGianTraDuKien.HasValue)
                                                {
                                                    <div class="small text-muted">
                                                        Dự kiến trả: @item.ThoiGianTraDuKien.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-center">
    <!-- Sử dụng Tag Helper asp-route-openRoom để truyền Mã phòng sang trang Sơ đồ phòng -->
    <a asp-page="/QuanLySoDoPhong/SoDoPhong"
       asp-route-openRoom="@item.MaPhong"
       class="btn btn-sm btn-outline-primary fw-semibold">
        <i class="bi bi-box-arrow-up-right me-1"></i>Mở trên Sơ đồ
    </a>
</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            <span>Hiện tại không có phòng nào đang có khách lưu trú.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- KHU VỰC THAO TÁC NHANH -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 pb-3 border-bottom-0">
                    <h5 class="fw-bold text-secondary mb-0">Thao tác nhanh</h5>
                </div>
                <div class="card-body p-4 text-center text-muted">
                    <p class="mb-0">Các tính năng Quét giấy tờ tùy thân (CCCD/Hộ chiếu), Tạo thẻ từ, và Đổi phòng đã được liên kết trực tiếp trên từng ô phòng tại <strong>Sơ đồ phòng</strong>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị đồng hồ thời gian thực chạy từng giây
        function updateClock() {
            const now = new Date();
            const dateOptions = { weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit' };
            const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit' };
            
            const elDate = document.getElementById('realtime-date');
            const elClock = document.getElementById('realtime-clock');
            if (elDate) elDate.innerText = now.toLocaleDateString('vi-VN', dateOptions);
            if (elClock) elClock.innerText = now.toLocaleTimeString('vi-VN', timeOptions);
        }

        updateClock();
        setInterval(updateClock, 1000);

        // Hàm Ẩn/Hiện danh sách chi tiết phòng đang lưu trú khi Lễ tân click vào ô màu xanh lá
        // Đồng thời lưu trạng thái vào sessionStorage để khi trang tự động reload 30s không bị đóng bảng
        function toggleOccupiedRoomsTable() {
            const section = document.getElementById('occupiedRoomsSection');
            const icon = document.getElementById('iconToggleOccupied');
            if (!section) return;

            const isHidden = (section.style.display === 'none' || section.style.display === '');
            if (isHidden) {
                section.style.display = 'block';
                if (icon) icon.className = 'bi bi-chevron-up me-1';
                sessionStorage.setItem('showOccupiedRoomsList', 'true');
                section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                section.style.display = 'none';
                if (icon) icon.className = 'bi bi-chevron-down me-1';
                sessionStorage.setItem('showOccupiedRoomsList', 'false');
            }
        }

        // Khôi phục trạng thái mở bảng nếu trước đó Lễ tân đã click mở
        document.addEventListener("DOMContentLoaded", function () {
            if (sessionStorage.getItem('showOccupiedRoomsList') === 'true') {
                const section = document.getElementById('occupiedRoomsSection');
                const icon = document.getElementById('iconToggleOccupied');
                if (section) section.style.display = 'block';
                if (icon) icon.className = 'bi bi-chevron-up me-1';
            }
        });

        // Cơ chế Auto-Refresh (Polling) sau mỗi 30 giây để tự động đồng bộ số liệu với Sơ đồ phòng (UC_03)
        setTimeout(function () {
            window.location.reload();
        }, 30000); 
    </script>
}
@page
@model HotelManager.Pages.QuanLyTienSanh.IndexModel
@{
    ViewData["Title"] = "Quản Lý Tiền Sảnh - Dashboard";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- TIÊU ĐỀ & ĐỒNG HỒ THỜI GIAN THỰC -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-display me-2"></i>TỔNG QUAN TIỀN SẢNH</h3>
            <p class="text-muted mb-0">Hệ thống xử lý nghiệp vụ Lễ tân - Đồng bộ Check-in / Check-out thời gian thực</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <!-- Khung hiển thị Ngày/Tháng/Năm và Giờ/Phút/Giây thực tế -->
            <div class="bg-white border border-primary border-opacity-25 px-4 py-2 rounded-3 shadow-sm text-end">
                <div class="fw-bold text-secondary text-capitalize" id="realtime-date" style="font-size: 0.85rem;">--/--/----</div>
                <div class="text-primary fw-bold font-monospace" id="realtime-clock" style="font-size: 1.25rem;">--:--:--</div>
            </div>

            <a asp-page="/QuanLySoDoPhong/SoDoPhong" class="btn btn-outline-primary fw-bold shadow-sm h-100 d-flex align-items-center py-2">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i> Xem Sơ đồ phòng
            </a>
        </div>
    </div>

    <!-- Khối hiển thị cảnh báo lỗi nếu có Exception -->
    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-warning shadow-sm rounded-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.AlertMessage
        </div>
    }

    <!-- KHUNG DASHBOARD THỐNG KÊ TỰ ĐỘNG THEO NGÀY HIỆN TẠI -->
    <div class="row g-4">
        <!-- 1. KHÁCH ĐẾN HÔM NAY (ARRIVALS) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-primary text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>Khách đến hôm nay</h5>
                    <!-- Con số lớn chỉ tăng khi Lễ tân hoàn tất bấm Check-in từng khách -->
                    <h2 class="display-4 fw-bold mt-3">@Model.SoKhachDaCheckIn</h2>

                    <div class="d-flex justify-content-between mt-3 pt-2 border-top border-light border-opacity-25">
                        <span class="small" title="Bao gồm khách đặt trước chưa nhận phòng và khách ở cùng chưa trình diện CCCD">
                            Chờ Check-in (Còn thiếu): <strong>@Model.SoKhachDangChoCheckIn</strong>
                        </span>
                        <span class="small">
                            Đã Check-in: <strong>@Model.SoKhachDaCheckIn</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. KHÁCH ĐI HÔM NAY (DEPARTURES) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-warning text-dark">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-box-arrow-right me-2"></i>Khách đi hôm nay</h5>
                    <!-- Con số lớn chỉ tăng khi Lễ tân hoàn tất bấm Check-out -->
                    <h2 class="display-4 fw-bold mt-3">@Model.SoKhachDaCheckOut</h2>

                    <div class="d-flex justify-content-between mt-3 pt-2 border-top border-dark border-opacity-25">
                        <span class="small">Chờ Check-out trong ngày: <strong>@Model.SoKhachDangChoCheckOut</strong></span>
                        <span class="small">Đã Check-out: <strong>@Model.SoKhachDaCheckOut</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. PHÒNG ĐANG LƯU TRÚ (OCCUPANCY) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-success text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold"><i class="bi bi-house-door-fill me-2"></i>Phòng đang lưu trú</h5>
                    <h2 class="display-4 fw-bold mt-3">@Model.TongPhongDangLuuTru</h2>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light border-opacity-25">
                        <span class="small">Tổng số phòng đang có khách</span>
                        @if (Model.SoPhongChuaDuKhach > 0)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-person-fill-exclamation me-1"></i>@Model.SoPhongChuaDuKhach phòng chưa đủ CCCD
                            </span>
                        }
                        else if (Model.TongPhongDangLuuTru > 0)
                        {
                            <span class="badge bg-light text-success">
                                <i class="bi bi-check-circle-fill me-1"></i>Đã đủ giấy tờ
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHU VỰC THAO TÁC NHANH -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 pb-3 border-bottom-0">
                    <h5 class="fw-bold text-secondary mb-0">Thao tác nhanh</h5>
                </div>
                <div class="card-body p-4 text-center text-muted">
                    <p class="mb-0">Các tính năng Quét giấy tờ tùy thân (CCCD/Hộ chiếu), Tạo thẻ từ, và Đổi phòng đã được liên kết trực tiếp trên từng ô phòng tại <strong>Sơ đồ phòng</strong>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị đồng hồ thời gian thực chạy từng giây
        function updateClock() {
            const now = new Date();
            const dateOptions = { weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit' };
            const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit' };

            const elDate = document.getElementById('realtime-date');
            const elClock = document.getElementById('realtime-clock');
            if (elDate) elDate.innerText = now.toLocaleDateString('vi-VN', dateOptions);
            if (elClock) elClock.innerText = now.toLocaleTimeString('vi-VN', timeOptions);
        }

        updateClock();
        setInterval(updateClock, 1000);

        // Cơ chế Auto-Refresh (Polling) sau mỗi 30 giây để tự động đồng bộ số liệu với Sơ đồ phòng (UC_03)
        setTimeout(function () {
            window.location.reload();
        }, 30000);
    </script>
}
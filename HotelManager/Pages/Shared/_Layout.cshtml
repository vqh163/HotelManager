<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelManager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">HotelManager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Menu chính nằm bên trái (Giữ nguyên của bạn) -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- BỔ SUNG: Menu Xác thực nằm bên phải -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        <!-- Kiểm tra trạng thái đăng nhập của Identity -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Trạng thái: ĐÃ ĐĂNG NHẬP -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> Xin chào, @User.Identity.Name!
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-page="/Auth/HoSo">Hồ sơ của tôi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <!-- Nút Đăng xuất phải dùng Form POST để đảm bảo bảo mật -->
                                        <form class="form-inline" asp-page="/Auth/DangXuat" method="post">
                                            <button type="submit" class="dropdown-item text-danger fw-bold">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Trạng thái: CHƯA ĐĂNG NHẬP -->
                            <li class="nav-item me-2">
                                <!-- Chuyển hướng sang trang Đăng nhập (UC_01) -->
                                <a class="btn btn-outline-primary rounded-pill px-4" asp-page="/Auth/DangNhap">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <!-- Chuyển hướng sang trang Đăng ký (UC_02) -->
                                <a class="btn btn-primary rounded-pill px-4 shadow-sm" asp-page="/Auth/DangKy">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HotelManager - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
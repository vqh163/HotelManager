<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Grand Horizon Hotel</title>
    <!-- Thư viện CSS Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelManager.styles.css" asp-append-version="true" />
    <style>
        /* Đảm bảo hiệu ứng cuộn mượt cho Landing Page */
        html { scroll-behavior: smooth; }
    </style>
</head>
<body>
    <!-- Mốc định vị đầu trang -->
    <div id="top-trang-chu"></div>

    <header>
        <!-- Thanh Navbar cố định (sticky-top) với z-index cao để không bị che khuất -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-0 sticky-top" style="z-index: 1030;">
            <div class="container">
                
                <!-- 1. LOGO KHÁCH SẠN: Trỏ về trang chủ Index -->
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <img src="~/images/logo.png" alt="Grand Horizon Logo" style="height: 50px; width: auto;" class="me-2">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- 2. MENU CHÍNH (Các liên kết nội bộ / cuộn mượt) -->
                    <ul class="navbar-nav gap-3 fw-semibold mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index" fragment="trang-2-phong-standard">Phòng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index" fragment="trang-7-am-thuc">Ẩm thực</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index" fragment="trang-8-lien-he">Liên hệ</a>
                        </li>
                    </ul>

                    <!-- 3. MENU XÁC THỰC (Phân quyền trạng thái đăng nhập) -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Trạng thái: ĐÃ ĐĂNG NHẬP (Hiển thị Dropdown cá nhân) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-warning me-1"></i> Xin chào, @User.Identity.Name!
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item py-2" asp-page="/QuanLyLichCaNhan/QuanLyLichCaNhan"><i class="bi bi-calendar-check me-2"></i>Lịch cá nhân (UC_10)</a></li>
                                    
                                    @if (User.IsInRole("Quản trị viên"))
                                    {
                                        <li><a class="dropdown-item py-2 text-primary" asp-page="/QuanTriHeThong/QuanLyTaiKhoan"><i class="bi bi-gear me-2"></i>Quản trị hệ thống (UC_13)</a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <!-- Nút Đăng xuất dùng Form POST bảo mật tuyệt đối -->
                                        <form class="form-inline m-0" asp-page="/Auth/DangXuat" method="post">
                                            <button type="submit" class="dropdown-item text-danger fw-bold py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Trạng thái: CHƯA ĐĂNG NHẬP -->
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary rounded-pill px-4 fw-bold" asp-page="/Auth/DangNhap">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" asp-page="/Auth/DangKy">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Khu vực hiển thị nội dung các trang con -->
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer chuẩn dự án -->
    <footer class="border-top footer text-muted bg-light py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Grand Horizon Hotel - <a asp-area="" asp-page="/Privacy" class="text-decoration-none">Chính sách bảo mật</a>
        </div>
    </footer>

    <!-- Khai báo các thư viện Script -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
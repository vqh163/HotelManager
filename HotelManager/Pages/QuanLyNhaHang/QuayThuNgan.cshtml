@page
@model HotelManagement.Pages.NhaHang.ThuNgan.QuayThuNganModel
@{
    ViewData["Title"] = "Quầy Thu Ngân";
    string currentFilter = string.IsNullOrEmpty(Model.TrangThaiLoc) ? "Tất cả" : Model.TrangThaiLoc;
}

<div class="container-fluid mt-4 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger fw-bold shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <!-- CỘT TRÁI: KHU VỰC HIỂN THỊ ĐỘNG -->
        <div class="col-lg-8">
            <!-- VIEW 1: DANH SÁCH HÓA ĐƠN -->
            <div id="viewDanhSach" class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4 flex-wrap gap-2">
                    <h3 class="fw-bold mb-0">Danh sách Hoá Đơn</h3>

                    <!-- BỘ LỌC TRẠNG THÁI HÓA ĐƠN TẠI QUẦY THU NGÂN -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="?TrangThaiLoc=Tất cả" class="btn btn-sm rounded-pill px-3 fw-bold @(currentFilter == "Tất cả" ? "btn-dark" : "btn-light border text-muted")">Tất cả</a>
                        <a href="?TrangThaiLoc=Chờ Thanh Toán" class="btn btn-sm rounded-pill px-3 fw-bold @(currentFilter == "Chờ Thanh Toán" ? "btn-danger" : "btn-light border text-danger")">Chờ Thanh Toán</a>
                        <a href="?TrangThaiLoc=Chưa thanh toán" class="btn btn-sm rounded-pill px-3 fw-bold @(currentFilter == "Chưa thanh toán" ? "btn-secondary" : "btn-light border text-dark")">Chưa thanh toán</a>
                        <a href="?TrangThaiLoc=Đã Thanh Toán" class="btn btn-sm rounded-pill px-3 fw-bold @(currentFilter == "Đã Thanh Toán" ? "btn-success" : "btn-light border text-success")">Đã Thanh Toán</a>
                    </div>
                </div>

                <div class="row text-center fw-bold text-muted mb-3 px-3">
                    <div class="col-2">STT</div>
                    <div class="col-4">MÃ HOÁ ĐƠN</div>
                    <div class="col-3">SỐ BÀN</div>
                    <div class="col-3">TRẠNG THÁI</div>
                </div>

                <div class="d-flex flex-column gap-3">
                    @if (Model.DanhSachHoaDon.Any())
                    {
                        foreach (var hd in Model.DanhSachHoaDon)
                        {
                            string bgClass = "bg-light";
                            string textClass = "text-dark";
                            string iconClass = "bi-receipt";
                            bool canSelectToMerge = hd.HinhThucThanhToan != "Đã Thanh Toán";

                            if (hd.HinhThucThanhToan == "Chờ Thanh Toán")
                            {
                                bgClass = "bg-danger bg-opacity-10 border-danger border-opacity-25";
                                textClass = "text-danger";
                            }
                            else if (hd.HinhThucThanhToan == "Đã Thanh Toán")
                            {
                                bgClass = "bg-success text-white border-success";
                                textClass = "text-white";
                                iconClass = "bi-check-circle";
                            }

                            <div class="row align-items-center py-3 px-3 rounded-pill border shadow-sm @bgClass"
                                 style="cursor: pointer; transition: transform 0.2s;"
                                 onmouseover="this.style.transform='translateY(-2px)'"
                                 onmouseout="this.style.transform='translateY(0)'"
                                 onclick="hienThiChiTiet('@hd.MaHoaDonNhaHang', '@hd.TenBan', '@hd.DanhSachMonJson', @hd.TamTinh, @hd.PhiPhucVu, @hd.ThueVAT, @hd.TongCong)">
                                <div class="col-2 text-center fw-bold @textClass d-flex justify-content-center align-items-center gap-2">
                                    <!-- Checkbox tích chọn nhiều hóa đơn chờ thanh toán để Gộp bill -->
                                    @if (canSelectToMerge)
                                    {
                                        <input type="checkbox" class="form-check-input bill-merge-checkbox m-0"
                                               value="@hd.MaHoaDonNhaHang"
                                               data-tenban="@hd.TenBan"
                                               data-tongcong="@hd.TongCong"
                                               onclick="event.stopPropagation(); updateMergeButtonState();"
                                               title="Tích chọn để gộp bill" />
                                    }
                                    <span>@hd.STT</span>
                                </div>
                                <div class="col-4 text-center fw-bold @textClass">@hd.MaHoaDonNhaHang</div>
                                <div class="col-3 text-center fw-bold @textClass">@hd.TenBan</div>
                                <div class="col-3 text-center fw-bold @textClass">
                                    <i class="bi @iconClass me-1"></i> @hd.HinhThucThanhToan
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">Chưa có hóa đơn nào cần xử lý.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- VIEW 2: CHI TIẾT HÓA ĐƠN -->
            <div id="viewChiTiet" class="card shadow-sm border-0 rounded-4 p-4 h-100" style="display: none;">
                <h3 class="fw-bold mb-3">Chi Tiết Hóa Đơn</h3>

                <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-4">
                    <span class="badge bg-info text-white rounded-pill px-3 py-2 fw-bold" id="lblSoBanCT">BÀN SỐ: --</span>
                    <span class="text-muted fw-bold">Mã HD: <span id="lblMaHDCT" class="text-dark">--</span></span>
                    <span class="text-muted">Giờ vào: @DateTime.Now.ToString("HH:mm")</span>
                </div>

                <div class="row fw-bold text-muted mb-3 border-bottom pb-2">
                    <div class="col-6">SẢN PHẨM / GHI CHÚ</div>
                    <div class="col-2 text-center">ĐƠN GIÁ</div>
                    <div class="col-2 text-center">SỐ LƯỢNG</div>
                    <div class="col-2 text-end">THÀNH TIỀN</div>
                </div>

                <div id="danhSachMonContainer" class="mb-3 border-bottom pb-3"></div>

                <div class="row mt-4">
                    <div class="col-6">
                        <label class="form-label fw-bold text-muted text-uppercase small">GHI CHÚ CHO KHÁCH HÀNG</label>
                        <textarea class="form-control bg-light border-0 shadow-sm" rows="3" placeholder="Nhập lời chúc hoặc lưu ý đặc biệt in trên hóa đơn..."></textarea>
                    </div>
                    <div class="col-6">
                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Tạm tính</span>
                            <span class="fw-bold text-dark" id="lblTamTinh">0 VND</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Phí phục vụ (5%)</span>
                            <span class="fw-bold text-dark" id="lblPhiPhucVu">0 VND</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-muted border-bottom pb-3">
                            <span>Thuế VAT (10%)</span>
                            <span class="fw-bold text-dark" id="lblVAT">0 VND</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark fs-5">Tổng cộng thanh toán</span>
                            <span class="fw-bold text-primary fs-4" id="lblTongCong">0 VND</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: THAO TÁC THU NGÂN -->
        <div class="col-lg-4">
            <form method="post">
                <input type="hidden" name="maHoaDonToPay" id="maHoaDonToPayInput" value="" />

                <div id="khuVucThaoTac" class="card shadow-sm border-0 rounded-4 p-4" style="transition: 0.3s;">
                    <h4 class="fw-bold mb-4">Thao Tác Thu Ngân</h4>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Mã giảm giá / Voucher</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-ticket-perforated text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 border-end-0" placeholder="VD: HOLIDAY2024">
                            <button class="btn text-primary fw-bold border-start-0 bg-white border" type="button">Áp dụng</button>
                        </div>
                    </div>

                    <button type="button" class="btn btn-info text-white fw-bold w-100 py-3 rounded-3 mb-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-door-closed me-2"></i> Ghi nợ vào phòng</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <button type="submit" id="btnThanhToanChot" asp-page-handler="ThanhToan" class="btn btn-success fw-bold w-100 py-3 rounded-3 mb-3 d-flex justify-content-between align-items-center" disabled>
                        <span><i class="bi bi-cash me-2"></i> THANH TOÁN & Chốt hóa đơn</span>
                        <i class="bi bi-check-circle-fill"></i>
                    </button>

                    <!-- YÊU CẦU: Nút "Gộp bill" nằm ngay bên cạnh 2 nút "Tạm tính" và "Quẹt thẻ" -->
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-light border flex-grow-1 text-muted fw-bold rounded-3 py-2">
                            <i class="bi bi-printer me-1"></i> Tạm tính
                        </button>
                        <button type="button" class="btn btn-light border flex-grow-1 text-muted fw-bold rounded-3 py-2">
                            <i class="bi bi-credit-card me-1"></i> Quẹt thẻ
                        </button>
                        <button type="button" id="btnGopBill" class="btn btn-warning text-white fw-bold flex-grow-1 rounded-3 py-2 shadow-sm" onclick="openGopBillModal()">
                            <i class="bi bi-intersect me-1"></i> Gộp bill
                        </button>
                    </div>

                    <button type="button" id="btnQuayLai" class="btn btn-secondary fw-bold w-100 py-2 rounded-3 mt-2" style="display: none;" onclick="quayLaiDanhSach()">
                        <i class="bi bi-arrow-return-left me-2"></i> Quay lại
                    </button>
                </div>
            </form>

            <div class="card shadow-sm border-0 rounded-4 p-3 mt-4 bg-light">
                <div class="d-flex gap-3">
                    <i class="bi bi-shield-check text-primary fs-4"></i>
                    <div>
                        <p class="fw-bold mb-1 small">An toàn & Bảo mật</p>
                        <p class="text-muted mb-0" style="font-size: 0.8rem;">Mọi giao dịch ghi nợ vào phòng yêu cầu chữ ký xác nhận của khách hàng trên máy tính bảng hoặc thẻ từ phòng.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL GỘP BILL LINH HOẠT DÀNH CHO THU NGÂN -->
<div class="modal fade" id="gopBillModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0" style="background-color: #f39c12; color: #fff;">
                <h5 class="modal-title fw-bold text-uppercase">
                    <i class="bi bi-intersect me-2"></i> Gộp Bill Thanh Toán Thống Nhất
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="GopBill" onsubmit="return confirmGopBillSubmit();">
                <div class="modal-body p-4 bg-light">
                    <p class="small text-muted fw-bold mb-3">
                        <i class="bi bi-info-circle me-1"></i> Tích chọn các hóa đơn chờ thanh toán bên dưới để gom chung thành một Bill thống nhất. Khi thanh toán hoàn tất, hệ thống sẽ tự động giải phóng đồng loạt toàn bộ các bàn liên quan về trạng thái <strong>Trống (màu xanh)</strong>:
                    </p>

                    <div class="d-flex flex-column gap-2">
                        @foreach (var hd in Model.DanhSachHoaDon.Where(x => x.HinhThucThanhToan != "Đã Thanh Toán"))
                        {
                            <label class="card p-3 border-0 shadow-sm rounded-3" style="cursor: pointer;">
                                <div class="form-check d-flex justify-content-between align-items-center m-0">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input modal-gopbill-cb" type="checkbox" name="maHoaDonGopList" value="@hd.MaHoaDonNhaHang" style="transform: scale(1.25);" />
                                        <div>
                                            <span class="fw-bold text-dark">Mã HD: @hd.MaHoaDonNhaHang</span>
                                            <span class="badge bg-info text-white ms-2">@hd.TenBan</span>
                                            <span class="badge bg-danger bg-opacity-10 text-danger ms-1">@hd.HinhThucThanhToan</span>
                                        </div>
                                    </div>
                                    <div class="fw-bold text-primary">@hd.TongCong.ToString("N0") VND</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white">
                    <button type="button" class="btn btn-light border px-4 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning text-white px-4 fw-bold">Xác nhận Gộp Bill</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatVND(amount) {
            return amount.toLocaleString('vi-VN') + ' VND';
        }

        function hienThiChiTiet(maHD, tenBan, dsMonJsonEncoded, tamTinh, phiPhucVu, vat, tongCong) {
            document.getElementById('viewDanhSach').style.display = 'none';
            document.getElementById('viewChiTiet').style.display = 'block';

            document.getElementById('lblMaHDCT').innerText = maHD;
            document.getElementById('lblSoBanCT').innerText = tenBan.toUpperCase();
            document.getElementById('maHoaDonToPayInput').value = maHD;
            document.getElementById('btnThanhToanChot').removeAttribute('disabled');

            const dsMon = JSON.parse(decodeURIComponent(dsMonJsonEncoded));
            const container = document.getElementById('danhSachMonContainer');
            container.innerHTML = '';

            dsMon.forEach(mon => {
                let ghiChuHtml = mon.GhiChu ? `<small class="text-muted"><i class="bi bi-info-circle"></i> ${mon.GhiChu}</small>` : '';
                container.innerHTML += `
                            <div class="row mb-3 align-items-center">
                                <div class="col-6">
                                    <div class="fw-bold text-dark">${mon.TenMon}</div>
                                    ${ghiChuHtml}
                                </div>
                                <div class="col-2 text-center text-muted fw-bold">${formatVND(mon.DonGia).replace(' VND', '')}</div>
                                <div class="col-2 text-center fw-bold">${mon.SoLuong}</div>
                                <div class="col-2 text-end fw-bold text-primary">${formatVND(mon.ThanhTien)}</div>
                            </div>
                        `;
            });

            document.getElementById('lblTamTinh').innerText = formatVND(tamTinh);
            document.getElementById('lblPhiPhucVu').innerText = formatVND(phiPhucVu);
            document.getElementById('lblVAT').innerText = formatVND(vat);
            document.getElementById('lblTongCong').innerText = formatVND(tongCong);

            document.getElementById('btnQuayLai').style.display = 'block';
        }

        function quayLaiDanhSach() {
            document.getElementById('viewChiTiet').style.display = 'none';
            document.getElementById('viewDanhSach').style.display = 'block';
            document.getElementById('maHoaDonToPayInput').value = '';
            document.getElementById('btnThanhToanChot').setAttribute('disabled', 'disabled');
            document.getElementById('btnQuayLai').style.display = 'none';
        }

        // Đồng bộ các checkbox tích chọn ngoài danh sách với Modal Gộp Bill
        function updateMergeButtonState() {
            const checkedOutside = document.querySelectorAll('.bill-merge-checkbox:checked');
            const btnGop = document.getElementById('btnGopBill');
            if (checkedOutside.length > 0) {
                btnGop.innerHTML = `<i class="bi bi-intersect me-1"></i> Gộp bill (${checkedOutside.length})`;
            } else {
                btnGop.innerHTML = `<i class="bi bi-intersect me-1"></i> Gộp bill`;
            }
        }

        function openGopBillModal() {
            const selectedIds = Array.from(document.querySelectorAll('.bill-merge-checkbox:checked')).map(cb => cb.value);
            document.querySelectorAll('.modal-gopbill-cb').forEach(cb => {
                cb.checked = selectedIds.includes(cb.value);
            });
            new bootstrap.Modal(document.getElementById('gopBillModal')).show();
        }

        function confirmGopBillSubmit() {
            const checkedCount = document.querySelectorAll('.modal-gopbill-cb:checked').length;
            if (checkedCount < 2) {
                alert('Vui lòng tích chọn ít nhất 2 hóa đơn để gom chung thành một bill!');
                return false;
            }
            return confirm(`Bạn có chắc chắn muốn gộp ${checkedCount} hóa đơn đã chọn thành 1 Bill thống nhất?`);
        }
    </script>
}
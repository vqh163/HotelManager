@page
@model HotelManagement.Pages.NhaHang.PhucVu.SoDoBanModel
@{
    ViewData["Title"] = "Sơ Đồ Bàn";
    string currentFilter = string.IsNullOrEmpty(Model.TrangThaiLoc) || Model.TrangThaiLoc == "Tất cả bàn" ? "Tất cả" : Model.TrangThaiLoc;
}

<style>
    .table-card {
        border-radius: 12px;
        transition: transform 0.2s;
        border: none;
        min-height: 150px;
    }

        .table-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .bg-trong {
        background-color: #d1e7dd;
    }

    .bg-co-khach {
        background-color: #f8d7da;
    }

    .bg-don-dep {
        background-color: #fff3cd;
    }

    .bg-dat-truoc {
        background-color: #cff4fc;
    }

    .btn-brand-yellow {
        background-color: #f39c12;
        color: #fff;
        font-weight: bold;
        border: none;
    }

        .btn-brand-yellow:hover {
            background-color: #e67e22;
            color: #fff;
        }
</style>

<div class="container-fluid mt-4 mb-5">

    <!-- HIỂN THỊ THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HIỂN THỊ THÔNG BÁO LỖI (Quan trọng để Debug) -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase mb-0">SƠ ĐỒ BÀN</h2>
    </div>

    <!-- Khu vực tìm kiếm và lọc -->
    <div class="row align-items-center mb-4 bg-light p-3 rounded-4 shadow-sm mx-0">
        <div class="col-lg-6 d-flex gap-4">
            <div class="d-flex align-items-center gap-2"><span class="d-inline-block rounded p-2 bg-trong"></span> <span class="small fw-bold text-muted">Trống</span></div>
            <div class="d-flex align-items-center gap-2"><span class="d-inline-block rounded p-2 bg-co-khach"></span> <span class="small fw-bold text-muted">Đang có khách</span></div>
            <div class="d-flex align-items-center gap-2"><span class="d-inline-block rounded p-2 bg-don-dep"></span> <span class="small fw-bold text-muted">Đang dọn dẹp</span></div>
            <div class="d-flex align-items-center gap-2"><span class="d-inline-block rounded p-2 bg-dat-truoc"></span> <span class="small fw-bold text-muted">Đã đặt trước</span></div>
        </div>

        <div class="col-lg-6 d-flex justify-content-end align-items-center gap-3">
            <form method="get" id="searchForm" class="m-0">
                <input type="hidden" name="TrangThaiLoc" value="@Model.TrangThaiLoc" />
                <div class="input-group bg-white rounded-pill border overflow-hidden shadow-sm" style="width: 200px;">
                    <span class="input-group-text bg-white border-0 pe-1"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="TuKhoaTimKiem" class="form-control border-0 shadow-none ps-1" placeholder="Nhập số bàn..." onkeypress="if(event.keyCode==13) document.getElementById('searchForm').submit();">
                </div>
            </form>

            <div class="dropdown">
                <button class="btn bg-white border rounded-pill px-3 shadow-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-funnel-fill text-muted"></i> @currentFilter
                </button>
                <ul class="dropdown-menu shadow-sm border-0 rounded-3">
                    <li><a class="dropdown-item" href="?TuKhoaTimKiem=@Model.TuKhoaTimKiem&TrangThaiLoc=Tất cả bàn">Tất cả</a></li>
                    <li><a class="dropdown-item" href="?TuKhoaTimKiem=@Model.TuKhoaTimKiem&TrangThaiLoc=Trống"><span class="d-inline-block rounded-circle me-2 bg-trong" style="width:12px;height:12px;"></span>Trống</a></li>
                    <li><a class="dropdown-item" href="?TuKhoaTimKiem=@Model.TuKhoaTimKiem&TrangThaiLoc=Đang có khách"><span class="d-inline-block rounded-circle me-2 bg-co-khach" style="width:12px;height:12px;"></span>Đang có khách</a></li>
                    <li><a class="dropdown-item" href="?TuKhoaTimKiem=@Model.TuKhoaTimKiem&TrangThaiLoc=Đang dọn dẹp"><span class="d-inline-block rounded-circle me-2 bg-don-dep" style="width:12px;height:12px;"></span>Đang dọn dẹp</a></li>
                    <li><a class="dropdown-item" href="?TuKhoaTimKiem=@Model.TuKhoaTimKiem&TrangThaiLoc=Đã đặt trước"><span class="d-inline-block rounded-circle me-2 bg-dat-truoc" style="width:12px;height:12px;"></span>Đã đặt trước</a></li>
                </ul>
            </div>

            <a asp-page="./ThemBan" class="btn btn-brand-yellow rounded-pill px-4 py-2 shadow-sm d-flex align-items-center">
                <i class="bi bi-plus-circle me-2"></i> Thêm bàn mới
            </a>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

    <div class="row g-4">
        @if (Model.DanhSachBan.Any())
        {
            @foreach (var ban in Model.DanhSachBan)
            {
                string bgClass = ban.TrangThai switch
                {
                    "Trống" => "bg-trong",
                    "Đang có khách" => "bg-co-khach",
                    "Đang dọn dẹp" => "bg-don-dep",
                    "Đã đặt trước" => "bg-dat-truoc",
                    _ => "bg-light"
                };

                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card table-card @bgClass shadow-sm p-3 d-flex flex-column justify-content-between">

                        <div class="d-flex justify-content-between align-items-start">
                            <h2 class="fw-bold text-dark mb-0" style="font-size: 1.8rem;">@ban.TenBan.Replace("Bàn ", "").Replace(" - Tầng trệt", "")</h2>
                            <div class="d-flex align-items-center fw-bold text-dark fs-5">
                                <i class="bi bi-people-fill me-2"></i> @ban.SucChua
                            </div>
                        </div>

                        <div class="mt-3 flex-grow-1">
                            @if (ban.TrangThai == "Đang có khách")
                            {
                                <p class="small fw-bold text-dark mb-1">Mã đơn: <span class="fw-normal">@ban.MaHoaDonNhaHang</span></p>
                            }
                            else if (ban.TrangThai == "Đang dọn dẹp")
                            {
                                <p class="small text-dark mb-1">Đang trong quá trình vệ sinh</p>
                            }
                            else if (ban.TrangThai == "Trống")
                            {
                                <p class="small text-dark mb-1">Sẵn sàng phục vụ</p>
                            }
                            else if (ban.TrangThai == "Đã đặt trước")
                            {
                                <p class="small fw-bold text-dark mb-1">Khách hàng: <span class="fw-normal">@ban.TenKhachDat</span></p>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-end mt-3">
                            <div class="action-link">
                                @if (ban.TrangThai == "Đang có khách")
                                {
                                    <!-- FORM YÊU CẦU THANH TOÁN KẾT NỐI VỚI BÀN -->
                                    <form method="post" asp-page-handler="YeuCauThanhToan" class="m-0">
                                        <input type="hidden" name="maBan" value="@ban.MaBan" />
                                        <input type="hidden" name="maHoaDon" value="@ban.MaHoaDonNhaHang" />
                                        <button type="submit" class="btn btn-link text-danger fw-bold text-decoration-none small p-0 m-0 border-0">
                                            Thanh toán <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </form>
                                }
                                else if (ban.TrangThai == "Đang dọn dẹp")
                                {
                                    <form method="post" asp-page-handler="XacNhanSach" asp-route-maBan="@ban.MaBan" class="m-0">
                                        <button type="submit" class="btn btn-link text-warning fw-bold text-decoration-none small p-0 m-0 border-0">
                                            Xác nhận sạch <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </form>
                                }
                                else if (ban.TrangThai == "Trống")
                                {
                                    <a asp-page="./GoiMon" asp-route-id="@ban.MaBan" class="text-success fw-bold text-decoration-none small">Gọi món <i class="bi bi-chevron-right"></i></a>
                                }
                                else if (ban.TrangThai == "Đã đặt trước")
                                {
                                    <a href="#" class="text-info fw-bold text-decoration-none small">Nhận bàn <i class="bi bi-chevron-right"></i></a>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-page="./SuaBan" asp-route-id="@ban.MaBan" class="btn bg-white rounded-circle shadow-sm text-muted p-0 d-flex justify-content-center align-items-center border" style="width: 32px; height: 32px;" title="Chỉnh sửa bàn">
                                    <i class="bi bi-pencil" style="font-size: 0.85rem;"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@ban.MaBan" class="m-0 p-0" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA bàn này?');">
                                    <button type="submit" class="btn bg-white rounded-circle shadow-sm text-danger p-0 d-flex justify-content-center align-items-center border" style="width: 32px; height: 32px;" title="Xóa bàn">
                                        <i class="bi bi-trash" style="font-size: 0.85rem;"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-inboxes fs-1"></i>
                <p class="mt-2">Không tìm thấy bàn nào phù hợp.</p>
            </div>
        }
    </div>
</div>
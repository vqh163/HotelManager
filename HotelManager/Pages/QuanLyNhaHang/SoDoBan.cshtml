@page
@model HotelManagement.Pages.NhaHang.PhucVu.SoDoBanModel
@{
    ViewData["Title"] = "Sơ Đồ Bàn";

    string btnFilterClass = "btn-outline-secondary text-dark";
    switch (Model.TrangThaiLoc)
    {
        case "Trống": btnFilterClass = "btn-success text-white"; break;
        case "Đang có khách": btnFilterClass = "btn-danger text-white"; break;
        case "Đang dọn dẹp": btnFilterClass = "btn-warning text-dark"; break;
        case "Đã đặt trước": btnFilterClass = "btn-info text-dark"; break;
        default: btnFilterClass = "btn-outline-secondary text-dark"; break;
    }
}

<style>
    /* Các dải màu hiển thị trạng thái bàn */
    .bg-trong {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
    }

    .bg-khach {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
    }

    .bg-dondep {
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
    }

    .bg-datruoc {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
    }

    .btn-brand-yellow {
        background-color: #f39c12;
        color: #fff;
        border: none;
        font-weight: bold;
    }

        .btn-brand-yellow:hover {
            background-color: #e67e22;
            color: #fff;
        }

    /* Layout thẻ bàn */
    .card-ban {
        border-radius: 12px;
        transition: all 0.2s ease-in-out;
        display: flex;
        flex-direction: column;
    }

        .card-ban:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

    .legend-box {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
    }
</style>

<div class="container-fluid mt-4">
    <h3 class="fw-bold mb-4 text-uppercase">Sơ Đồ Bàn</h3>

    <!-- Thanh công cụ: Chú thích, Tìm kiếm và Lọc -->
    <div class="row align-items-center mb-4 bg-light p-3 rounded shadow-sm">
        <div class="col-lg-5 col-md-12 mb-3 mb-lg-0">
            <div class="d-flex flex-wrap gap-3 fw-bold text-secondary small">
                <span><div class="legend-box bg-trong"></div> Trống</span>
                <span><div class="legend-box bg-khach"></div> Đang có khách</span>
                <span><div class="legend-box bg-dondep"></div> Đang dọn dẹp</span>
                <span><div class="legend-box bg-datruoc"></div> Đã đặt trước</span>
            </div>
        </div>

        <div class="col-lg-7 col-md-12 d-flex justify-content-lg-end justify-content-start gap-2 flex-wrap">
            <form method="get" class="d-flex gap-2 align-items-center">
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-white rounded-start-pill border-end-0"><i class="bi bi-search"></i></span>
                    <input asp-for="TuKhoaTimKiem" class="form-control rounded-end-pill border-start-0" placeholder="Nhập số bàn..." />
                </div>

                <div class="dropdown">
                    <button class="btn @btnFilterClass rounded-pill dropdown-toggle px-3" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-funnel-fill"></i> Lọc
                    </button>
                    <ul class="dropdown-menu shadow-sm" aria-labelledby="filterDropdown">
                        <li><button type="submit" name="TrangThaiLoc" value="Tất cả bàn" class="dropdown-item">Tất cả bàn</button></li>
                        <li><button type="submit" name="TrangThaiLoc" value="Trống" class="dropdown-item text-success fw-bold"><i class="bi bi-circle-fill me-2"></i> Trống</button></li>
                        <li><button type="submit" name="TrangThaiLoc" value="Đang có khách" class="dropdown-item text-danger fw-bold"><i class="bi bi-circle-fill me-2"></i> Đang có khách</button></li>
                        <li><button type="submit" name="TrangThaiLoc" value="Đang dọn dẹp" class="dropdown-item text-warning fw-bold"><i class="bi bi-circle-fill me-2"></i> Đang dọn dẹp</button></li>
                        <li><button type="submit" name="TrangThaiLoc" value="Đã đặt trước" class="dropdown-item text-info fw-bold"><i class="bi bi-circle-fill me-2"></i> Đã đặt trước</button></li>
                    </ul>
                </div>
            </form>

            <!-- Cập nhật xóa text dấu + dư thừa, chỉ giữ icon -->
            <a asp-page="./ThemBan" class="btn btn-brand-yellow rounded-pill shadow-sm px-3 text-nowrap">
                <i class="bi bi-plus-circle"></i> Thêm bàn mới
            </a>
        </div>
    </div>

    <!-- Lưới sơ đồ bàn -->
    <div class="row g-3">
        @if (Model.DanhSachBan.Any())
        {
            @foreach (var ban in Model.DanhSachBan)
            {
                string colorClass = ban.TrangThai switch
                {
                    "Trống" => "bg-trong text-success",
                    "Đang có khách" => "bg-khach text-danger",
                    "Đang dọn dẹp" => "bg-dondep text-warning",
                    "Đã đặt trước" => "bg-datruoc text-info",
                    _ => "bg-light"
                };

                <div class="col-md-3 col-sm-6">
                    <div class="card card-ban @colorClass h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="fw-bold mb-0 text-dark">@ban.TenBan</h4>
                                <div class="d-flex align-items-center gap-1 text-dark">
                                    <i class="bi bi-people-fill fs-6"></i>
                                    <span class="fw-bold small">@ban.SucChua</span>
                                </div>
                            </div>

                            <!-- Hiển thị Nội dung tùy thuộc vào trạng thái -->
                            <div class="mb-3 text-dark small lh-lg flex-grow-1">
                                @if (ban.TrangThai == "Trống")
                                {
                                    <div>Sẵn sàng phục vụ</div>
                                }
                                else if (ban.TrangThai == "Đang có khách")
                                {
                                    <div><strong>Mã đơn:</strong> @ban.MaHoaDonNhaHang</div>
                                }
                                else if (ban.TrangThai == "Đang dọn dẹp")
                                {
                                    <div>Đang trong quá trình vệ sinh</div>
                                }
                                else if (ban.TrangThai == "Đã đặt trước")
                                {
                                    <div><strong>Khách hàng:</strong> @ban.TenKhachDat</div>
                                }
                            </div>

                            <!-- Hiển thị Nút hành động tùy thuộc vào trạng thái -->
                            <div class="mt-auto">
                                @if (ban.TrangThai == "Trống")
                                {
                                    <a asp-page="./GoiMon" asp-route-id="@ban.MaBan" class="text-success fw-bold text-decoration-none">
                                        Gọi món <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                                else if (ban.TrangThai == "Đang có khách")
                                {
                                    <a asp-page="./ThanhToan" asp-route-id="@ban.MaHoaDonNhaHang" class="text-danger fw-bold text-decoration-none">
                                        Thanh toán <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                                else if (ban.TrangThai == "Đang dọn dẹp")
                                {
                                    <form method="post" asp-page-handler="XacNhanSach">
                                        <input type="hidden" name="maBan" value="@ban.MaBan" />
                                        <button type="submit" class="btn btn-link p-0 text-warning fw-bold text-decoration-none shadow-none">
                                            Xác nhận sạch <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </form>
                                }
                                else if (ban.TrangThai == "Đã đặt trước")
                                {
                                    <a asp-page="./NhanBan" asp-route-id="@ban.MaBan" class="text-info fw-bold text-decoration-none">
                                        Nhận bàn <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-inboxes fs-1"></i>
                <p class="mt-2">Không tìm thấy dữ liệu bàn với điều kiện đã lọc.</p>
            </div>
        }
    </div>
</div>
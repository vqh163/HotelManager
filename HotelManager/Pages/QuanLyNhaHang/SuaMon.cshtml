@page
@model HotelManagement.Pages.NhaHang.NhaBep.SuaMonModel
@{
    ViewData["Title"] = "Chỉnh Sửa Món Ăn";
}

<style>
    .bg-brand-yellow { background-color: #f39c12 !important; color: #fff !important; }
    #imagePreview { max-width: 100%; max-height: 250px; border-radius: 12px; margin-top: 10px; object-fit: cover; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                
                <div class="card-header bg-brand-yellow text-center py-3 border-0">
                    <h4 class="mb-0 fw-bold text-uppercase">Chỉnh Sửa Thông Tin Món</h4>
                </div>
                
                <div class="card-body p-4 bg-light">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3 fw-bold" style="display: @(ModelState.IsValid ? "none" : "block")"></div>

                    <form method="post" enctype="multipart/form-data">
                        <!-- Giữ lại thông tin ảnh cũ đề phòng người dùng không chọn ảnh mới -->
                        <input type="hidden" asp-for="MonInfo.HinhAnh" />
                        <input type="hidden" asp-for="MonInfo.MaDichVu" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Mã món (SKU)</label>
                                <!-- Khóa trường này, không cho phép đổi Mã món để tránh lỗi CSDL -->
                                <input class="form-control bg-e9ecef text-muted" value="@Model.MonInfo.MaDichVu" readonly />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MonInfo.TenDichVu" class="form-label fw-bold">Tên món ăn <span class="text-danger">*</span></label>
                                <input asp-for="MonInfo.TenDichVu" class="form-control" placeholder="VD: Nước Cam Ép..." required />
                                <span asp-validation-for="MonInfo.TenDichVu" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MonInfo.LoaiDichVu" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                                <select asp-for="MonInfo.LoaiDichVu" class="form-select">
                                    <option value="Khai vị">Khai vị</option>
                                    <option value="Món chính">Món chính</option>
                                    <option value="Tráng miệng">Tráng miệng</option>
                                    <option value="Đồ uống">Đồ uống</option>
                                </select>
                                <span asp-validation-for="MonInfo.LoaiDichVu" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                                <!-- Cập nhật giá tiền cũ lên giao diện -->
                                <input type="text" id="DonGiaDisplay" class="form-control" value="@Model.MonInfo.DonGia.ToString("N0") VND" oninput="formatCurrency(this)" required />
                                <input type="hidden" asp-for="MonInfo.DonGia" id="DonGiaActual" />
                                <span asp-validation-for="MonInfo.DonGia" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tải hình ảnh mới (Bỏ trống nếu muốn giữ ảnh cũ)</label>
                            <input type="file" asp-for="HinhAnhUpload" class="form-control" accept="image/*" id="imageInput" />
                            <div class="form-text">Khuyến nghị kích thước 600x400px, định dạng JPG/PNG.</div>
                            
                            <!-- Hiển thị ảnh cũ của món ăn từ CSDL -->
                            <img id="imagePreview" src="@(!string.IsNullOrEmpty(Model.MonInfo.HinhAnh) ? Model.MonInfo.HinhAnh : "https://via.placeholder.com/600x400?text=No+Image")" alt="Xem trước món ăn" style="display: block;" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="MonInfo.MoTa" class="form-label fw-bold">Mô tả nguyên liệu / Hương vị</label>
                            <textarea asp-for="MonInfo.MoTa" class="form-control" rows="3" placeholder="Ví dụ: Nước cam ép nguyên chất..."></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-page="./QuanLyThucDon" class="btn btn-light border px-4 py-2 fw-bold text-muted shadow-sm">
                                <i class="bi bi-x-lg me-1"></i> Hủy thay đổi
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Lưu cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // JS 1: Cập nhật Xem trước hình ảnh nếu người dùng chọn ảnh mới
    document.getElementById('imageInput').addEventListener('change', function(event) {
        const [file] = event.target.files;
        const preview = document.getElementById('imagePreview');
        if (file) {
            preview.src = URL.createObjectURL(file);
        }
    });

    // JS 2: Format Giá Bán chuẩn VND
    function formatCurrency(input) {
        let rawValue = input.value.replace(/\D/g, '');
        if (rawValue === '') {
            document.getElementById('DonGiaActual').value = '';
            input.value = '';
            return;
        }
        let numberValue = parseInt(rawValue, 10);
        document.getElementById('DonGiaActual').value = numberValue;
        input.value = numberValue.toLocaleString('vi-VN') + ' VND';
    }
</script>
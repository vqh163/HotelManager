@page
@model HotelManager.Pages.QuanTriHeThong.QuanLyTaiKhoanModel
@{
    ViewData["Title"] = "Quản lý Danh sách Tài khoản";
}

<!-- Sử dụng thư viện icon FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Tùy chỉnh CSS cục bộ để ép kiểu theo chuẩn giao diện hệ thống -->
<style>
    body {
        background-color: #f8f9fa; /* Nền xám nhạt đồng bộ hệ thống */
    }

    .page-title {
        color: #0d6efd;
        font-weight: 700;
        font-size: 24px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-subtitle {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .btn-add-new {
        background-color: #0d6efd;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        padding: 8px 20px;
        transition: all 0.3s;
    }
    
    .btn-add-new:hover {
        background-color: #0b5ed7;
        color: white;
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
    }

    /* Thanh tìm kiếm */
    .search-card {
        background: white;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        padding: 15px;
        margin-bottom: 20px;
    }

    /* Bảng dữ liệu chuẩn */
    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .table th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        border-bottom: 2px solid #e9ecef;
        padding: 15px;
    }

    .table td {
        vertical-align: middle;
        padding: 15px;
        border-bottom: 1px solid #f1f3f5;
        font-weight: 500;
        color: #343a40;
    }

    /* Badge Trạng thái và Vai trò */
    .badge-role {
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 500;
        font-size: 12px;
    }

    .role-admin { background-color: #cff4fc; color: #055160; border: 1px solid #9eeaf9;}
    .role-manager { background-color: #e0cffc; color: #3b0560; border: 1px solid #c29ef9;}
    .role-customer { background-color: #d1e7dd; color: #0f5132; border: 1px solid #a3cfbb;}

    .status-active {
        color: #198754;
        background-color: #d1e7dd;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Nút Thao tác */
    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        color: #0d6efd;
        background: white;
        margin-right: 5px;
        transition: all 0.2s;
    }

    .action-btn:hover {
        background: #f8f9fa;
        border-color: #c6c7ce;
    }

    .btn-edit { color: #0d6efd; border-color: #b6d4fe; }
    .btn-lock { color: #ffc107; border-color: #ffecb5; }
    .btn-delete { color: #dc3545; border-color: #f5c2c7; }
</style>

<div class="container-fluid mt-4">
    <!-- Tiêu đề trang và Nút Thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-1">
        <div>
            <h1 class="page-title">
                <i class="fa-solid fa-user-shield"></i> QUẢN LÝ DANH SÁCH TÀI KHOẢN
            </h1>
            <p class="page-subtitle">Hệ thống quản lý thông tin và phân quyền tài khoản người dùng</p>
        </div>
        <a asp-page="./ThemTaiKhoan" class="btn btn-add-new text-decoration-none">
            <i class="fa-solid fa-plus me-1"></i> Thêm Tài khoản
        </a>
    </div>

    <!-- Thanh Tìm kiếm đồng bộ -->
    <div class="search-card">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Tìm theo mã tài khoản, tên đăng nhập...">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100 fw-bold">TÌM KIẾM</button>
            </div>
        </form>
    </div>

    <!-- Bảng Dữ liệu -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th width="20%">THÔNG TIN TÀI KHOẢN</th>
                        <th width="20%">TÊN ĐĂNG NHẬP</th>
                        <th width="15%" class="text-center">VAI TRÒ</th>
                        <th width="15%" class="text-center">TRẠNG THÁI</th>
                        <th width="15%" class="text-center">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- ĐÃ SỬA: Bắt đầu vòng lặp duyệt dữ liệu thực tế từ Code-behind -->
                    @if (Model.DanhSachTaiKhoan != null && Model.DanhSachTaiKhoan.Any())
                    {
                        @foreach (var tk in Model.DanhSachTaiKhoan)
                        {
                            var roleClass = tk.VaiTro == "Quản trị viên" ? "role-admin" :
                                            tk.VaiTro == "Quản lý" ? "role-manager" : 
                                            tk.VaiTro == "Khách hàng" ? "role-customer" : "bg-secondary text-white";

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">Mã: @tk.MaTaiKhoan</div>
                                </td>
                                <td>@tk.TenDangNhap</td>
                                <td class="text-center">
                                    <span class="badge-role @roleClass">@tk.VaiTro</span>
                                </td>
                                <td class="text-center">
                                    @if (tk.TrangThai == "Hoạt động")
                                    {
                                        <span class="status-active"><i class="fa-solid fa-circle-check me-1"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill"><i class="fa-solid fa-ban me-1"></i> Bị khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- Tag Helpers hiện đã nằm trong vòng lặp nên sẽ nhận diện được biến 'tk' -->
                                    <a asp-page="./SuaTaiKhoan" asp-route-id="@tk.MaTaiKhoan" class="action-btn btn-edit" title="Chỉnh sửa">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                            
                                    <a asp-page="./KhoaTaiKhoan" asp-route-id="@tk.MaTaiKhoan" class="action-btn btn-lock" title="Khóa/Mở khóa">
                                        <i class="fa-solid fa-lock"></i>
                                    </a>
                            
                                    <a asp-page="./XoaTaiKhoan" asp-route-id="@tk.MaTaiKhoan" class="action-btn btn-delete" title="Xóa">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Không tìm thấy dữ liệu tài khoản nào!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
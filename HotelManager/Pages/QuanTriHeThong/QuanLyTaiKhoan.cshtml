@page
@model HotelManager.Pages.QuanTriHeThong.QuanLyTaiKhoanModel
@{
    ViewData["Title"] = "Quản lý Tài khoản (UC_13)";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4"><i class="bi bi-shield-lock"></i> Quản trị Hệ thống - Danh sách Tài khoản</h2>

    <!-- Hiển thị thông báo lỗi nếu có -->
    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
    {
        <div class="alert alert-danger shadow-sm">
            @Model.ThongBaoLoi
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 text-secondary">Dữ liệu bảng TAI_KHOAN</h5>
            <!-- Tag Helper điều hướng sang trang thêm tài khoản -->
            <a asp-page="./ThemTaiKhoan" class="btn btn-success btn-sm">
                + Thêm Tài khoản
            </a>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã TK</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Vai Trò</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachTaiKhoan != null && Model.DanhSachTaiKhoan.Count > 0)
                    {
                        foreach (var tk in Model.DanhSachTaiKhoan)
                        {
                            <tr>
                                <td class="fw-bold">@tk.MaTaiKhoan</td>
                                <td>@tk.TenDangNhap</td>
                                <td>
                                    <span class="badge bg-info text-dark">@tk.VaiTro</span>
                                </td>
                                <td>
                                    @if (tk.TrangThai == "Hoạt động")
                                    {
                                        <span class="badge bg-success">@tk.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@tk.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- Truyền ID vào route để sang trang Sửa / Xóa -->
                                    <a asp-page="./SuaTaiKhoan" asp-route-id="@tk.MaTaiKhoan" class="btn btn-warning btn-sm">Sửa</a>
                                    <a asp-page="./XoaTaiKhoan" asp-route-id="@tk.MaTaiKhoan" class="btn btn-danger btn-sm">Khóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Chưa có dữ liệu tài khoản nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
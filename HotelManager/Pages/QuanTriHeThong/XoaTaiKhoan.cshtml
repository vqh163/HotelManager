@page "{id?}"
@model HotelManager.Pages.QuanTriHeThong.XoaTaiKhoanModel
@{
    ViewData["Title"] = "Xóa Tài khoản (UC_13)";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
            {
                <div class="alert alert-danger shadow-sm mb-4">
                    <i class="bi bi-exclamation-triangle-fill"></i> @Model.ThongBaoLoi
                </div>
            }

            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-trash3-fill"></i> CẢNH BÁO: XÓA TÀI KHOẢN VĨNH VIỄN</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <p class="text-danger fw-bold fs-5 mb-4">
                        Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống không? Hành động này không thể hoàn tác!
                    </p>

                    <div class="bg-white p-3 border rounded mb-4 shadow-sm">
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold text-secondary">Mã Tài khoản:</div>
                            <div class="col-sm-8 fw-bold">@Model.TaiKhoanXoa.MaTaiKhoan</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold text-secondary">Tên Đăng nhập:</div>
                            <div class="col-sm-8 text-primary fw-bold">@Model.TaiKhoanXoa.TenDangNhap</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold text-secondary">Vai trò:</div>
                            <div class="col-sm-8">
                                <span class="badge bg-dark">@Model.TaiKhoanXoa.VaiTro</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 fw-bold text-secondary">Liên kết mã NV/KH:</div>
                            <div class="col-sm-8 text-muted">
                                @(Model.TaiKhoanXoa.NHAN_VIENMaNV ?? Model.TaiKhoanXoa.KHACH_HANGMaKH ?? "Không có")
                            </div>
                        </div>
                    </div>

                    <form method="post">
                        <div class="d-flex justify-content-end gap-3">
                            <!-- Nút Hủy sử dụng thẻ <a> quay về trang chủ UC_13 -->
                            <a asp-page="./QuanLyTaiKhoan" class="btn btn-secondary px-4 fw-bold">
                                Hủy & Quay lại
                            </a>
                            <!-- Nút Submit thực hiện Post để xóa -->
                            <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle"></i> Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
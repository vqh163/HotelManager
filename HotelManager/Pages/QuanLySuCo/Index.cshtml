<!-- MODAL 4: XEM CHI TIẾT TOÀN BỘ THÔNG TIN PHIẾU SỰ CỐ (ALL ROLES)            -->
<!-- ========================================================================= -->
<div class="modal fade" id="detailTicketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white px-4 py-3">
                <h5 class="modal-title fw-bold mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i>Chi Tiết Phiếu Sự Cố - <span id="detMaPhieu" class="font-monospace"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="detailTicketBody"></div>
            <div class="modal-footer bg-light border-top px-4 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Canvas ẩn dùng chụp ảnh từ Camera -->
<canvas id="incidentCameraCanvas" style="display: none;"></canvas>

@section Scripts {
    <script>
        // Nạp dữ liệu JSON từ Server vào RAM trình duyệt để tránh lỗi ký tự đặc biệt trên onclick
        const ticketsList = @Html.Raw(Model.DanhSachSuCoJson);
        const warehouseItems = @Html.Raw(Model.DanhSachVatTuKhoJson);

        const ticketsMap = {};
        ticketsList.forEach(t => ticketsMap[t.MaPhieuBaoCao] = t);

        // =====================================================================
        // 1. LOGIC MODAL TẠO PHIẾU MỚI
        // =====================================================================
        function openCreateTicketModal() {
            toggleLocationInputs();
            onPriorityCreateChange();
            new bootstrap.Modal(document.getElementById('createTicketModal')).show();
        }

        function toggleLocationInputs() {
            const type = document.getElementById('selectLoaiViTriMoi').value;
            const boxPhong = document.getElementById('boxChonPhongMoi');
            const boxKhuVuc = document.getElementById('boxChonKhuVucChungMoi');
            const wrapKhoa = document.getElementById('wrapCheckKhoaPhong');

            if (type === 'Phong') {
                boxPhong.style.display = 'block';
                boxKhuVuc.style.display = 'none';
                wrapKhoa.style.display = 'block';
                document.getElementById('selectMaPhongMoi').required = true;
                document.getElementById('selectKhuVucChungMoi').required = false;
            } else {
                boxPhong.style.display = 'none';
                boxKhuVuc.style.display = 'block';
                wrapKhoa.style.display = 'none';
                document.getElementById('chkKhoaPhongDeSuaMoi').checked = false;
                document.getElementById('selectMaPhongMoi').required = false;
                document.getElementById('selectKhuVucChungMoi').required = true;
            }
        }

        function onPriorityCreateChange() {
            const priority = document.getElementById('selectMucDoUuTienMoi').value;
            const type = document.getElementById('selectLoaiViTriMoi').value;
            const chkKhoa = document.getElementById('chkKhoaPhongDeSuaMoi');
            if (type === 'Phong' && (priority === 'Khẩn cấp' || priority === 'Cao')) {
                chkKhoa.checked = true;
            }
        }

        // =====================================================================
        // 2. LOGIC MODAL KỸ THUẬT CẬP NHẬT SỬA CHỮA & XUẤT NHIỀU VẬT TƯ
        // =====================================================================
        function openTechUpdateModal(maPhieu) {
            const t = ticketsMap[maPhieu];
            if (!t) return;

            document.getElementById('techMaPhieuLbl').innerText = t.MaPhieuBaoCao;
            document.getElementById('techViTriLbl').innerText = `Vị trí: ${t.ViTriSuCo} | Ưu tiên: ${t.MucDoUuTien}`;
            document.getElementById('techInputMaPhieu').value = t.MaPhieuBaoCao;
            document.getElementById('techMoTaBanDau').innerText = t.MoTaSuCo;
            document.getElementById('techInputGhiChuXuLy').value = t.GhiChuXuLy || '';
            document.getElementById('techInputChiPhiPhatSinh').value = t.ChiPhiPhatSinh || 0;
            document.getElementById('techChkDoKhach').checked = !!t.DoKhachLamHong;
            document.getElementById('techChkCongHoaDon').checked = false;
            toggleChargeGuestCheckbox();

            // Hiển thị lý do từ chối nếu Quản lý vừa trả lại
            const rejBox = document.getElementById('techRejectWarningBox');
            if (t.LyDoTuChoi) {
                rejBox.style.display = 'block';
                document.getElementById('techRejectReasonText').innerText = t.LyDoTuChoi;
            } else {
                rejBox.style.display = 'none';
            }

            // Hiển thị ảnh sau sửa đã lưu trước đó (nếu có)
            const prevAfter = document.getElementById('prevTechAfter');
            document.getElementById('fileTechAfter').value = '';
            if (t.AnhSauSua) {
                prevAfter.src = t.AnhSauSua;
                prevAfter.style.display = 'inline-block';
            } else {
                prevAfter.style.display = 'none';
            }

            // Hiển thị bảng vật tư đã xuất trước đó
            const usedBox = document.getElementById('techUsedMaterialsBox');
            const usedBody = document.getElementById('techUsedMaterialsBody');
            usedBody.innerHTML = '';
            if (t.DanhSachVatTu && t.DanhSachVatTu.length > 0) {
                usedBox.style.display = 'block';
                t.DanhSachVatTu.forEach(vt => {
                    usedBody.innerHTML += `
                        <tr>
                            <td class="fw-semibold">${vt.TenVatTu}</td>
                            <td class="text-center fw-bold">${vt.SoLuong}</td>
                            <td class="text-center">${vt.DonViTinh}</td>
                            <td class="text-end">${Number(vt.DonGia).toLocaleString('vi-VN')} đ</td>
                            <td class="text-end fw-bold text-danger">${Number(vt.ThanhTien).toLocaleString('vi-VN')} đ</td>
                            <td class="text-muted">${vt.ThoiGianXuat}</td>
                        </tr>`;
                });
            } else {
                usedBox.style.display = 'none';
            }

            // Reset khung chọn vật tư mới
            document.getElementById('materialRowsContainer').innerHTML = `
                <div class="text-muted small text-center py-2" id="emptyMaterialHint">
                    Nhấn nút <strong>"+ Thêm vật tư"</strong> nếu quá trình sửa chữa cần xuất vật tư từ kho.
                </div>`;

            new bootstrap.Modal(document.getElementById('techUpdateModal')).show();
        }

        function toggleChargeGuestCheckbox() {
            const isChecked = document.getElementById('techChkDoKhach').checked;
            document.getElementById('techWrapChargeGuest').style.display = isChecked ? 'block' : 'none';
            if (!isChecked) document.getElementById('techChkCongHoaDon').checked = false;
        }

        function addMaterialRow() {
            const container = document.getElementById('materialRowsContainer');
            const hint = document.getElementById('emptyMaterialHint');
            if (hint) hint.remove();

            let optionsHtml = '<option value="" data-unit="--" data-stock="0" data-price="0">-- Chọn vật tư trong kho --</option>';
            warehouseItems.forEach(v => {
                const disabledAttr = v.SoLuongTon <= 0 ? 'disabled' : '';
                optionsHtml += `<option value="${v.MaVatTu}" data-unit="${v.DonViTinh}" data-stock="${v.SoLuongTon}" data-price="${v.DonGiaNhap}" ${disabledAttr}>
                    ${v.TenVatTu} (Tồn: ${v.SoLuongTon} ${v.DonViTinh} | ${Number(v.DonGiaNhap).toLocaleString('vi-VN')} đ)
                </option>`;
            });

            const row = document.createElement('div');
            row.className = 'material-row row g-2 align-items-center mb-2 pb-2 border-bottom';
            row.innerHTML = `
                <div class="col-md-6">
                    <select class="form-select form-select-sm mat-select" required onchange="onMaterialSelected(this)">
                        ${optionsHtml}
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control mat-qty fw-bold" value="1" min="1" required oninput="updateMaterialRowSubtotal(this)" />
                        <span class="input-group-text bg-light fw-bold mat-unit">--</span>
                    </div>
                </div>
                <div class="col-md-2 text-end">
                    <span class="small fw-bold text-danger mat-subtotal">0 đ</span>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeMaterialRow(this)" title="Xóa dòng">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;

            container.appendChild(row);
            reindexMaterialRows();
        }

        function onMaterialSelected(selectEl) {
            const row = selectEl.closest('.material-row');
            const opt = selectEl.options[selectEl.selectedIndex];
            const unit = opt.getAttribute('data-unit') || '--';
            const stock = parseInt(opt.getAttribute('data-stock') || '0');
            const qtyInput = row.querySelector('.mat-qty');

            row.querySelector('.mat-unit').innerText = unit;
            qtyInput.max = stock > 0 ? stock : 1;
            if (parseInt(qtyInput.value) > stock && stock > 0) {
                qtyInput.value = stock;
            }
            updateMaterialRowSubtotal(qtyInput);
        }

        function updateMaterialRowSubtotal(qtyInput) {
            const row = qtyInput.closest('.material-row');
            const selectEl = row.querySelector('.mat-select');
            const opt = selectEl.options[selectEl.selectedIndex];
            const price = parseFloat(opt.getAttribute('data-price') || '0');
            const qty = parseInt(qtyInput.value || '0');
            row.querySelector('.mat-subtotal').innerText = (price * qty).toLocaleString('vi-VN') + ' đ';
        }

        function removeMaterialRow(btn) {
            btn.closest('.material-row').remove();
            reindexMaterialRows();
        }

        function reindexMaterialRows() {
            const rows = document.querySelectorAll('#materialRowsContainer .material-row');
            rows.forEach((row, idx) => {
                row.querySelector('.mat-select').name = `VatTuXuatThem[${idx}].MaVatTu`;
                row.querySelector('.mat-qty').name = `VatTuXuatThem[${idx}].SoLuong`;
            });
        }

        // =====================================================================
        // 3. LOGIC MODAL QUẢN LÝ NGHIỆM THU (ĐẠT / TRẢ LẠI)
        // =====================================================================
        function openApprovalModal(maPhieu) {
            const t = ticketsMap[maPhieu];
            if (!t) return;

            document.getElementById('appMaPhieuLbl').innerText = t.MaPhieuBaoCao;
            document.getElementById('appInputMaPhieu').value = t.MaPhieuBaoCao;
            document.getElementById('appViTri').innerText = t.ViTriSuCo;
            document.getElementById('appNguoiXuLy').innerText = t.NguoiXuLy;
            document.getElementById('appMoTa').innerText = t.MoTaSuCo;
            document.getElementById('appGhiChuXuLy').innerText = t.GhiChuXuLy || 'Không có ghi chú thêm';
            document.getElementById('appTongChiPhi').innerText = Number(t.TongChiPhi).toLocaleString('vi-VN') + ' đ';
            document.getElementById('appInputLyDoTuChoi').value = '';

            document.getElementById('appAnhTruocBox').innerHTML = t.AnhTruocSua
                ? `<a href="${t.AnhTruocSua}" target="_blank"><img src="${t.AnhTruocSua}" class="img-fluid rounded" style="max-height: 180px;"></a>`
                : '<span class="text-muted small">Không có ảnh đính kèm</span>';

            document.getElementById('appAnhSauBox').innerHTML = t.AnhSauSua
                ? `<a href="${t.AnhSauSua}" target="_blank"><img src="${t.AnhSauSua}" class="img-fluid rounded" style="max-height: 180px;"></a>`
                : '<span class="text-muted small">Chưa có ảnh sau sửa</span>';

            const matBox = document.getElementById('appMaterialsSummary');
            if (t.DanhSachVatTu && t.DanhSachVatTu.length > 0) {
                let html = '<ul class="list-group list-group-flush border rounded">';
                t.DanhSachVatTu.forEach(v => {
                    html += `<li class="list-group-item d-flex justify-content-between py-1">
                        <span>${v.TenVatTu} (<strong>${v.SoLuong} ${v.DonViTinh}</strong>)</span>
                        <span class="text-danger fw-bold">${Number(v.ThanhTien).toLocaleString('vi-VN')} đ</span>
                    </li>`;
                });
                html += '</ul>';
                matBox.innerHTML = html;
            } else {
                matBox.innerHTML = '<span class="text-muted">Không tiêu hao vật tư kho.</span>';
            }

            document.getElementById('appUnlockNotice').style.display = (!t.LaKhuVucChung && t.CoKhoaPhong) ? 'block' : 'none';

            new bootstrap.Modal(document.getElementById('approvalModal')).show();
        }

        function submitRejection() {
            const reason = document.getElementById('appInputLyDoTuChoi').value.trim();
            if (!reason) {
                alert('Vui lòng nhập rõ lý do không đạt trước khi trả lại phiếu cho Kỹ thuật!');
                document.getElementById('appInputLyDoTuChoi').focus();
                return false;
            }
            document.getElementById('appInputKetQua').value = 'KhongDat';
            return confirm('Xác nhận trả lại phiếu này về trạng thái Đang sửa chữa?');
        }

        // =====================================================================
        // 4. LOGIC MODAL XEM CHI TIẾT PHIẾU (TẤT CẢ VAI TRÒ)
        // =====================================================================
        function openDetailModal(maPhieu) {
            const t = ticketsMap[maPhieu];
            if (!t) return;

            document.getElementById('detMaPhieu').innerText = t.MaPhieuBaoCao;

            let vatTuHtml = '<p class="text-muted small mb-0">Không sử dụng vật tư kho.</p>';
            if (t.DanhSachVatTu && t.DanhSachVatTu.length > 0) {
                vatTuHtml = `<table class="table table-sm table-bordered small mb-0">
                    <thead class="table-light"><tr><th>Vật tư</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th><th>Thời gian</th></tr></thead><tbody>`;
                t.DanhSachVatTu.forEach(v => {
                    vatTuHtml += `<tr><td>${v.TenVatTu}</td><td class="text-center">${v.SoLuong} ${v.DonViTinh}</td><td class="text-end fw-bold">${Number(v.ThanhTien).toLocaleString('vi-VN')} đ</td><td>${v.ThoiGianXuat}</td></tr>`;
                });
                vatTuHtml += '</tbody></table>';
            }

            document.getElementById('detailTicketBody').innerHTML = `
                <div class="row g-3 small mb-3">
                    <div class="col-md-6"><strong>Vị trí:</strong> <span class="text-primary fw-bold">${t.ViTriSuCo}</span></div>
                    <div class="col-md-6"><strong>Trạng thái:</strong> <span class="badge bg-dark">${t.TrangThai}</span> | Ưu tiên: <strong>${t.MucDoUuTien}</strong></div>
                    <div class="col-md-6"><strong>Người tạo:</strong> ${t.NguoiTao} (${t.ThoiGianTaoStr})</div>
                    <div class="col-md-6"><strong>Kỹ thuật xử lý:</strong> ${t.NguoiXuLy} ${t.ThoiGianTiepNhanStr ? '(' + t.ThoiGianTiepNhanStr + ')' : ''}</div>
                    <div class="col-md-6"><strong>Hoàn thành / Báo xanh:</strong> ${t.ThoiGianHoanThanhStr || 'Chưa hoàn thành'}</div>
                    <div class="col-md-6"><strong>Tổng chi phí:</strong> <span class="text-danger fw-bold">${Number(t.TongChiPhi).toLocaleString('vi-VN')} đ</span> (Vật tư: ${Number(t.TienVatTu).toLocaleString('vi-VN')}đ + Phát sinh: ${Number(t.ChiPhiPhatSinh).toLocaleString('vi-VN')}đ)</div>
                </div>
                <div class="p-3 bg-light rounded border small mb-3">
                    <div class="mb-2"><strong>Mô tả sự cố:</strong> ${t.MoTaSuCo}</div>
                    <div class="mb-2"><strong>Ghi chú xử lý kỹ thuật:</strong> ${t.GhiChuXuLy || 'Chưa có'}</div>
                    ${t.LyDoTuChoi ? `<div class="text-danger"><strong>Lịch sử trả lại nghiệm thu:</strong> ${t.LyDoTuChoi}</div>` : ''}
                </div>
                <div class="mb-3">
                    <h6 class="fw-bold small text-secondary mb-2">Vật tư đã xuất kho:</h6>
                    ${vatTuHtml}
                </div>
                <div class="row g-3 text-center">
                    <div class="col-md-6">
                        <div class="border rounded p-2">
                            <div class="small fw-bold text-danger mb-1">Ảnh hiện trường (Trước sửa)</div>
                            ${t.AnhTruocSua ? `<a href="${t.AnhTruocSua}" target="_blank"><img src="${t.AnhTruocSua}" class="img-fluid rounded" style="max-height:180px;"></a>` : '<span class="text-muted small">Không có</span>'}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-2">
                            <div class="small fw-bold text-success mb-1">Ảnh kết quả (Sau sửa)</div>
                            ${t.AnhSauSua ? `<a href="${t.AnhSauSua}" target="_blank"><img src="${t.AnhSauSua}" class="img-fluid rounded" style="max-height:180px;"></a>` : '<span class="text-muted small">Chưa có</span>'}
                        </div>
                    </div>
                </div>`;

            new bootstrap.Modal(document.getElementById('detailTicketModal')).show();
        }

        // =====================================================================
        // 5. CAMERA TRỰC TIẾP & XEM TRƯỚC HÌNH ẢNH (WEBRTC)
        // =====================================================================
        let incidentStream = null;
        let currentCamInputId = null;
        let currentCamPreviewId = null;
        let currentCamBoxId = null;

        function previewIncidentImg(inputEl, previewId) {
            const img = document.getElementById(previewId);
            if (inputEl.files && inputEl.files[0] && img) {
                img.src = URL.createObjectURL(inputEl.files[0]);
                img.style.display = 'inline-block';
            }
        }

        async function openIncidentCamera(fileInputId, previewImgId, camBoxId) {
            stopIncidentCamera();
            currentCamInputId = fileInputId;
            currentCamPreviewId = previewImgId;
            currentCamBoxId = camBoxId;

            const box = document.getElementById(camBoxId);
            const video = box.querySelector('.incident-video');

            try {
                incidentStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" }, audio: false });
                video.srcObject = incidentStream;
                box.style.display = 'block';
                box.scrollIntoView({ behavior: 'smooth' });
            } catch (err) {
                alert("Không thể mở Camera trực tiếp. Vui lòng chọn ảnh từ thiết bị!");
            }
        }

        function captureIncidentPhoto() {
            if (!incidentStream || !currentCamBoxId) return;
            const box = document.getElementById(currentCamBoxId);
            const video = box.querySelector('.incident-video');
            const canvas = document.getElementById('incidentCameraCanvas');

            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob(function (blob) {
                if (!blob) return;
                const file = new File([blob], "suco_" + Date.now() + ".jpg", { type: "image/jpeg" });
                const dt = new DataTransfer();
                dt.items.add(file);

                const fileInput = document.getElementById(currentCamInputId);
                if (fileInput) {
                    fileInput.files = dt.files;
                    previewIncidentImg(fileInput, currentCamPreviewId);
                }
                stopIncidentCamera();
            }, "image/jpeg", 0.9);
        }

        function stopIncidentCamera() {
            if (incidentStream) {
                incidentStream.getTracks().forEach(t => t.stop());
                incidentStream = null;
            }
            if (currentCamBoxId) {
                const box = document.getElementById(currentCamBoxId);
                if (box) box.style.display = 'none';
            }
        }
    </script>
}